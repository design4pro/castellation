{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "castellation-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "castellation-cms",
      "database_id": "replace-with-cms-database-id"
    },
    {
      "binding": "CATALOG_DB",
      "database_name": "castellation",
      "database_id": "replace-with-d1-database-id"
    }
  ],
  "services": [{"binding":"READER_INVITATIONS","service":"castellation-api","entrypoint":"ReaderInvitations"}],
  "r2_buckets": [
    {
      "binding": "CMS_MEDIA",
      "bucket_name": "castellation-cms-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
