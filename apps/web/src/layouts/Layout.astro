---
import '../styles/global.css';
import '../styles/reading-atlas.css';
import '../styles/bookshop.css';
import '../styles/relationship-atlas.css';
const canonical = new URL(Astro.url.pathname, Astro.url.origin);
if (Astro.props.lang === 'pl') canonical.searchParams.set('lang', 'pl');
const { variant = 'default', title = 'Castellation - Stories, connected', lang = 'en', noindex = false, description = 'Explore literary characters and their connections, one chapter at a time.' } = Astro.props;
const translatedPages = new Set(['/', '/how-it-works', '/help', '/our-method', '/guides', '/reading-paths', '/guides/choose-your-next-classic', '/guides/track-characters', '/guides/lewis-carroll-and-alice', '/guides/alice-down-the-rabbit-hole', '/guides/book-club-questions', '/guides/two-unexpected-beginnings']);
const localized = !noindex && translatedPages.has(Astro.url.pathname.replace(/\/$/, '') || '/');
const englishUrl = new URL(Astro.url.pathname, Astro.url.origin);
const polishUrl = new URL(Astro.url.pathname, Astro.url.origin);
polishUrl.searchParams.set('lang', 'pl');

---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta name="referrer" content="no-referrer" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {localized && <><link rel="alternate" hreflang="en" href={englishUrl.href} /><link rel="alternate" hreflang="pl" href={polishUrl.href} /><link rel="alternate" hreflang="x-default" href={englishUrl.href} /></>}
    <title>{title}</title>{!noindex && <><link rel="canonical" href={canonical.href} /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical.href} /><meta property="og:site_name" content="Castellation" /></>}{noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body id="page" class:list={{ 'relationship-atlas': variant === 'relationship-atlas' }}><slot /></body>
</html>
