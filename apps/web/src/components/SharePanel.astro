---
const { lang = 'en', url, throughChapter = false } = Astro.props;
const pl = lang === 'pl';
---
<details class="share-panel" data-lang={lang}><summary><span>✳ {pl ? 'UDOSTĘPNIJ HISTORIĘ' : 'SHARE THE STORY'}</span><strong>{pl ? 'Przekaż dalej' : 'Share this page'} ↗</strong></summary><div class="share-panel-body"><p>{throughChapter ? (pl ? 'Ten link zawiera wybrany rozdział i nazwę postaci. Osoba otwierająca zobaczy informacje do tego miejsca.' : 'This link includes the selected chapter and character name. The recipient will see information up to that point.') : (pl ? 'Ten link prowadzi do publicznej strony książki bez Twojego postępu.' : 'This link opens the public book page without your reading progress.')}</p><label for="share-url">{pl ? 'Adres strony' : 'Page address'}</label><div class="share-controls"><input id="share-url" type="text" readonly value={url} /><button type="button" hidden>{pl ? 'Kopiuj link' : 'Copy link'}</button></div><p class="share-feedback" role="status"></p></div></details>
<script>
  document.querySelectorAll<HTMLElement>('.share-panel').forEach((panel) => {
    const button = panel.querySelector<HTMLButtonElement>('button')!;
    const input = panel.querySelector<HTMLInputElement>('input')!;
    const feedback = panel.querySelector<HTMLElement>('.share-feedback')!;
    const pl = panel.dataset.lang === 'pl';
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(input.value);
        feedback.textContent = pl ? 'Link skopiowany.' : 'Link copied.';
      } catch {
        input.focus(); input.select();
        feedback.textContent = pl ? 'Skopiuj zaznaczony adres ręcznie.' : 'Copy the selected address manually.';
      }
    });
  });
</script>
