---
const { lang = 'en', url, throughChapter = false } = Astro.props;
const pl = lang === 'pl';
---
<section class="share-panel" data-lang={lang} aria-labelledby="share-title"><div class="share-intro"><p class="share-kicker">✳ {pl ? 'UDOSTĘPNIJ HISTORIĘ' : 'SHARE THE STORY'}</p><h2 id="share-title">{pl ? 'Dobra historia jest jeszcze lepsza we dwoje.' : 'A good story is better together.'}</h2><p>{throughChapter ? (pl ? 'Link zawiera wybrany rozdział i nazwę postaci. Osoba otwierająca zobaczy informacje do tego miejsca.' : 'The link includes the selected chapter and character name. The recipient will see information up to that point.') : (pl ? 'Link prowadzi do publicznej strony książki bez Twojego postępu.' : 'The link opens the public book page without your reading progress.')}</p></div><div class="share-panel-body"><label for="share-url">{pl ? 'ADRES DO UDOSTĘPNIENIA' : 'LINK TO SHARE'}</label><div class="share-controls"><input id="share-url" type="text" readonly value={url} /><button type="button" hidden>{pl ? 'Kopiuj link' : 'Copy link'} ↗</button></div><p class="share-feedback" role="status"></p><span class="share-decoration" aria-hidden="true">✳ ─── ✦</span></div></section>
<script>
  document.querySelectorAll<HTMLElement>('.share-panel').forEach((panel) => {
    const button = panel.querySelector<HTMLButtonElement>('button')!;
    const input = panel.querySelector<HTMLInputElement>('input')!;
    const feedback = panel.querySelector<HTMLElement>('.share-feedback')!;
    const pl = panel.dataset.lang === 'pl';
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(input.value);
        feedback.textContent = pl ? 'Link skopiowany.' : 'Link copied.';
      } catch {
        input.focus(); input.select();
        feedback.textContent = pl ? 'Skopiuj zaznaczony adres ręcznie.' : 'Copy the selected address manually.';
      }
    });
  });
</script>

<style>
.share-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:clamp(25px,5vw,60px);align-items:center;margin:55px 0 60px;padding:clamp(28px,4vw,48px);border:0;background:#30463a;color:#f7f5ef}.share-kicker{font-size:10px;font-weight:700;letter-spacing:.14em;color:#f0c5a9;margin:0}.share-intro h2{max-width:550px;font:500 clamp(30px,3.5vw,46px)/1.12 'Playfair Display',serif;letter-spacing:-.025em;margin:20px 0}.share-intro>p:last-child{max-width:520px;line-height:1.7;color:#e0e9df;font-size:14px}.share-panel-body{background:transparent;padding:0;margin:0}.share-panel label{color:#f0c5a9;letter-spacing:.1em;font-size:10px;margin-bottom:12px}.share-controls input{min-height:50px;background:#f7f5ef;border:1px solid #f7f5ef}.share-controls button{background:#e8c2a8;color:#24372e;min-height:50px}.share-controls button:hover{background:#ffe3ce}.share-controls button:focus-visible{outline:3px solid #f0c5a9;outline-offset:4px}.share-feedback{color:#f7f5ef}.share-decoration{display:block;margin-top:22px;color:#e8c2a8;font-size:23px;letter-spacing:.2em}@media(max-width:760px){.share-panel{grid-template-columns:1fr;gap:20px;margin:40px 0;padding:28px}.share-intro h2{font-size:32px}.share-controls{flex-direction:column}.share-controls button{min-height:48px}}
</style>
