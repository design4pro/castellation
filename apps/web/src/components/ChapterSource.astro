---
const { slug, volume, chapter, lang } = Astro.props;
const pl = lang === 'pl';
const source = volume === 1 && slug === 'alices-adventures-in-wonderland' && (chapter === 1 || chapter === 2)
  ? { title: "Alice's Adventures in Wonderland", author: 'Lewis Carroll', url: 'https://www.gutenberg.org/cache/epub/28885/pg28885-images.html' }
  : volume === 1 && slug === 'a-christmas-carol' && chapter === 1
    ? { title: 'A Christmas Carol', author: 'Charles Dickens', url: 'https://www.gutenberg.org/files/46/46-h/46-h.htm' }
    : null;
---
{source && <aside class="chapter-source" aria-labelledby="chapter-source-title"><div class="source-mark" aria-hidden="true">✳</div><div><p class="source-kicker">✦ {pl ? 'WRÓĆ DO TEKSTU' : 'RETURN TO THE TEXT'}</p><h2 id="chapter-source-title">{pl ? 'Sprawdź źródło.' : 'Explore the source.'}</h2><p>{pl ? 'Punktem odniesienia dla tej części jest' : 'The reference for this part is'} <cite>{source.title}</cite> - {source.author}, Project Gutenberg.</p><p class="source-note">{pl ? 'Link prowadzi do całej książki i może ujawnić dalsze wydarzenia.' : 'The link opens the whole book and may reveal later events.'}</p><div class="source-links"><a href={source.url}>{pl ? 'Otwórz tekst w Project Gutenberg' : 'Open the text at Project Gutenberg'} ↗</a><a href={`/our-method?lang=${lang}`}>{pl ? 'Jak powstają mapy' : 'How maps are made'} ↗</a></div></div></aside>}
<style>
.chapter-source{display:grid;grid-template-columns:80px 1fr;gap:25px;background:#e9e5d9;padding:35px;margin-top:65px}.source-mark{color:#a35e3e;font-size:48px}.source-kicker{font-size:10px;letter-spacing:.14em;font-weight:700;color:#985438}.chapter-source h2{font:500 clamp(30px,3vw,40px) 'Playfair Display',serif;margin:12px 0}.chapter-source p:not(.source-kicker){color:#405448;line-height:1.7;max-width:650px}.chapter-source .source-note{font-size:13px}.source-links{display:flex;flex-wrap:wrap;gap:20px;margin-top:22px}.source-links a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}@media(max-width:760px){.chapter-source{grid-template-columns:1fr;gap:5px;padding:25px;margin-top:45px}.source-mark{font-size:32px}}
</style>
