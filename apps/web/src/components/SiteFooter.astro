---
const { lang = 'en', variant = 'default' } = Astro.props;
const pl = lang === 'pl';
---
<footer class:list={['site-footer', { 'atlas-shell': variant === 'relationship-atlas' }]}><div class="wrap site-footer-inner"><div class="site-footer-intro"><a class="brand" href={`/?lang=${lang}`} aria-label={pl ? 'Castellation - strona główna' : 'Castellation home'}>✳ castellation<span class="brand-dot">.</span></a><p>{pl ? 'Historie są lepsze, gdy widzisz ich powiązania.' : 'Stories are better when you see the connections.'}</p></div><nav aria-label={pl ? 'Nawigacja w stopce' : 'Footer navigation'}><div><p>{pl ? 'ODKRYWAJ' : 'EXPLORE'}</p><a href={`/library?lang=${lang}`}>{pl ? 'Biblioteka' : 'Library'} ↗</a><a href={`/characters?lang=${lang}`}>{pl ? 'Bohaterowie' : 'Characters'} ↗</a><a href={`/guides?lang=${lang}`}>{pl ? 'Przewodniki' : 'Guides'} ↗</a></div><div><p>{pl ? 'DOWIEDZ SIĘ WIĘCEJ' : 'LEARN MORE'}</p><a href={`/how-it-works?lang=${lang}`}>{pl ? 'Jak to działa' : 'How it works'} ↗</a><a href={`/our-method?lang=${lang}`}>{pl ? 'Nasze podejście' : 'Our approach'} ↗</a><a href={`/help?lang=${lang}`}>{pl ? 'Pomoc' : 'Help'} ↗</a></div></nav><div class="site-footer-bottom"><span>© {new Date().getFullYear()} CASTELLATION</span><span>✦ {pl ? 'CZYTAJ WE WŁASNYM TEMPIE' : 'READ AT YOUR OWN PACE'}</span></div></div></footer>
<style>
.site-footer{background:#263e33;color:#f6f4ed}.site-footer-inner{display:grid;grid-template-columns:1.2fr 1fr;gap:50px;padding-block:55px 25px}.site-footer-intro .brand{color:#f6f4ed}.site-footer-intro p{max-width:300px;font:400 23px/1.35 'Playfair Display',serif;color:#e1e9df}.site-footer nav{display:grid;grid-template-columns:1fr 1fr;gap:30px}.site-footer nav div{display:flex;flex-direction:column;align-items:start;gap:14px}.site-footer nav p{font-size:10px;letter-spacing:.14em;font-weight:700;color:#f0c3a5;margin:0 0 8px}.site-footer nav a{font-size:14px;font-weight:600}.site-footer nav a:hover{text-decoration:underline;text-underline-offset:4px}.site-footer a:focus-visible{outline:3px solid #f0c3a5;outline-offset:4px}.site-footer-bottom{grid-column:1/-1;display:flex;justify-content:space-between;gap:20px;border-top:1px solid #789181;padding-top:22px;font-size:10px;letter-spacing:.12em;color:#e1e9df}@media(max-width:760px){.site-footer-inner{grid-template-columns:1fr;gap:32px;padding-block:40px 25px}.site-footer nav{gap:20px}.site-footer-bottom{grid-column:auto;flex-wrap:wrap}}@media print{.site-footer{display:none}}
</style>
