---
const { lang, current } = Astro.props;
const pl = lang === 'pl';
const articles = [
  { id: 'track-characters', label: pl ? 'PRAKTYKA CZYTANIA' : 'THE READING PRACTICE', title: pl ? 'Jak zapamiętać bohaterów bez spoilerów' : 'How to keep track of characters without spoilers', description: pl ? 'Proste sposoby na śledzenie postaci i ich relacji.' : 'Simple ways to follow characters and their connections.' },
  { id: 'alice-down-the-rabbit-hole', label: pl ? 'CZYTAJ BLIŻEJ' : 'A CLOSER READING', title: pl ? 'W głąb króliczej nory' : 'Down the rabbit-hole', description: pl ? 'Trzy szczegóły z pierwszego rozdziału Alicji.' : 'Three details from Alice’s first chapter.' },
  { id: 'lewis-carroll-and-alice', label: pl ? 'ZA HISTORIĄ' : 'BEHIND THE STORY', title: pl ? 'Lewis Carroll i początki Alicji' : 'Lewis Carroll and the origins of Alice', description: pl ? 'Od opowieści na rzece do książki.' : 'From a story on the river to a book.' },
];
const order = current === 'track-characters' ? ['alice-down-the-rabbit-hole', 'lewis-carroll-and-alice'] : current === 'alice-down-the-rabbit-hole' ? ['lewis-carroll-and-alice', 'track-characters'] : ['alice-down-the-rabbit-hole', 'track-characters'];
const related = order.map((id) => articles.find((article) => article.id === id));
---
<section class="wrap related-reading" aria-labelledby="related-reading-heading"><div class="related-header"><div><p class="eyebrow">✦ {pl ? 'PODĄŻAJ ZA WĄTKIEM' : 'FOLLOW THE THREAD'}</p><h2 id="related-reading-heading">{pl ? 'Czytaj dalej.' : 'Keep reading.'}</h2></div><a href={`/guides?lang=${lang}`}>{pl ? 'Wszystkie przewodniki' : 'All reading guides'} ↗</a></div><div class="related-grid">{related.map((article, index) => <a class="related-card" href={`/guides/${article.id}?lang=${lang}`}><span class="related-number" aria-hidden="true">0{index + 1}</span><div><p>{article.label}</p><h3>{article.title}</h3><span>{article.description}</span></div><span class="related-arrow" aria-hidden="true">↗</span></a>)}</div></section>
<style>
.related-reading{padding-block:15px 100px}.related-header{display:flex;justify-content:space-between;align-items:end;gap:20px;border-bottom:1px solid #b8c3b7;padding-bottom:22px}.related-header h2{font:500 clamp(34px,3.5vw,48px) 'Playfair Display',serif;margin:12px 0 0}.related-header>a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.related-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}.related-card{background:#e6ebe0;display:grid;grid-template-columns:55px 1fr auto;gap:15px;min-height:210px;padding:28px;align-items:start}.related-card:nth-child(2){background:#eae2d6}.related-number{font:400 38px 'Playfair Display',serif;color:#a35e3e}.related-card p{font-size:10px;letter-spacing:.13em;font-weight:700;color:#855039;margin:6px 0 18px}.related-card h3{font:500 clamp(24px,2.4vw,32px)/1.2 'Playfair Display',serif;margin:0 0 12px}.related-card div>span{font-size:13px;line-height:1.6;color:#405448}.related-arrow{font-size:20px;color:#855039}.related-card:hover h3{text-decoration:underline;text-underline-offset:5px}@media(max-width:760px){.related-reading{padding-block:5px 65px}.related-header{display:block}.related-header>a{display:inline-block;margin-top:20px}.related-grid{grid-template-columns:1fr;gap:12px}.related-card{min-height:0;grid-template-columns:38px 1fr auto;padding:22px;gap:12px}.related-number{font-size:29px}}
</style>
