---
import LanguageSwitcher from './LanguageSwitcher.astro';
const { lang = 'en' } = Astro.props;
const pl = lang === 'pl';
const links = [
  { href: `/library?lang=${lang}`, text: pl ? 'Biblioteka' : 'Library', active: Astro.url.pathname === '/library' },
  { href: `/guides?lang=${lang}`, text: pl ? 'Przewodniki' : 'Guides', active: Astro.url.pathname.startsWith('/guides') },
  { href: `/how-it-works?lang=${lang}`, text: pl ? 'Jak to działa' : 'How it works', active: Astro.url.pathname === '/how-it-works' },
  { href: `/account?lang=${lang}`, text: pl ? 'Konto' : 'Account', active: Astro.url.pathname === '/account' },
];
---
<header class="site-header wrap"><a class="brand" href={`/?lang=${lang}`} aria-label={pl ? 'Castellation - strona główna' : 'Castellation home'}><span class="brand-mark">✳</span> castellation<span class="brand-dot">.</span></a><nav class="site-nav-desktop" aria-label={pl ? 'Nawigacja główna' : 'Main navigation'}>{links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.text}</a>)}<LanguageSwitcher lang={lang} /></nav><details class="site-nav-mobile"><summary>{pl ? 'Menu' : 'Menu'} <span aria-hidden="true">☰</span></summary><nav aria-label={pl ? 'Nawigacja główna' : 'Main navigation'}>{links.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.text}<span aria-hidden="true">↗</span></a>)}<LanguageSwitcher lang={lang} /></nav></details><nav class="site-nav-quick" aria-label={pl ? 'Główne sekcje' : 'Primary sections'}>{links.slice(0, 3).map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.text}</a>)}</nav></header>

<style>
.site-nav-quick{display:none!important}@media(max-width:760px){.site-header{height:auto;min-height:120px;display:grid;grid-template-columns:1fr auto;grid-template-rows:76px 44px;align-items:center}.site-header .site-nav-quick{display:flex!important;grid-column:1/-1;align-self:stretch;justify-content:space-between;gap:8px;border-top:1px solid #d9ddd3}.site-header .site-nav-quick a{display:flex;align-items:center;justify-content:center;min-height:44px;padding:0 8px;font-size:12px;font-weight:700}.site-header .site-nav-quick a[aria-current="page"]{color:#87452c;text-decoration:underline;text-underline-offset:6px}.site-header .site-nav-mobile nav{top:76px}.site-nav-mobile summary{justify-content:flex-end}}@media(max-width:340px){.site-header .site-nav-quick a{font-size:11px;padding:0 4px}}
.site-header .site-nav-mobile .locale-switch{align-self:flex-start;margin-top:14px}.site-header .site-nav-mobile .locale-switch a{display:grid;place-items:center;min-height:38px;border:0;font-size:11px}</style>
