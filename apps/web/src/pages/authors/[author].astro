---
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const author = Astro.params.author || '';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
type Book = { slug: string; title: string; author: string };
let books: Book[] = [];
let status = 200;
try {
  const api = import.meta.env.PUBLIC_API_URL;
  const response = api ? await fetch(`${api}/api/books`) : await env.API.fetch(new Request(`${Astro.url.origin}/api/books`));
  if (!response.ok) status = 503;
  else { const data = await response.json(); books = data.books.filter((book: Book) => book.author === author); if (!books.length) status = 404; }
} catch { status = 503; }
Astro.response.status = status;
const title = status === 200 ? `${author} - ${pl ? 'książki i bohaterowie' : 'books and characters'} - Castellation` : (pl ? 'Autor - Castellation' : 'Author - Castellation');
const description = status === 200 ? (pl ? `Odkryj książki autora ${author} dostępne w Castellation i poznaj ich bohaterów.` : `Explore books by ${author} available on Castellation and discover their characters.`) : '';
---
<Layout lang={lang} title={title} description={description} noindex={status !== 200}>
  <SiteHeader lang={lang} />
  <main class="wrap author-page">{status === 200 ? <><Breadcrumbs lang={lang} structured={true} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: author }]} /><section class="author-hero"><div><p class="eyebrow">✦ {pl ? 'AUTOR W BIBLIOTECE' : 'AUTHOR IN THE LIBRARY'}</p><h1>{author}</h1><p>{pl ? 'Odkrywaj historie tego autora dostępne w Castellation i poznawaj ich bohaterów we własnym tempie.' : 'Explore this author’s stories available on Castellation and meet their characters at your own pace.'}</p><a class="author-jump" href="#author-books">{pl ? 'Zobacz książki' : 'See the books'} ↓</a></div><div class="author-emblem" aria-hidden="true"><span>{author.slice(0, 1)}</span><small>✳ CASTELLATION</small></div></section>{author === 'Lewis Carroll' && books.some((book) => book.slug === 'alices-adventures-in-wonderland') && <aside class="author-editorial"><div><p class="eyebrow">✦ {pl ? 'ZA HISTORIĄ' : 'BEHIND THE STORY'}</p><h2>{pl ? 'Od rzeki do Krainy Czarów.' : 'From the river to Wonderland.'}</h2><p>{pl ? 'Poznaj początki opowieści o Alicji na podstawie źródeł bibliotecznych.' : 'Explore the origins of Alice through library sources.'}</p></div><a href={`/guides/lewis-carroll-and-alice?lang=${lang}`}>{pl ? 'Przeczytaj historię' : 'Read the story'} ↗</a></aside>}<section id="author-books"><div class="collection-bar"><h2>{pl ? 'Książki w Castellation' : 'Books on Castellation'}</h2><span>{String(books.length).padStart(2, '0')}</span></div><ol class="author-story-list">{books.map((book, index) => <li><div class="author-story-art" aria-hidden="true">{book.slug === 'alices-adventures-in-wonderland' ? <img src="/images/alice-rabbit-hole.webp" alt="" width="768" height="1152" loading="lazy" /> : book.slug === 'a-christmas-carol' ? <div class="dickens-cover"><span>CHARLES DICKENS</span><strong>A<br />Christmas<br />Carol</strong><i>✳</i><span>1843</span></div> : <span>✳</span>}<small>0{index + 1} / {pl ? 'HISTORIA' : 'STORY'}</small></div><div class="author-story-copy"><p class="author-story-kicker">✦ {pl ? 'Z BIBLIOTEKI CASTELLATION' : 'FROM THE CASTELLATION LIBRARY'}</p><h3>{book.title}</h3><p>{book.slug === 'a-christmas-carol' ? (pl ? 'Opowieść Dickensa ukazała się w grudniu 1843 roku. Poznaj Scrooge’a i ludzi z jego świata od początku historii.' : 'Dickens’s story was published in December 1843. Meet Scrooge and the people in his world from the beginning.') : (pl ? 'Odkryj książkę i poznaj postacie oraz ich powiązania w wybranym miejscu lektury.' : 'Explore the book and meet its characters and connections at your chosen reading point.')}</p>{book.slug === 'a-christmas-carol' && <a class="dickens-source" href="https://blogs.loc.gov/loc/2015/12/highlighting-the-holidays-a-tale-of-two-publishings/">{pl ? 'O pierwszym wydaniu - Library of Congress' : 'About the first edition - Library of Congress'} ↗</a>}<div class="author-story-actions"><a class="author-story-primary" href={book.slug === 'a-christmas-carol' ? `/books/${encodeURIComponent(book.slug)}/opening?lang=${lang}` : `/books/${encodeURIComponent(book.slug)}?lang=${lang}`}>{book.slug === 'a-christmas-carol' ? (pl ? 'Odkryj początek historii' : 'Explore the opening') : (pl ? 'Poznaj książkę' : 'Explore the book')} ↗</a><a href={`/books/${encodeURIComponent(book.slug)}/map?lang=${lang}`}>{pl ? 'Otwórz mapę postaci' : 'Open the character map'} ↗</a></div></div></li>)}</ol></section></> : <h1>{status === 503 ? (pl ? 'Biblioteka jest chwilowo niedostępna' : 'Library temporarily unavailable') : (pl ? 'Nie znaleziono autora' : 'Author not found')}</h1>}</main>
  <SiteFooter lang={lang} />
</Layout>

<style>
.author-story-list{list-style:none;padding:0;margin:30px 0 0;display:grid;gap:24px}.author-story-list li{display:grid;grid-template-columns:minmax(220px,.8fr) 1.2fr;background:#e2e9dd;min-height:360px}.author-story-art{position:relative;overflow:hidden;display:grid;place-items:center;background:#334b3d;color:#e8b99b;font-size:90px;min-height:300px}.author-story-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 38%}.dickens-cover{position:absolute;inset:25px;border:1px solid #d9ad90;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:18px;color:#f5e4d3}.dickens-cover span{font:700 10px/1.4 sans-serif;letter-spacing:.18em}.dickens-cover strong{font:500 clamp(28px,3.5vw,46px)/1.05 'Playfair Display',serif}.dickens-cover i{font:normal 25px/1 serif;color:#e8b99b}.dickens-source{font-size:12px;font-weight:700;text-decoration:underline;text-underline-offset:4px;color:#405448}.dickens-source:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}.author-story-art small{position:absolute;left:22px;bottom:20px;background:#293f34;color:#fff;padding:9px 12px;font:700 10px sans-serif;letter-spacing:.12em}.author-story-copy{padding:clamp(30px,4vw,55px);display:flex;flex-direction:column;align-items:start}.author-story-kicker{font-size:10px;font-weight:700;letter-spacing:.14em;color:#87452c}.author-story-copy h3{font:500 clamp(32px,4vw,50px)/1.12 'Playfair Display',serif;margin:22px 0 14px}.author-story-copy>p:not(.author-story-kicker){line-height:1.7;color:#405448;max-width:440px}.author-story-actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:auto;padding-top:24px}.author-story-actions a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.author-story-actions .author-story-primary{background:#293f34;color:#fff;padding:16px 20px;text-decoration:none}.author-story-actions a:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}@media(max-width:700px){.author-story-list li{grid-template-columns:1fr}.author-story-art{min-height:240px}.author-story-copy{padding:26px}.author-story-copy h3{font-size:32px}.author-story-actions{align-items:flex-start;flex-direction:column}}
</style>
