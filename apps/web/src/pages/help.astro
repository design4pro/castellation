---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
---
<Layout lang={lang} title={pl ? 'Pomoc - konto, postęp i mapy książek - Castellation' : 'Help with accounts, reading progress and book maps - Castellation'} description={pl ? 'Odpowiedzi na pytania o konto, zapis postępu, zakres spoilerów i korzystanie z map Castellation.' : 'Answers about accounts, saving progress, spoiler boundaries and using Castellation book maps.'}>
  <SiteHeader lang={lang} />
  <main><header class="help-hero"><div class="wrap help-hero-inner"><div><p class="help-kicker">✦ {pl ? 'POMOC CZYTELNIKA' : 'READER HELP'}</p><h1>{pl ? 'Masz pytanie?' : 'Have a question?'}<br /><em>{pl ? 'Znajdź odpowiedź.' : 'Find your answer.'}</em></h1><p>{pl ? 'Najważniejsze informacje o mapach, postępie i koncie - w jednym miejscu.' : 'The essentials about maps, reading progress and accounts, in one place.'}</p></div><nav class="help-quick" aria-label={pl ? 'Szybkie odpowiedzi' : 'Quick answers'}><p>{pl ? 'ZACZNIJ TUTAJ' : 'START HERE'}</p><a href="#account-needed"><span>01</span><strong>{pl ? 'Czy potrzebuję konta?' : 'Do I need an account?'}</strong><small>{pl ? 'Nie, aby odkrywać mapy.' : 'Not to explore the maps.'}</small><span aria-hidden="true">↘</span></a><a href="#saving-progress"><span>02</span><strong>{pl ? 'Gdzie zapisuje się postęp?' : 'Where is my progress saved?'}</strong><small>{pl ? 'W przeglądarce lub na koncie.' : 'In your browser or account.'}</small><span aria-hidden="true">↘</span></a><a href="#spoilers"><span>03</span><strong>{pl ? 'A co ze spoilerami?' : 'What about spoilers?'}</strong><small>{pl ? 'Wybierz swój rozdział.' : 'Choose your chapter.'}</small><span aria-hidden="true">↘</span></a></nav></div></header>
  <div class="wrap help-layout"><nav class="help-toc" aria-label={pl ? 'Tematy pomocy' : 'Help topics'}><p>{pl ? 'TEMATY' : 'TOPICS'}</p><a href="#getting-started">01 / {pl ? 'Pierwsze kroki' : 'Getting started'}</a><a href="#progress">02 / {pl ? 'Postęp i konto' : 'Progress and account'}</a><a href="#reading">03 / {pl ? 'Zakres lektury' : 'Reading boundary'}</a><a href="#print">04 / {pl ? 'Karta do druku' : 'Printable sheet'}</a></nav><div class="help-body">
    <section id="getting-started"><p class="help-number">01 / {pl ? 'PIERWSZE KROKI' : 'GETTING STARTED'}</p><h2>{pl ? 'Zacznij od książki' : 'Start with a book'}</h2><article id="account-needed"><h3>{pl ? 'Czy potrzebuję konta, aby zobaczyć mapę?' : 'Do I need an account to explore a map?'}</h3><p>{pl ? 'Nie. Otwórz książkę z biblioteki i przejdź do jej mapy. Konto jest potrzebne do zapisywania postępu na koncie i korzystania z niego na innych urządzeniach.' : 'No. Open a book from the library and visit its map. An account is needed to save progress to your account and use it on other devices.'}</p><a href={`/library?lang=${lang}`}>{pl ? 'Otwórz bibliotekę' : 'Open the library'} ↗</a></article><article><h3>{pl ? 'Co pokazuje mapa?' : 'What does the map show?'}</h3><p>{pl ? 'Pokazuje dostępne postacie, kierunkowe relacje i wydarzenia do wybranego rozdziału. Możesz wybrać postać na grafie lub skorzystać z listy tekstowej poniżej.' : 'It shows available characters, directional relationships and events up to your selected chapter. Select a character on the graph or use the text list below it.'}</p><a href={`/how-it-works?lang=${lang}`}>{pl ? 'Zobacz, jak działa mapa' : 'See how the map works'} ↗</a></article></section>
    <section id="progress"><p class="help-number">02 / {pl ? 'POSTĘP I KONTO' : 'PROGRESS AND ACCOUNT'}</p><h2>{pl ? 'Wróć do właściwego miejsca' : 'Return to the right place'}</h2><div id="saving-progress" class="save-compare" aria-labelledby="save-compare-title"><p class="save-label">✦ {pl ? 'WYBIERZ SPOSÓB POWROTU' : 'CHOOSE HOW TO RETURN'}</p><h3 id="save-compare-title">{pl ? 'Dwa miejsca zapisu. Jedna historia.' : 'Two places to save. One story.'}</h3><p class="save-intro">{pl ? 'Odkrywanie map nie wymaga konta. Wybierz sposób zapisu odpowiedni dla siebie.' : 'You can explore maps without an account. Choose the way to save that works for you.'}</p><div class="save-options"><div><span>01 / {pl ? 'W PRZEGLĄDARCE' : 'IN YOUR BROWSER'}</span><h4>{pl ? 'Na tym urządzeniu' : 'On this device'}</h4><p>{pl ? 'Bez konta wybrany rozdział pozostaje w tej przeglądarce. Usunięcie jej danych może usunąć zapis.' : 'Without an account, your selected chapter stays in this browser. Clearing its data can remove the save.'}</p><a href={`/library?lang=${lang}`}>{pl ? 'Otwórz bibliotekę' : 'Open the library'} ↗</a></div><div><span>02 / {pl ? 'NA KONCIE' : 'IN YOUR ACCOUNT'}</span><h4>{pl ? 'Na różnych urządzeniach' : 'Across devices'}</h4><p>{pl ? 'Po zalogowaniu wybór rozdziału zapisuje postęp na koncie, z którego możesz korzystać na innych urządzeniach.' : 'When signed in, choosing a chapter saves progress to your account, available on your other devices.'}</p><a href={`/account?lang=${lang}`}>{pl ? 'Przejdź do konta' : 'Go to account'} ↗</a></div></div><p class="save-note">{pl ? 'Zapisy są osobne i nie przenoszą się automatycznie. Po zalogowaniu wybierz właściwy rozdział, aby zapisać go na koncie. Gdy usługa konta jest niedostępna, możesz zapisać rozdział osobno w przeglądarce.' : 'The saves are separate and do not transfer automatically. After signing in, select the right chapter to save it to your account. If the account service is unavailable, you can save the chapter separately in your browser.'}</p></div></section>
    <section id="reading"><p class="help-number">03 / {pl ? 'ZAKRES LEKTURY' : 'READING BOUNDARY'}</p><h2>{pl ? 'Czytaj we własnym tempie' : 'Read at your own pace'}</h2><article id="spoilers"><h3>{pl ? 'Czy mapa gwarantuje brak spoilerów?' : 'Does the map guarantee there are no spoilers?'}</h3><p>{pl ? 'Wybrany rozdział ogranicza widoczne dane do tego miejsca, ale przypisanie informacji może zawierać błąd, a numeracja różnić się między wydaniami. Jeśli nie masz pewności, wybierz wcześniejszy rozdział.' : 'Your selected chapter limits visible data to that point, but a detail may be assigned incorrectly and chapter numbering can differ between editions. If unsure, choose an earlier chapter.'}</p><a href={`/our-method?lang=${lang}`}>{pl ? 'Poznaj nasze podejście do źródeł' : 'Read about our approach to sources'} ↗</a></article><article><h3>{pl ? 'Dlaczego nie widzę dalszych rozdziałów?' : 'Why can’t I see later chapters?'}</h3><p>{pl ? 'Katalog jest rozwijany, a dostępność danych różni się między książkami. Selektor pokazuje rozdziały dostępne obecnie w mapie, niekoniecznie wszystkie rozdziały książki.' : 'The catalog is growing, and available data varies by book. The selector lists chapters currently available in the map, not necessarily every chapter of the book.'}</p></article></section>
    <section id="print"><p class="help-number">04 / {pl ? 'KARTA DO DRUKU' : 'PRINTABLE SHEET'}</p><h2>{pl ? 'Zabierz historię ze sobą' : 'Take the story with you'}</h2><article><h3>{pl ? 'Jak wydrukować postacie i relacje?' : 'How can I print characters and connections?'}</h3><p>{pl ? 'Na mapie ustaw przeczytany rozdział i wybierz „Karta czytelnika do druku”. Karta pokazuje informacje do tego miejsca oraz przestrzeń na własne notatki. Opcja drukowania używa przeglądarki.' : 'On the map, set the chapter you have read and choose “Printable reading sheet”. The sheet shows details up to that point and space for your notes. Printing uses your browser.'}</p></article></section>
    <aside class="help-next"><div><p class="help-number">✦ {pl ? 'GOTOWY NA HISTORIĘ?' : 'READY FOR A STORY?'}</p><h2>{pl ? 'Wybierz swój świat.' : 'Choose your world.'}</h2></div><a class="primary-button" href={`/library?lang=${lang}`}>{pl ? 'Odkryj bibliotekę' : 'Explore the library'} ↗</a></aside></div></div></main><SiteFooter lang={lang} />
</Layout>
<style>
.help-hero{background:#334b3d;color:#f6f4ed}.help-hero-inner{display:grid;grid-template-columns:1.4fr 1fr;gap:70px;align-items:center;padding-block:80px}.help-kicker{font-size:10px;letter-spacing:.16em;font-weight:700;color:#e3b799}.help-hero h1{font:500 clamp(48px,6vw,78px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:25px 0}.help-hero h1 em{font-weight:400;color:#e3b799}.help-hero-inner>div>p:last-child{max-width:500px;line-height:1.8;color:#dce5d8}.help-quick{border-top:1px solid #789181}.help-quick>p{font-size:10px;letter-spacing:.15em;font-weight:700;color:#e3b799;margin:18px 0}.help-quick a{display:grid;grid-template-columns:28px 1fr auto;gap:6px 15px;padding:18px 0;border-top:1px solid #789181}.help-quick a>span:first-child{grid-row:1 / 3;font-size:10px;color:#e3b799}.help-quick strong{font:500 22px/1.2 'Playfair Display',serif}.help-quick small{grid-column:2;color:#dce5d8;font-size:13px}.help-quick a>span:last-child{grid-column:3;grid-row:1 / 3;color:#e3b799;font-size:23px}.help-quick a:hover strong{text-decoration:underline;text-underline-offset:4px}.help-quick a:focus-visible{outline:3px solid #e3b799;outline-offset:4px}.help-body article{scroll-margin-top:25px}.help-layout{display:grid;grid-template-columns:220px minmax(0,760px);gap:80px;padding-block:80px 100px}.help-toc{position:sticky;top:25px;align-self:start;display:flex;flex-direction:column;gap:18px}.help-toc p,.help-number{font-size:10px;letter-spacing:.15em;font-weight:700;color:#985438}.help-toc a{font-size:13px;text-decoration:underline;text-underline-offset:4px}.help-body section{margin-bottom:65px;scroll-margin-top:25px}.help-body h2{font:500 clamp(30px,3vw,42px)/1.2 'Playfair Display',serif;margin:15px 0 25px}.help-body article{border-top:1px solid #cbd5c9;padding:24px 0}.help-body h3{font:500 24px/1.25 'Playfair Display',serif;margin:0 0 12px}.help-body article p{font-size:16px;line-height:1.8;color:#405448}.help-body article a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:4px}.save-compare{scroll-margin-top:25px;background:#334b3d;color:#f6f4ed;padding:clamp(24px,4vw,38px);margin-top:32px}.save-label{font-size:10px;letter-spacing:.13em;font-weight:700;color:#e3b799}.save-compare h3{font-size:clamp(27px,3vw,36px);margin:18px 0 10px}.save-intro{color:#dce5d8;line-height:1.7;max-width:48ch}.save-options{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#91a696;border:1px solid #91a696;margin-top:30px}.save-options>div{background:#334b3d;padding:23px;display:flex;flex-direction:column}.save-options span{font-size:10px;letter-spacing:.1em;font-weight:700;color:#e3b799}.save-options h4{font:500 24px/1.2 'Playfair Display',serif;margin:20px 0 10px}.save-options p{color:#dce5d8;line-height:1.7;font-size:14px;flex:1}.save-options a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px;margin-top:18px}.save-options a:focus-visible{outline:2px solid #e3b799;outline-offset:5px}.save-note{border-top:1px solid #91a696;margin:25px 0 0;padding-top:20px;color:#dce5d8;font-size:13px;line-height:1.7}.help-next{background:#e1e8dc;padding:35px;display:flex;justify-content:space-between;align-items:end;gap:25px}.help-next h2{margin-bottom:0}@media(max-width:760px){.help-hero-inner{grid-template-columns:1fr;gap:25px;padding-block:55px}.help-quick{margin-top:10px}.help-layout{grid-template-columns:1fr;gap:35px;padding-block:45px 70px}.help-toc{position:static;border-bottom:1px solid #d9ddd3;padding-bottom:25px}.save-options{grid-template-columns:1fr}.help-next{display:block;padding:25px}.help-next .primary-button{margin-top:20px}}
</style>
