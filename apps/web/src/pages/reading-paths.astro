---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const paths = pl ? [
  { number: '01', label: 'NA DOBRY POCZĄTEK', title: 'Wejdź do historii.', description: 'Przeglądaj bibliotekę albo poznaj przykład Alicji od pierwszej sceny do mapy.', steps: [{label:'Wybierz książkę', href:'/library'}, {label:'Poznaj początek Alicji', href:'/guides/alice-down-the-rabbit-hole'}, {label:'Otwórz mapę Alicji', href:'/books/alices-adventures-in-wonderland/map'}] },
  { number: '02', label: 'DLA CIEKAWYCH BOHATERÓW', title: 'Podążaj za postaciami.', description: 'Zauważ, kto pojawia się na kartach książki i co zmienia się między bohaterami.', steps: [{label:'Jak śledzić bohaterów', href:'/guides/track-characters'}, {label:'Czytaj relacje między postaciami', href:'/guides/reading-character-connections'}, {label:'Poznaj bohaterów', href:'/characters'}] },
  { number: '03', label: 'DO WSPÓLNEJ LEKTURY', title: 'Rozmawiaj o książkach.', description: 'Zacznij od wspólnej granicy lektury, a potem porównaj pytania i pierwsze wrażenia.', steps: [{label:'Pytania do klubu książki', href:'/guides/book-club-questions'}, {label:'Porównaj dwa początki', href:'/guides/two-unexpected-beginnings'}, {label:'Odkryj przewodniki', href:'/guides'}] },
] : [
  { number: '01', label: 'FOR A FIRST ENCOUNTER', title: 'Step into a story.', description: 'Browse the library or try Alice’s opening and map as an example.', steps: [{label:'Choose a book', href:'/library'}, {label:'Explore Alice’s opening', href:'/guides/alice-down-the-rabbit-hole'}, {label:'Open Alice’s story map', href:'/books/alices-adventures-in-wonderland/map'}] },
  { number: '02', label: 'FOR CHARACTER CURIOUS READERS', title: 'Follow the characters.', description: 'Notice who appears on the page and what changes between the people in a story.', steps: [{label:'How to track characters', href:'/guides/track-characters'}, {label:'Read character connections', href:'/guides/reading-character-connections'}, {label:'Meet the characters', href:'/characters'}] },
  { number: '03', label: 'FOR READING TOGETHER', title: 'Talk about books.', description: 'Start with a shared reading boundary, then compare questions and first impressions.', steps: [{label:'Book club questions', href:'/guides/book-club-questions'}, {label:'Compare two beginnings', href:'/guides/two-unexpected-beginnings'}, {label:'Discover reading guides', href:'/guides'}] },
];
---
<Layout lang={lang} title={pl ? 'Ścieżki czytelnicze - odkrywaj książki i bohaterów | Castellation' : 'Reading paths - discover books and characters | Castellation'} description={pl ? 'Wybierz ścieżkę: odkryj nową historię, śledź bohaterów lub znajdź inspirację do rozmowy o książce.' : 'Choose a reading path: discover a story, follow its characters, or find inspiration for a book discussion.'}>
  <SiteHeader lang={lang} />
  <main>
    <header class="paths-hero"><div class="wrap paths-intro"><div><p class="paths-eyebrow">✦ {pl ? 'TRZY DROGI DO HISTORII' : 'THREE WAYS INTO A STORY'}</p><h1>{pl ? 'Dokąd zaprowadzi Cię' : 'Where will your'} <em>{pl ? 'ciekawość?' : 'curiosity lead?'}</em></h1><p>{pl ? 'Nie musisz wiedzieć, od czego zacząć. Wybierz to, co Cię ciekawi, a my wskażemy kolejne kroki.' : 'You don’t need to know where to begin. Choose what interests you and follow the next step.'}</p><a href="#paths">{pl ? 'Wybierz swoją ścieżkę' : 'Choose your path'} ↓</a></div><div class="paths-orbit" aria-hidden="true"><span>✳</span><span>✦</span><span>✳</span><small>READ · NOTICE · CONNECT</small></div></div></header>
    <section class="wrap paths-list" id="paths" aria-labelledby="paths-title"><div class="paths-bar"><h2 id="paths-title">{pl ? 'Wybierz swój kierunek' : 'Choose your direction'}</h2><span>03 / ✦</span></div>{paths.map((path) => <article class="path"><div class="path-number" aria-hidden="true">{path.number}</div><div class="path-copy"><p class="paths-eyebrow">{path.label}</p><h3>{path.title}</h3><p>{path.description}</p></div><div class="path-route"><p>{pl ? 'WYBIERZ PUNKT WEJŚCIA' : 'CHOOSE A STARTING POINT'}</p><ul>{path.steps.map((step, index) => <li><a href={`${step.href}?lang=${lang}`}><span aria-hidden="true">{index === 0 ? '✳' : '✦'}</span><strong>{step.label}</strong><span aria-hidden="true">↗</span></a></li>)}</ul></div></article>)}</section>
    <aside class="wrap paths-end"><p class="paths-eyebrow">✦ {pl ? 'CZYTAJ PO SWOJEMU' : 'READ AT YOUR OWN PACE'}</p><h2>{pl ? 'Każda historia ma więcej niż jedno wejście.' : 'Every story has more than one way in.'}</h2><a href={`/guides?lang=${lang}`}>{pl ? 'Zobacz wszystkie przewodniki' : 'Explore all reading guides'} ↗</a></aside>
  </main>
  <SiteFooter lang={lang} />
</Layout>
<style>
.paths-hero{background:#344b3d;color:#f6f4ed}.paths-intro{display:grid;grid-template-columns:1.3fr 1fr;align-items:center;gap:70px;padding-block:85px 95px}.paths-eyebrow{font-size:10px;font-weight:700;letter-spacing:.16em;color:#ab6748}.paths-hero .paths-eyebrow{color:#e5b99e}.paths-intro h1{font:500 clamp(50px,6.5vw,90px)/1.08 'Playfair Display',serif;letter-spacing:-.045em;margin:25px 0}.paths-intro h1 em{color:#e5b99e;font-weight:400}.paths-intro>div:first-child>p:not(.paths-eyebrow){max-width:490px;line-height:1.8;color:#e1e9df}.paths-intro a,.paths-end a{display:inline-block;margin-top:22px;font-weight:700;text-decoration:underline;text-underline-offset:6px}.paths-orbit{height:320px;position:relative;border:1px solid #8da293;border-radius:50%;display:flex;align-items:center;justify-content:space-evenly;color:#e5b99e;font-size:52px}.paths-orbit:before{content:'';position:absolute;inset:22%;border:1px solid #8da293;border-radius:50%}.paths-orbit span{z-index:1;background:#344b3d}.paths-orbit span:nth-child(2){font-size:80px}.paths-orbit small{position:absolute;bottom:35px;font-size:9px;letter-spacing:.18em}.paths-list{padding-block:75px}.paths-bar{display:flex;justify-content:space-between;border-block:1px solid #aebdb0;padding:16px 0;font-size:11px;font-weight:700;letter-spacing:.14em}.paths-bar h2{font:inherit;text-transform:uppercase;margin:0}.path{display:grid;grid-template-columns:90px 1fr 1fr;gap:35px;padding:52px 0;border-bottom:1px solid #c7d1c5}.path-number{font:400 55px 'Playfair Display',serif;color:#a35e3e}.path-copy h3{font:500 clamp(31px,3vw,44px)/1.2 'Playfair Display',serif;margin:15px 0}.path-copy>p:last-child{line-height:1.75;color:#405448;max-width:360px}.path ol{list-style:none;margin:0;padding:0}.path li{border-bottom:1px solid #c7d1c5}.path a{display:grid;grid-template-columns:35px 1fr auto;gap:12px;padding:18px 0;align-items:center}.path a span:first-child{font-size:11px;color:#985438}.path a:hover strong{text-decoration:underline;text-underline-offset:5px}.paths-end{background:#e1e8dc;padding:45px;margin-bottom:80px}.paths-end h2{max-width:700px;font:500 clamp(30px,3vw,45px)/1.2 'Playfair Display',serif;margin:15px 0}.paths-end a{margin-top:10px}@media(max-width:760px){.paths-intro{grid-template-columns:1fr;gap:35px;padding-block:50px}.paths-orbit{height:200px;max-width:300px}.paths-list{padding-block:45px}.path{grid-template-columns:45px 1fr;gap:15px;padding:32px 0}.path-number{font-size:32px}.path ol{grid-column:2}.paths-end{padding:28px;margin-bottom:55px}}
</style>

<style>
.paths-list .path{grid-template-columns:70px minmax(0,1fr) minmax(0,1.1fr);gap:32px;align-items:stretch;padding:28px;margin:18px 0;border:0;background:#e1e8dc}.paths-list .path:nth-of-type(even){background:#eee4d8}.paths-list .path-number{font-size:52px;line-height:1}.paths-list .path-copy{padding:5px 10px 10px 0}.paths-list .path-copy h3{font-size:clamp(32px,3.8vw,48px)}.path-route{background:#334b3d;color:#f6f4ed;padding:24px 28px}.path-route>p{font-size:10px;letter-spacing:.14em;font-weight:700;color:#f0c3a5;margin:0 0 12px}.path-route ul{list-style:none;padding:0;margin:0}.path-route li{border-bottom:1px solid #789181}.path-route li:last-child{border:0}.path-route a{display:grid;grid-template-columns:25px 1fr auto;gap:12px;padding:17px 0;align-items:center}.path-route a span:first-child{font-size:16px;color:#f0c3a5}.path-route a:focus-visible{outline:3px solid #f0c3a5;outline-offset:4px}.path-route a:hover strong{text-decoration:underline;text-underline-offset:4px}@media(max-width:760px){.paths-list .path{grid-template-columns:40px 1fr;gap:14px;padding:22px}.paths-list .path-number{font-size:32px}.paths-list .path-copy{padding:0}.path-route{grid-column:1/-1;padding:20px}.paths-list .path-copy h3{font-size:31px}}
</style>
