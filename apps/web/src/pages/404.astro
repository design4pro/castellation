---
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
Astro.response.status = 404;
---
<Layout lang={lang} title={pl ? 'Nie znaleziono strony - Castellation' : 'Page not found - Castellation'} description={pl ? 'Nie znaleziono tej strony. Wróć do biblioteki lub odkryj przewodniki czytelnika.' : 'This page could not be found. Visit the library or explore our reading guides.'} noindex={true}>
  <SiteHeader lang={lang} />
  <main class="wrap lost-page"><div class="lost-copy"><p class="eyebrow">✦ 404 / {pl ? 'NIE ZNALEZIONO STRONY' : 'PAGE NOT FOUND'}</p><h1>{pl ? 'Ten wątek' : 'This thread'}<br /><em>{pl ? 'prowadzi donikąd.' : 'ends here.'}</em></h1><p>{pl ? 'Nie możemy znaleźć tej strony. Możesz wrócić do znanych historii albo odkryć nową drogę przez bibliotekę.' : 'We couldn’t find this page. Return to a familiar story or discover another path through the library.'}</p><div class="lost-actions"><a class="primary-button" href={`/library?lang=${lang}`}>{pl ? 'Odkryj bibliotekę' : 'Explore the library'} ↗</a><a class="lost-guides" href={`/guides?lang=${lang}`}>{pl ? 'Przeglądaj przewodniki' : 'Browse reading guides'} ↗</a></div></div><div class="lost-art" aria-hidden="true"><span class="lost-orbit lost-orbit-one"></span><span class="lost-orbit lost-orbit-two"></span><span class="lost-star">✳</span><span class="lost-spark">✦</span><span class="lost-number">04<span>✳</span>04</span><span class="lost-caption">A NEW PATH AWAITS</span></div></main>
  <footer class="wrap footer"><a class="brand" href={`/?lang=${lang}`}>✳ castellation<span class="brand-dot">.</span></a><p>{pl ? 'Historie są lepsze, gdy widzisz ich powiązania.' : 'Stories are better when you see the connections.'}</p><span>© {new Date().getFullYear()} CASTELLATION</span></footer>
</Layout>
<style>
.lost-page{min-height:calc(100vh - 220px);display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;padding-block:70px 95px}.lost-copy h1{font:500 clamp(54px,6vw,82px)/1.08 'Playfair Display',serif;letter-spacing:-.045em;margin:25px 0}.lost-copy h1 em{font-weight:400;color:#a35e3e}.lost-copy>p:not(.eyebrow){max-width:460px;line-height:1.8;color:#53675a;font-size:16px}.lost-actions{display:flex;align-items:center;flex-wrap:wrap;gap:28px;margin-top:35px}.lost-guides{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.lost-art{min-height:450px;background:#334b3d;border-radius:48% 48% 2px 2px;position:relative;overflow:hidden;display:grid;place-items:center;color:#e9eadf}.lost-orbit{position:absolute;border:1px solid #8da393;border-radius:50%;width:300px;height:300px}.lost-orbit-two{width:210px;height:210px}.lost-star{position:absolute;top:15%;right:19%;font-size:54px;color:#d7a78a}.lost-spark{position:absolute;bottom:21%;left:19%;font-size:30px;color:#d7a78a}.lost-number{font:500 clamp(75px,8vw,115px) 'Playfair Display',serif;letter-spacing:-.08em}.lost-number span{font:30px sans-serif;color:#d7a78a;vertical-align:middle;margin:0 12px}.lost-caption{position:absolute;bottom:35px;font-size:9px;letter-spacing:.2em}@media(max-width:760px){.lost-page{grid-template-columns:1fr;gap:40px;padding-block:50px 65px}.lost-copy h1{font-size:clamp(45px,12vw,62px)}.lost-actions{align-items:flex-start;flex-direction:column;gap:22px}.lost-art{min-height:300px}.lost-orbit-one{width:220px;height:220px}.lost-orbit-two{width:150px;height:150px}.lost-number{font-size:72px}}
</style>
