---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
Astro.response.status = 404;
let books = [];
try {
  const api = import.meta.env.PUBLIC_API_URL;
  const response = api ? await fetch(`${api}/api/books`) : await env.API.fetch(new Request(`${Astro.url.origin}/api/books`));
  if (response.ok) books = (await response.json()).books;
} catch { /* Keep the recovery links available if the catalog is offline. */ }
const pathSlug = Astro.url.pathname.match(/^\/books\/([^/]+)/)?.[1];
const match = books.find((book) => encodeURIComponent(book.slug) === pathSlug);
const suggestions = match ? [match] : books.slice(0, 2);
---
<Layout lang={lang} title={pl ? 'Nie znaleziono strony - Castellation' : 'Page not found - Castellation'} description={pl ? 'Nie znaleziono tej strony. Wróć do biblioteki lub odkryj przewodniki czytelnika.' : 'This page could not be found. Visit the library or explore our reading guides.'} noindex={true}>
  <SiteHeader lang={lang} />
  <main class="wrap lost-page"><div class="lost-copy"><p class="eyebrow">✦ 404 / {pl ? 'NIE ZNALEZIONO STRONY' : 'PAGE NOT FOUND'}</p><h1>{pl ? 'Ten wątek' : 'This thread'}<br /><em>{pl ? 'prowadzi donikąd.' : 'ends here.'}</em></h1><p>{pl ? 'Nie możemy znaleźć tej strony. Możesz wrócić do znanych historii albo odkryć nową drogę przez bibliotekę.' : 'We couldn’t find this page. Return to a familiar story or discover another path through the library.'}</p><form class="lost-search" action="/library" method="get"><input type="hidden" name="lang" value={lang} /><label for="lost-query">{pl ? 'Znajdź tytuł lub autora' : 'Find a title or author'}</label><div><input id="lost-query" name="q" type="search" required placeholder={pl ? 'Na przykład Alice' : 'For example, Alice'} /><button type="submit">{pl ? 'Szukaj' : 'Search'} ↗</button></div><noscript><p>{pl ? 'Wyszukiwanie w bibliotece wymaga JavaScript.' : 'Library search requires JavaScript.'}</p></noscript></form><div class="lost-actions"><a class="primary-button" href={`/library?lang=${lang}`}>{pl ? 'Odkryj bibliotekę' : 'Explore the library'} ↗</a><a class="lost-guides" href={`/guides?lang=${lang}`}>{pl ? 'Przeglądaj przewodniki' : 'Browse reading guides'} ↗</a></div></div>{suggestions.length > 0 && <section class="lost-shelf" aria-labelledby="lost-shelf-title"><div class="lost-shelf-heading"><p>✦ {match ? (pl ? 'WRÓĆ DO HISTORII' : 'RETURN TO THE STORY') : (pl ? 'WYBIERZ NOWY KIERUNEK' : 'FIND ANOTHER WAY')}</p><h2 id="lost-shelf-title">{match ? (pl ? 'Twoja książka czeka.' : 'Your book is waiting.') : (pl ? 'Historie, od których możesz zacząć.' : 'Stories to start with.')}</h2><span>{match ? (pl ? 'Ta część strony jest niedostępna, ale książkę nadal możesz otworzyć.' : 'This page is unavailable, but you can still open the book.') : (pl ? 'Otwórz książkę i odkryj jej bohaterów.' : 'Open a book and discover its characters.')}</span></div><div class="lost-shelf-list">{suggestions.map((book, index) => <a href={`/books/${encodeURIComponent(book.slug)}?lang=${lang}`}><span class="lost-shelf-number">{String(index + 1).padStart(2, '0')}</span><span><strong>{book.title}</strong><small>{book.author}</small></span><span class="lost-shelf-arrow" aria-hidden="true">↗</span></a>)}</div></section>}</main>
  <SiteFooter lang={lang} />
</Layout>
<style>
.lost-page{min-height:calc(100vh - 220px);display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;padding-block:70px 95px}.lost-copy h1{font:500 clamp(54px,6vw,82px)/1.08 'Playfair Display',serif;letter-spacing:-.045em;margin:25px 0}.lost-copy h1 em{font-weight:400;color:#a35e3e}.lost-copy>p:not(.eyebrow){max-width:460px;line-height:1.8;color:#53675a;font-size:16px}.lost-actions{display:flex;align-items:center;flex-wrap:wrap;gap:28px;margin-top:35px}.lost-guides{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.lost-shelf{background:#334b3d;color:#f6f4ed}.lost-shelf-heading{padding:36px;border-bottom:1px solid #789181}.lost-shelf-heading p{font-size:10px;font-weight:700;letter-spacing:.14em;color:#f0c3a5}.lost-shelf-heading h2{font:500 clamp(30px,3.5vw,45px)/1.12 'Playfair Display',serif;margin:20px 0}.lost-shelf-heading>span{display:block;font-size:14px;line-height:1.7;color:#dce5d8}.lost-shelf-list a{display:grid;grid-template-columns:30px 1fr auto;gap:18px;padding:27px 36px;border-bottom:1px solid #789181}.lost-shelf-list a:hover{background:#45634f}.lost-shelf-list a:focus-visible{outline:3px solid #f0c3a5;outline-offset:-5px}.lost-shelf-number{font-size:10px;font-weight:700;color:#f0c3a5}.lost-shelf-list strong,.lost-shelf-list small{display:block}.lost-shelf-list strong{font:500 26px/1.2 'Playfair Display',serif}.lost-shelf-list small{font-size:13px;color:#dce5d8;margin-top:10px}.lost-shelf-arrow{font-size:23px;color:#f0c3a5}@media(max-width:760px){.lost-page{grid-template-columns:1fr;gap:40px;padding-block:50px 65px}.lost-copy h1{font-size:clamp(45px,12vw,62px)}.lost-actions{align-items:flex-start;flex-direction:column;gap:22px}.lost-shelf-heading{padding:26px}.lost-shelf-list a{padding:24px 26px}}
</style>

<style>.lost-search{margin-top:32px;padding:25px;background:#e1e8dc}.lost-search label{display:block;font:500 24px/1.2 'Playfair Display',serif;margin-bottom:14px}.lost-search>div{display:flex}.lost-search input[type=search]{min-width:0;flex:1;background:#fff;border:1px solid #8da595;padding:14px;font-size:16px;color:#27352f}.lost-search button{border:0;background:#334b3d;color:#fff;font-weight:700;padding:14px 18px;cursor:pointer}.lost-search button:hover{background:#496453}.lost-search input:focus-visible,.lost-search button:focus-visible{outline:3px solid #a35e3e;outline-offset:3px}.lost-search noscript p{font-size:13px;line-height:1.5}@media(max-width:380px){.lost-search>div{display:grid}.lost-search button{min-height:48px}}</style>
