---
import Layout from '../layouts/Layout.astro';
const lang=Astro.url.searchParams.get('lang')==='pl'?'pl':'en';
const pl=lang==='pl';
const api=import.meta.env.PUBLIC_API_URL||Astro.url.origin;
---
<Layout title={pl?'Nowe hasło - Castellation':'Reset password - Castellation'} lang={lang} noindex={true}>
<header class="site-header wrap"><a class="brand" href={`/?lang=${lang}`}>✳ castellation<span class="brand-dot">.</span></a></header>
<main class="wrap account-page" data-api={api} data-lang={lang}><h1>{pl?'Ustaw nowe hasło':'Set a new password'}</h1><form id="reset-form"><label for="new-password">{pl?'Nowe hasło - co najmniej 12 znaków':'New password - at least 12 characters'}</label><input id="new-password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128"/><button class="primary-button" type="submit">{pl?'Zapisz hasło':'Save password'}</button></form><p id="reset-status" role="status"></p><a href={`/account?lang=${lang}`}>{pl?'Wróć do logowania':'Back to sign in'}</a></main>
<script>
import {createAuthClient} from 'better-auth/client';
const params=new URLSearchParams(location.search);const token=params.get('token');const error=params.get('error');const root=document.querySelector<HTMLElement>('.account-page')!;const pl=root.dataset.lang==='pl';
history.replaceState(null,'',`${location.pathname}?lang=${pl?'pl':'en'}`);
const form=document.querySelector<HTMLFormElement>('#reset-form')!;const status=document.querySelector<HTMLElement>('#reset-status')!;
if(!token || error){form.hidden=true;status.textContent=pl?'Link jest nieprawidłowy lub wygasł.':'This link is invalid or expired.';}else{const auth=createAuthClient({baseURL:root.dataset.api,fetchOptions:{credentials:'include'}});form.addEventListener('submit',async(event)=>{event.preventDefault();const password=String(new FormData(form).get('password')||'');try{const result=await auth.resetPassword({newPassword:password,token});if(result.error)throw Error();form.hidden=true;status.textContent=pl?'Hasło zostało zmienione. Zaloguj się ponownie.':'Password changed. Please sign in again.';}catch{status.textContent=pl?'Nie udało się zmienić hasła. Link może być nieprawidłowy lub wygasły.':'Unable to reset your password. The link may be invalid or expired.';}});}
</script>
</Layout>
