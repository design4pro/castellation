---
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
const lang=Astro.url.searchParams.get('lang')==='pl'?'pl':'en';
const pl=lang==='pl';
const api=import.meta.env.PUBLIC_API_URL||Astro.url.origin;
---
<Layout title={pl?'Nowe hasło - Castellation':'Reset password - Castellation'} lang={lang} noindex={true}>
<SiteHeader lang={lang} />
<main class="wrap account-page reset-page" data-api={api} data-lang={lang}>
  <section class="reset-intro"><p class="reset-kicker">✦ {pl ? 'DOSTĘP DO KONTA' : 'ACCOUNT ACCESS'}</p><h1>{pl ? 'Wróć do swoich' : 'Return to your'} <em>{pl ? 'historii.' : 'stories.'}</em></h1><p>{pl ? 'Ustaw nowe hasło, aby ponownie zalogować się do Castellation.' : 'Set a new password to sign in to Castellation again.'}</p><div class="reset-art" aria-hidden="true"><span>✳</span><i></i><span>✦</span></div></section>
  <section class="reset-panel" aria-labelledby="reset-title"><p class="reset-step">{pl ? 'ODZYSKIWANIE DOSTĘPU' : 'RECOVER YOUR ACCESS'}</p><h2 id="reset-title">{pl ? 'Ustaw nowe hasło' : 'Set a new password'}</h2><p class="reset-help">{pl ? 'Wybierz hasło o długości co najmniej 12 znaków.' : 'Choose a password of at least 12 characters.'}</p><form id="reset-form" hidden><label for="new-password">{pl ? 'Nowe hasło' : 'New password'}</label><input id="new-password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128"/><button class="primary-button" type="submit">{pl ? 'Zapisz hasło' : 'Save password'} ↗</button></form><p id="reset-status" role="status"></p><div id="reset-recovery" hidden><p>{pl ? 'Wróć do logowania, wpisz adres e-mail i wybierz „Nie pamiętam hasła”, aby otrzymać nowy link.' : 'Return to sign in, enter your email and choose “Forgot password” to request a new link.'}</p></div><a class="reset-return" href={`/account?lang=${lang}`}>{pl ? 'Wróć do logowania' : 'Back to sign in'} ↗</a></section>
</main>
<script>
import {createAuthClient} from 'better-auth/client';
const params=new URLSearchParams(location.search);const token=params.get('token');const error=params.get('error');const root=document.querySelector<HTMLElement>('.account-page')!;const pl=root.dataset.lang==='pl';
history.replaceState(null,'',`${location.pathname}?lang=${pl?'pl':'en'}`);
const form=document.querySelector<HTMLFormElement>('#reset-form')!;const status=document.querySelector<HTMLElement>('#reset-status')!;const recovery=document.querySelector<HTMLElement>('#reset-recovery')!;
if(!token || error){recovery.hidden=false;status.textContent=pl?'Link jest nieprawidłowy lub wygasł.':'This link is invalid or expired.';}else{form.hidden=false;const auth=createAuthClient({baseURL:root.dataset.api,fetchOptions:{credentials:'include'}});form.addEventListener('submit',async(event)=>{event.preventDefault();const password=String(new FormData(form).get('password')||'');try{const result=await auth.resetPassword({newPassword:password,token});if(result.error)throw Error();form.hidden=true;status.textContent=pl?'Hasło zostało zmienione. Zaloguj się ponownie.':'Password changed. Please sign in again.';}catch{status.textContent=pl?'Nie udało się zmienić hasła. Link może być nieprawidłowy lub wygasły.':'Unable to reset your password. The link may be invalid or expired.';}});}
</script>
</Layout>

<style>
.reset-page{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);max-width:1180px;gap:0;padding-block:60px 100px}.reset-intro{background:#30463a;color:#f7f5ef;padding:clamp(30px,5vw,60px);min-height:480px;display:flex;flex-direction:column}.reset-kicker,.reset-step{font-size:10px;font-weight:700;letter-spacing:.14em;color:#f1c6aa}.reset-intro h1{font:500 clamp(45px,5.5vw,70px)/1.06 'Playfair Display',serif;letter-spacing:-.04em;margin:55px 0 18px}.reset-intro h1 em{color:#e4b89b;font-weight:400}.reset-intro>p:not(.reset-kicker){line-height:1.7;max-width:340px;color:#e0e9df}.reset-art{display:flex;align-items:center;gap:20px;margin-top:auto;padding-top:40px;color:#e4b89b;font-size:46px}.reset-art i{height:1px;background:#8ca493;width:100px}.reset-panel{background:#e6ece2;padding:clamp(30px,5vw,60px);display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.reset-step{color:#985438}.reset-panel h2{font:500 clamp(32px,3.5vw,47px)/1.12 'Playfair Display',serif;margin:16px 0}.reset-help,.reset-panel #reset-recovery p{line-height:1.7;color:#405448}.reset-panel form{width:100%;display:grid;gap:12px;margin:20px 0}.reset-panel form[hidden],.reset-panel [hidden]{display:none!important}.reset-panel label{font-weight:700;font-size:13px}.reset-panel input{min-height:50px;width:100%;padding:12px;border:1px solid #7c9180;background:#fff;font:inherit}.reset-panel input:focus-visible,.reset-return:focus-visible{outline:3px solid #a35e3e;outline-offset:3px}.reset-panel button{margin-top:4px;width:100%}.reset-panel #reset-status:not(:empty){background:#f6e2d4;color:#713d2b;padding:16px;width:100%;line-height:1.5;font-weight:700}.reset-return{margin-top:22px;font-size:14px;font-weight:700;text-decoration:underline;text-underline-offset:5px}@media(max-width:760px){.reset-page{grid-template-columns:1fr;padding-block:25px 60px}.reset-intro{min-height:0;padding:30px}.reset-intro h1{font-size:44px;margin:28px 0 15px}.reset-art{padding-top:20px}.reset-panel{padding:30px}}
</style>
