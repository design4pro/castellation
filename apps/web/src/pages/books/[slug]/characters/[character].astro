---
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SharePanel from '../../../../components/SharePanel.astro';
import Layout from '../../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug, character: characterSlug } = Astro.params;
const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const volume = Astro.url.searchParams.get('volume');
const chapter = Astro.url.searchParams.get('chapter');
const hasProgress = volume !== null || chapter !== null;
const progressQuery = hasProgress ? `?volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
const linkProgress = hasProgress ? `&volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
let book, character, story, progress;
let status = 200;
try {
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}${progressQuery}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 || response.status === 400 ? response.status : 503;
  else { const result = await response.json(); book = result.book; story = result.story; progress = result.progress; character = story.characters.find((item) => item.slug === characterSlug); if (!character) status = 404; }
} catch { status = 503; }
Astro.response.status = status;
const description = character?.descriptions?.at(-1)?.text;
const portrait = character?.portraits?.at(-1);
const connections = character ? story.relations.filter((relation) => relation.from === character.id || relation.to === character.id).map((relation) => ({ ...relation, fromCharacter: story.characters.find((item) => item.id === relation.from), toCharacter: story.characters.find((item) => item.id === relation.to) })).filter((relation) => relation.fromCharacter && relation.toCharacter) : [];
const pageTitle = character ? `${character.name} - ${book.title} - Castellation` : (pl ? 'Bohater - Castellation' : 'Character - Castellation');
const metaDescription = character ? `${character.name} - ${book.title}. ${hasProgress ? (pl ? 'Profil postaci z wybranym postępem czytania.' : 'Character profile at a selected reading position.') : (description || (pl ? 'Poznaj bohatera i jego relacje.' : 'Explore this character and their connections.'))}` : '';
---
<Layout title={pageTitle} description={metaDescription} lang={lang} noindex={hasProgress || !character}>
  <SiteHeader lang={lang} />
  <main class="wrap character-page">{character ? <><Breadcrumbs lang={lang} structured={!hasProgress} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: pl ? 'Bohaterowie' : 'Characters', href: `/books/${encodeURIComponent(slug || '')}/characters?lang=${lang}` }, { label: character.name }]} />
    <div class="reading-context"><span>✳ {pl ? 'TWÓJ ZAKRES CZYTANIA' : 'YOUR READING CONTEXT'}</span><strong>{pl ? 'Tom' : 'Volume'} {progress.volume} · {pl ? 'Rozdział' : 'Chapter'} {progress.chapter}</strong><a href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{pl ? 'Wróć do mapy' : 'Back to the map'} ↗</a></div><section class="character-hero"><div class="character-copy"><p class="eyebrow">✦ {pl ? 'BOHATER HISTORII' : 'A CHARACTER IN THE STORY'}</p><p class="character-book">{book.title} <span> / </span> {book.author}</p><h1>{character.name}</h1>{description && <p class="character-description">{description}</p>}<a class="primary-button" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{pl ? 'Odkryj mapę historii' : 'Explore the story map'} <span aria-hidden="true">↗</span></a></div><div class="character-art">{portrait?.url ? <img src={portrait.url} alt={character.name} /> : <span aria-hidden="true">{character.name.slice(0,1)}</span>}<small>✳ {pl ? 'BOHATER' : 'CHARACTER'}</small></div></section>
    <section class="character-connections" aria-labelledby="connections-heading"><div class="collection-bar"><h2 id="connections-heading">{pl ? 'Powiązania' : 'Connections'}</h2><span>{String(connections.length).padStart(2, '0')}</span></div><p class="connections-intro">{pl ? 'Relacje widoczne na tym etapie czytania.' : 'Connections visible at this point in the story.'}</p>{connections.length ? <ul class="connection-list">{connections.map((relation) => <li><span class="connection-subject">{relation.from === character.id ? relation.fromCharacter.name : <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(relation.fromCharacter.slug)}?lang=${lang}${linkProgress}`}>{relation.fromCharacter.name} ↗</a>}</span><span class="connection-label"><a href={`/books/${encodeURIComponent(slug || "")}/relations/${encodeURIComponent(relation.id)}?lang=${lang}${linkProgress}`}>{relation.label} <span aria-hidden="true">→</span></a></span><span class="connection-target">{relation.to === character.id ? relation.toCharacter.name : <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(relation.toCharacter.slug)}?lang=${lang}${linkProgress}`}>{relation.toCharacter.name} ↗</a>}</span></li>)}</ul> : <p class="empty-state">{pl ? 'Nie ma jeszcze widocznych powiązań.' : 'No connections are visible yet.'}</p>}</section>
    <SharePanel lang={lang} throughChapter={true} url={new URL(`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(characterSlug || '')}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`, Astro.url.origin).href} />
  </> : <h1>{status === 503 ? (pl ? 'Bohater jest chwilowo niedostępny' : 'Character temporarily unavailable') : (pl ? 'Nie znaleziono postaci' : 'Character not found')}</h1>}</main>
  <footer class="wrap footer"><a class="brand" href={`/?lang=${lang}`}>✳ castellation<span class="brand-dot">.</span></a><p>{pl ? 'Historie są lepsze, gdy widzisz ich powiązania.' : 'Stories are better when you see the connections.'}</p><span>© {new Date().getFullYear()} CASTELLATION</span></footer>
</Layout>
