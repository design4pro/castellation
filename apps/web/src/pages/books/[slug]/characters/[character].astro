---
import Layout from '../../../../layouts/Layout.astro';
const { slug, character: characterSlug } = Astro.params;
const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const volume = Astro.url.searchParams.get('volume');
const chapter = Astro.url.searchParams.get('chapter');
const hasProgress = volume !== null || chapter !== null;
const progressQuery = hasProgress ? `?volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
let book, character;
if (api && slug && characterSlug) {
  try {
    const response = await fetch(`${api}/api/books/${encodeURIComponent(slug)}${progressQuery}`);
    if (response.ok) { const result = await response.json(); book = result.book; character = result.story.characters.find((item) => item.slug === characterSlug); }
  } catch { /* Render an unavailable state when the API cannot be reached. */ }
}
if (!character) Astro.response.status = 404;
const description = character?.descriptions?.at(-1)?.text;
const portrait = character?.portraits?.at(-1);
---
<Layout title={`${character?.name || 'Character'} - Castellation`} lang={lang} noindex={hasProgress}>
  <header class="site-header wrap"><a class="brand" href={`/?lang=${lang}`}>✳ castellation<span class="brand-dot">.</span></a></header>
  <main class="wrap book-page"><a class="back" href={`/books/${slug}?lang=${lang}`}>← {book?.title || (lang === 'pl' ? 'Książka' : 'Book')}</a>{character ? <><p class="eyebrow">{lang === 'pl' ? 'BOHATER' : 'CHARACTER'}</p><h1>{character.name}</h1><p class="hero-intro">{description}</p>{portrait?.url ? <img class="character-full-portrait" src={portrait.url} alt={character.name} /> : <div class="character-placeholder" aria-hidden="true">{character.name.slice(0,1)}</div>}</> : <h1>{lang === 'pl' ? 'Nie znaleziono postaci' : 'Character not found'}</h1>}</main>
</Layout>
