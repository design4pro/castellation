---
import SiteFooter from '../../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SharePanel from '../../../../components/SharePanel.astro';
import Layout from '../../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug, character: characterSlug } = Astro.params;
const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const volume = Astro.url.searchParams.get('volume');
const chapter = Astro.url.searchParams.get('chapter');
const hasProgress = volume !== null || chapter !== null;
const progressQuery = hasProgress ? `?volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
const linkProgress = hasProgress ? `&volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
let book, character, story, progress;
let status = 200;
try {
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}${progressQuery}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 || response.status === 400 ? response.status : 503;
  else { const result = await response.json(); book = result.book; story = result.story; progress = result.progress; character = story.characters.find((item) => item.slug === characterSlug); if (!character) status = 404; }
} catch { status = 503; }
Astro.response.status = status;
const description = character?.descriptions?.at(-1)?.text;
const portrait = character?.portraits?.at(-1);
const connections = character ? story.relations.filter((relation) => relation.from === character.id || relation.to === character.id).map((relation) => ({ ...relation, fromCharacter: story.characters.find((item) => item.id === relation.from), toCharacter: story.characters.find((item) => item.id === relation.to) })).filter((relation) => relation.fromCharacter && relation.toCharacter) : [];
const otherCharacters = character ? story.characters.filter((item) => item.id !== character.id) : [];
const pageTitle = character ? `${character.name} - ${book.title} - Castellation` : (pl ? 'Bohater - Castellation' : 'Character - Castellation');
const metaDescription = character ? `${character.name} - ${book.title}. ${hasProgress ? (pl ? 'Profil postaci z wybranym postępem czytania.' : 'Character profile at a selected reading position.') : (description || (pl ? 'Poznaj bohatera i jego relacje.' : 'Explore this character and their connections.'))}` : '';
---
<Layout title={pageTitle} description={metaDescription} lang={lang} noindex={hasProgress || !character}>
  <SiteHeader lang={lang} />
  <main class="wrap character-page">{character ? <><Breadcrumbs lang={lang} structured={!hasProgress} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: pl ? 'Bohaterowie' : 'Characters', href: `/books/${encodeURIComponent(slug || '')}/characters?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}` }, { label: character.name }]} />
    <div class="reading-context"><span>✳ {pl ? 'TWÓJ ZAKRES CZYTANIA' : 'YOUR READING CONTEXT'}</span><strong>{pl ? 'Tom' : 'Volume'} {progress.volume} · {pl ? 'Rozdział' : 'Chapter'} {progress.chapter}</strong><a href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{pl ? 'Wróć do mapy' : 'Back to the map'} ↗</a></div><section class="character-hero"><div class="character-copy"><p class="eyebrow">✦ {pl ? 'BOHATER HISTORII' : 'A CHARACTER IN THE STORY'}</p><p class="character-book">{book.title} <span> / </span> {book.author}</p><h1>{character.name}</h1>{description && <p class="character-description">{description}</p>}<a class="primary-button" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{pl ? 'Odkryj mapę historii' : 'Explore the story map'} <span aria-hidden="true">↗</span></a></div>{connections.length ? <aside class="character-trail" aria-labelledby="character-trail-title"><div class="character-trail-heading"><div><p>{pl ? 'ODKRYWAJ DALEJ' : 'KEEP EXPLORING'}</p><h2 id="character-trail-title">{pl ? 'Ślady powiązań' : 'Follow the connections'}</h2></div><span class="character-trail-avatar" aria-hidden="true">{portrait?.url ? <img src={portrait.url} alt="" /> : character.name.slice(0, 1)}</span></div><p class="character-trail-context">{pl ? 'Relacje widoczne do tomu' : 'Connections visible through volume'} {progress.volume}, {pl ? 'rozdziału' : 'chapter'} {progress.chapter}.</p><ul>{connections.slice(0, 3).map((relation) => <li><div class="character-trail-pair"><span>{relation.fromCharacter.name}</span><span aria-hidden="true">→</span><span>{relation.toCharacter.name}</span></div><div class="character-trail-links"><a href={`/books/${encodeURIComponent(slug || '')}/relations/${encodeURIComponent(relation.id)}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{relation.label} ↗</a>{relation.from !== relation.to && <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(relation.from === character.id ? relation.toCharacter.slug : relation.fromCharacter.slug)}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{pl ? 'Poznaj' : 'Meet'} {relation.from === character.id ? relation.toCharacter.name : relation.fromCharacter.name} ↗</a>}</div></li>)}</ul>{connections.length > 3 && <a class="character-trail-all" href="#connections-heading">{pl ? 'Zobacz wszystkie powiązania' : 'See all connections'} ↗</a>}</aside> : <div class="character-art">{portrait?.url ? <img src={portrait.url} alt={character.name} /> : <span aria-hidden="true">{character.name.slice(0,1)}</span>}<small>✳ {pl ? 'BOHATER' : 'CHARACTER'}</small></div>}</section>
    {otherCharacters.length > 0 && <nav class="character-cast" aria-labelledby="character-cast-title"><div class="character-cast-intro"><p class="eyebrow">✦ {pl ? 'Z TEJ SAMEJ HISTORII' : 'FROM THE SAME STORY'}</p><h2 id="character-cast-title">{pl ? 'Kogo jeszcze znasz?' : 'Who else have you met?'}</h2><p>{pl ? 'Bohaterowie dostępni do wybranego rozdziału.' : 'Characters available through your selected chapter.'}</p><a href={`/books/${encodeURIComponent(slug || '')}/characters?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{pl ? 'Zobacz całą obsadę' : 'See the full cast'} ↗</a></div><ul>{otherCharacters.map((item) => <li><a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(item.slug)}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}><span aria-hidden="true">{item.name.slice(0, 1)}</span><strong>{item.name}</strong><small>{pl ? 'Otwórz profil' : 'Open profile'} ↗</small></a></li>)}</ul></nav>}
    <section class="character-connections" aria-labelledby="connections-heading"><div class="collection-bar"><h2 id="connections-heading">{pl ? 'Powiązania' : 'Connections'}</h2><span>{String(connections.length).padStart(2, '0')}</span></div><p class="connections-intro">{pl ? 'Relacje widoczne na tym etapie czytania.' : 'Connections visible at this point in the story.'}</p>{connections.length ? <ul class="connection-list">{connections.map((relation) => <li><span class="connection-subject">{relation.from === character.id ? relation.fromCharacter.name : <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(relation.fromCharacter.slug)}?lang=${lang}${linkProgress}`}>{relation.fromCharacter.name} ↗</a>}</span><span class="connection-label"><a href={`/books/${encodeURIComponent(slug || "")}/relations/${encodeURIComponent(relation.id)}?lang=${lang}${linkProgress}`}>{relation.label} <span aria-hidden="true">→</span></a></span><span class="connection-target">{relation.to === character.id ? relation.toCharacter.name : <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(relation.toCharacter.slug)}?lang=${lang}${linkProgress}`}>{relation.toCharacter.name} ↗</a>}</span></li>)}</ul> : <p class="empty-state">{pl ? 'Nie ma jeszcze widocznych powiązań.' : 'No connections are visible yet.'}</p>}</section>
    <SharePanel lang={lang} throughChapter={true} url={new URL(`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(characterSlug || '')}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`, Astro.url.origin).href} />
  </> : <h1>{status === 503 ? (pl ? 'Bohater jest chwilowo niedostępny' : 'Character temporarily unavailable') : (pl ? 'Nie znaleziono postaci' : 'Character not found')}</h1>}</main>
  <SiteFooter lang={lang} />
</Layout>

<style>
.character-trail{background:#263e33;color:#f6f4ed;padding:34px 36px;align-self:stretch;display:flex;flex-direction:column;min-width:0}.character-trail-heading{display:flex;justify-content:space-between;align-items:start;gap:20px}.character-trail-heading p{font-size:10px;letter-spacing:.14em;font-weight:700;color:#e8bea5;margin:0 0 12px}.character-trail-heading h2{font:500 clamp(27px,3vw,38px)/1.1 'Playfair Display',serif;letter-spacing:-.02em;margin:0}.character-trail-avatar{width:58px;height:58px;flex:none;border:1px solid #91aa96;border-radius:50%;display:grid;place-items:center;color:#e8bea5;font:500 28px 'Playfair Display',serif;overflow:hidden}.character-trail-avatar img{width:100%;height:100%;object-fit:cover}.character-trail-context{font-size:12px;line-height:1.6;color:#e1e9df;margin:20px 0 25px}.character-trail ul{list-style:none;padding:0;margin:0}.character-trail li{border-top:1px solid #8aa28e;padding:19px 0}.character-trail-pair{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;font:500 21px/1.25 'Playfair Display',serif;overflow-wrap:anywhere}.character-trail-pair span:nth-child(2){color:#e8bea5;font-family:'DM Sans',sans-serif}.character-trail-links{display:flex;gap:12px 24px;flex-wrap:wrap;margin-top:12px;font-size:12px;font-weight:700}.character-trail-links a,.character-trail-all{text-decoration:underline;text-underline-offset:4px}.character-trail-links a:hover,.character-trail-all:hover{color:#f1c2a5}.character-trail a:focus-visible{outline:3px solid #f1c2a5;outline-offset:4px}.character-trail-all{font-size:12px;font-weight:700;margin-top:auto;padding-top:12px}@media(max-width:760px){.character-trail{padding:26px 24px}.character-trail-heading h2{font-size:30px}.character-trail-avatar{width:50px;height:50px}.character-trail-pair{font-size:20px}}
</style>

<style>.character-cast{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(0,1.2fr);gap:35px;background:#e5ece2;padding:clamp(24px,4vw,40px);margin:38px 0}.character-cast-intro h2{font:500 clamp(28px,3vw,39px)/1.15 'Playfair Display',serif;margin:16px 0}.character-cast-intro>p:not(.eyebrow){color:#405448;line-height:1.6;font-size:14px}.character-cast-intro>a{display:inline-block;margin-top:12px;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:4px}.character-cast ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.character-cast li{min-width:0}.character-cast li a{min-height:145px;background:#334b3d;color:#f6f4ed;padding:18px;display:flex;flex-direction:column;align-items:start;gap:10px;text-decoration:none}.character-cast li a>span{font:500 28px/1 'Playfair Display',serif;color:#f0c3a5}.character-cast li strong{font:500 21px/1.2 'Playfair Display',serif;overflow-wrap:anywhere}.character-cast li small{font-size:11px;font-weight:700;margin-top:auto;color:#f0c3a5}.character-cast a:hover{text-decoration:underline;text-underline-offset:4px}.character-cast a:focus-visible{outline:3px solid #a35e3e;outline-offset:3px}@media(max-width:760px){.character-cast{grid-template-columns:1fr;gap:20px}.character-cast li a{min-height:130px}}@media(max-width:380px){.character-cast ul{grid-template-columns:1fr}}</style>
