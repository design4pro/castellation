---
import SiteFooter from '../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug } = Astro.params;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const volume = Astro.url.searchParams.get('volume'), chapter = Astro.url.searchParams.get('chapter');
const hasProgress = volume !== null || chapter !== null;
const query = hasProgress ? `?volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
let book, progress, connections = [];
let status = 200;
try {
  const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}${query}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 || response.status === 400 ? 404 : 503;
  else {
    const data = await response.json(); book = data.book; progress = data.progress;
    const characters = new Map(data.story.characters.map((character) => [character.id, character]));
    connections = data.story.relations.map((relation) => ({ ...relation, fromCharacter: characters.get(relation.from), toCharacter: characters.get(relation.to) })).filter((relation) => relation.fromCharacter && relation.toCharacter);
    if (!connections.length) status = 404;
  }
} catch { status = 503; }
Astro.response.status = status;
const groups = status === 200 ? book.positions.map((position) => ({ ...position, connections: connections.filter((connection) => connection.volume === position.volume && connection.chapter === position.chapter) })).filter((group) => group.connections.length) : [];
const title = status === 200 ? (pl ? `Relacje bohaterów - ${book.title} - Castellation` : `${book.title} character connections - Castellation`) : (pl ? 'Relacje bohaterów - Castellation' : 'Character connections - Castellation');
const description = status === 200 ? (pl ? `Poznaj relacje bohaterów na początku ${book.title} i odkrywaj ich profile.` : `Explore the character connections at the beginning of ${book.title} and discover their profiles.`) : '';
---
<Layout lang={lang} title={title} description={description} noindex={status !== 200 || hasProgress}>
  <SiteHeader lang={lang} />
  <main class="wrap relations-page">{status === 200 ? <><Breadcrumbs lang={lang} structured={true} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: pl ? 'Powiązania' : 'Connections' }]} /><div class="relations-heading"><div><p class="eyebrow">✦ {pl ? 'POŁĄCZENIA W HISTORII' : 'THE THREADS BETWEEN CHARACTERS'}</p><h1>{pl ? 'Historie łączą' : 'Stories connect'}<br /><em>{pl ? 'bohaterów.' : 'characters.'}</em></h1><p>{pl ? 'Poznaj powiązania w wybranym zakresie' : 'Explore the connections within your reading boundary in'} <strong>{book.title}</strong>.</p></div><a class="relations-feature" href={`/books/${encodeURIComponent(slug || '')}/relations/${encodeURIComponent(connections[0].id)}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}><span class="relations-feature-kicker">✦ {pl ? 'WYBRANE POWIĄZANIE' : 'FEATURED CONNECTION'}</span><span class="relations-feature-from">{connections[0].fromCharacter.name}</span><span class="relations-feature-direction">{connections[0].label} <span aria-hidden="true">→</span></span><span class="relations-feature-to">{connections[0].toCharacter.name}</span><span class="relations-feature-action">{pl ? 'Poznaj tę relację' : 'Explore this connection'} <span aria-hidden="true">↗</span></span></a></div><p class="relations-scope">✦ {pl ? 'Informacje do' : 'Details through'} {pl ? 'tomu' : 'volume'} {progress.volume}, {pl ? 'rozdziału' : 'chapter'} {progress.chapter}.</p><section aria-labelledby="relations-list-title"><div class="collection-bar"><h2 id="relations-list-title">{pl ? 'Powiązania w kolejności rozdziałów' : 'Connections by chapter'}</h2><span>{String(connections.length).padStart(2, '0')}</span></div><div class="relations-chronology">{groups.map((group) => <section class="relations-chapter"><div class="relations-chapter-heading"><span>{pl ? 'TOM' : 'VOLUME'} {group.volume}</span><h3>{pl ? 'Rozdział' : 'Chapter'} {group.chapter}</h3><a href={`/books/${encodeURIComponent(slug || '')}/chapters/${group.volume}-${group.chapter}?lang=${lang}`}>{pl ? 'Zobacz rozdział' : 'Explore chapter'} ↗</a></div><ol class="relations-list">{group.connections.map((relation, index) => <li><span class="relations-number">{String(index + 1).padStart(2, '0')}</span><div class="relations-pair"><a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(relation.fromCharacter.slug)}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}><strong>{relation.fromCharacter.name}</strong><span>{relation.fromCharacter.descriptions.at(-1)?.text}</span></a><p class="relations-direction"><a href={`/books/${encodeURIComponent(slug || "")}/relations/${encodeURIComponent(relation.id)}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{relation.label} <span aria-hidden="true">→</span></a></p><a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(relation.toCharacter.slug)}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}><strong>{relation.toCharacter.name}</strong><span>{relation.toCharacter.descriptions.at(-1)?.text}</span></a></div></li>)}</ol></section>)}</div></section><div class="opening-next"><p>{pl ? 'Zobacz te powiązania na mapie w wybranym rozdziale.' : 'See these connections on the map at your selected chapter.'}</p><a class="primary-button" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{pl ? 'Otwórz mapę' : 'Open the map'} ↗</a></div></> : <h1>{status === 503 ? (pl ? 'Historia jest chwilowo niedostępna' : 'Story temporarily unavailable') : (pl ? 'Nie znaleziono powiązań' : 'Connections not found')}</h1>}</main>
  <SiteFooter lang={lang} />
</Layout>

<style>
.relations-feature{background:#334b3d;color:#f6f4ed;padding:32px;min-height:290px;display:flex;flex-direction:column;align-items:start;position:relative;overflow:hidden}.relations-feature::after{content:'✳';position:absolute;right:22px;top:10px;font-size:95px;line-height:1;color:#789181;opacity:.45;pointer-events:none}.relations-feature-kicker{font-size:10px;letter-spacing:.14em;font-weight:700;color:#f0c3a5}.relations-feature-from,.relations-feature-to{font:500 clamp(26px,3vw,38px)/1.1 'Playfair Display',serif;max-width:85%;overflow-wrap:anywhere}.relations-feature-from{margin-top:24px}.relations-feature-direction{color:#f0c3a5;font-size:13px;font-weight:700;margin:14px 0}.relations-feature-direction span{font-size:22px;margin-left:8px}.relations-feature-action{display:flex;justify-content:space-between;gap:25px;width:100%;border-top:1px solid #789181;margin-top:auto;padding-top:16px;font-size:13px;font-weight:700}.relations-feature:hover .relations-feature-action{text-decoration:underline;text-underline-offset:4px}.relations-feature:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}@media(max-width:760px){.relations-feature{min-height:250px;padding:25px}.relations-feature::after{font-size:70px}}
</style>

<style>.relations-chronology{display:grid;gap:36px;margin-top:25px}.relations-chapter{display:grid;grid-template-columns:210px minmax(0,1fr);background:#e6ede3}.relations-chapter-heading{background:#334b3d;color:#f6f4ed;padding:25px;display:flex;flex-direction:column;align-items:start;gap:14px}.relations-chapter-heading>span{font-size:10px;letter-spacing:.12em;font-weight:700;color:#f0c3a5}.relations-chapter-heading h3{font:500 29px/1.15 'Playfair Display',serif;margin:0}.relations-chapter-heading a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:4px;margin-top:auto}.relations-chapter-heading a:focus-visible{outline:3px solid #f0c3a5;outline-offset:4px}.relations-chapter .relations-list{margin:0;padding:0 25px}.relations-chapter .relations-list li:last-child{border-bottom:0}@media(max-width:760px){.relations-chapter{grid-template-columns:1fr}.relations-chapter-heading{padding:20px}.relations-chapter-heading a{margin-top:0}.relations-chapter .relations-list{padding:0 20px}}</style>
