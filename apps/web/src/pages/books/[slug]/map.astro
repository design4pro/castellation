---
import '../../../styles/tailwind.css';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const slug = Astro.params.slug;
const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
let book, story;
let status = 200;
try {
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 ? 404 : 503;
  else { const data = await response.json(); book = data.book; story = data.story; }
} catch { status = 503; }
Astro.response.status = status;
const title = book?.title || 'Book';
const pl = lang === 'pl';
---
<Layout variant="relationship-atlas" title={book ? (pl ? `Mapa bohaterów - ${title} - Castellation` : `${title} character map - Castellation`) : (pl ? 'Mapa bohaterów - Castellation' : 'Character map - Castellation')} lang={lang} description={book ? (pl ? `Odkrywaj mapę bohaterów ${title} i ich relacje według przeczytanego rozdziału.` : `Explore the character map of ${title} and follow connections by chapter.`) : ''} noindex={!book || Astro.url.searchParams.has('volume') || Astro.url.searchParams.has('chapter')}>
  <SiteHeader lang={lang} variant="relationship-atlas" />
  <main class="wrap book-page map-page">{book ? <><Breadcrumbs lang={lang} structured={!Astro.url.searchParams.has('volume') && !Astro.url.searchParams.has('chapter')} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: pl ? 'Mapa bohaterów' : 'Character map' }]} /><div class="map-page-intro"><p class="eyebrow">✦ {pl ? 'TWOJA MAPA OPOWIEŚCI' : 'YOUR STORY MAP'}</p><h1 id="book-title">{title}</h1><p id="book-author">{book.author}</p><p>{pl ? 'Wybierz przeczytany rozdział i odkrywaj powiązania bohaterów we własnym tempie.' : 'Choose the chapter you have read and explore character connections at your own pace.'}</p></div><div class="book-toolbar" id="story-map"><div><h2>{pl ? 'Powiązania bohaterów' : 'Character connections'}</h2><p class="muted">{pl ? 'Przeciągnij, aby przesunąć. Zsuń palce, aby przybliżyć.' : 'Drag to move. Pinch to zoom.'}</p></div><div class="map-boundary"><div class="map-boundary-copy"><span aria-hidden="true">✳</span><div><strong>{pl ? 'Twoja granica lektury' : 'Your reading boundary'}</strong><p id="map-boundary-help">{pl ? 'Wybierz ostatni przeczytany rozdział. To ogranicza ryzyko spoilerów, ale nie daje gwarancji.' : 'Choose the last chapter you have read. This reduces spoiler risk but is not a guarantee.'} <a href={`/our-method?lang=${lang}#reading-boundary`}>{pl ? 'Jak to działa' : 'How it works'} ↗</a></p></div></div><label for="progress">{pl ? 'Przeczytano do' : 'Read up to'} <select id="progress" aria-describedby="map-boundary-help"></select></label></div></div>
  <div id="story-app" data-state="loading" data-api={api} data-slug={slug} data-lang={lang} data-positions={JSON.stringify(book.positions)}><p id="map-selection-status" class="atlas-sr-only" role="status"></p><div class="map-stage"><div class="graph" id="graph" aria-label={pl ? 'Interaktywny graf powiązań' : 'Interactive relationship graph'}><div class="atlas-graph-heading"><span>{pl ? 'Żywy atlas' : 'A living atlas'}</span><a href="#map-connections-heading">{pl ? 'Czytaj powiązania ↓' : 'Read the connections ↓'}</a></div><div class="graph-scroll" tabindex="0" aria-label={pl ? 'Przewijana mapa bohaterów' : 'Scrollable character map'}><svg id="graph-svg" viewBox="0 0 800 520" role="group" aria-label={pl ? 'Mapa bohaterów' : 'Character map'}></svg></div><div class="graph-hint">✳ {pl ? 'DOTKNIJ POSTACI' : 'TAP A CHARACTER'}</div><div class="zoom-controls"><button id="zoom-in" aria-label={pl ? "Powiększ" : "Zoom in"}>+</button><button id="zoom-out" aria-label={pl ? "Pomniejsz" : "Zoom out"}>−</button><button id="zoom-reset" aria-label={pl ? "Przywróć widok" : "Reset zoom"}>⌂</button></div></div><div class="map-stage-rail"><div id="map-detail-prompt" class="map-detail-prompt" hidden><strong>{pl ? 'Odkryj mapę' : 'Explore the map'}</strong><p>{pl ? 'Wybierz postać lub połączenie, aby zobaczyć szczegóły.' : 'Select a character or connection to see its details.'}</p></div><aside id="map-detail" class="map-detail" aria-labelledby="map-detail-name" hidden><div class="map-detail-mark" aria-hidden="true">✳</div><div class="map-detail-content"><p class="eyebrow">{pl ? 'WYBRANA POSTAĆ' : 'SELECTED CHARACTER'}</p><h2 id="map-detail-name" tabindex="-1"></h2><p id="map-detail-description"></p><a id="map-detail-link" class="map-detail-link">{pl ? 'Otwórz profil postaci' : 'Open character profile'} ↗</a></div><button id="map-detail-close" type="button" aria-label={pl ? 'Zamknij szczegóły' : 'Close details'}>×</button></aside>  <div id="chapter-controls" class="chapter-controls" hidden aria-label={pl ? 'Nawigacja po rozdziałach' : 'Chapter navigation'}><button id="chapter-previous" type="button" aria-disabled="true">← {pl ? 'Poprzedni' : 'Previous'}</button><div class="chapter-position"><span class="eyebrow">{pl ? 'TWÓJ PUNKT W HISTORII' : 'YOUR PLACE IN THE STORY'}</span><strong id="chapter-position-label" aria-live="polite"></strong><span class="chapter-track" aria-hidden="true"><span id="chapter-track-fill"></span></span></div><button id="chapter-next" type="button" aria-disabled="true">{pl ? 'Następny' : 'Next'} →</button></div><div class="progress-memory" id="progress-memory" hidden><span aria-hidden="true">✳</span><p id="progress-memory-text" role="status"></p><a href={`/account?lang=${lang}`}>{pl ? 'Konto i synchronizacja' : 'Account and sync'} ↗</a></div></div></div><noscript><p class="map-no-script">{pl ? 'Mapa wymaga JavaScript. Otwórz spis bohaterów, aby przeglądać profile.' : 'The map requires JavaScript. Open the character list to browse profiles.'}</p><style>.map-load-state { display: none; }</style> <a href={`/books/${encodeURIComponent(slug || '')}/characters?lang=${lang}`}>{pl ? 'Zobacz bohaterów' : 'See the characters'} ↗</a></noscript><div class="map-load-state"><p id="status" role="status">{pl ? 'Przygotowujemy mapę...' : 'Preparing your map...'}</p><button id="map-retry" type="button" hidden>{pl ? 'Spróbuj ponownie' : 'Try again'}</button></div><section class="chapter-discoveries" aria-labelledby="chapter-discoveries-heading"><div class="chapter-discoveries-intro"><p class="eyebrow">✦ {pl ? 'NOWY FRAGMENT HISTORII' : 'A NEW PART OF THE STORY'}</p><h2 id="chapter-discoveries-heading">{pl ? 'W tym rozdziale' : 'In this chapter'}</h2><p id="chapter-discoveries-position" role="status"></p></div><div id="chapter-discoveries-list" class="chapter-discoveries-list"></div></section><section class="map-share tw:my-12 tw:grid tw:gap-8 tw:bg-[#263e33] tw:p-6 tw:text-[#f6f4ed] tw:md:grid-cols-[1.2fr_1fr] tw:md:items-end tw:md:gap-12 tw:md:p-12" id="map-share" aria-labelledby="map-share-title" hidden><div><p class="tw:mb-5 tw:text-xs tw:font-bold tw:tracking-[0.16em] tw:text-[#f0c3a5]">✦ {pl ? 'CZYTAJCIE RAZEM' : 'READ TOGETHER'}</p><h2 id="map-share-title" class="tw:my-0 tw:font-['Playfair_Display',serif] tw:text-4xl tw:leading-[1.08] tw:tracking-tight tw:md:text-5xl">{pl ? 'Podziel się historią' : 'Share the story'}<br /><em class="tw:font-normal tw:text-[#f0c3a5]">{pl ? 'na tym etapie.' : 'at your chapter.'}</em></h2><p class="tw:mt-5 tw:max-w-md tw:leading-7 tw:text-[#e1e9df]">{pl ? 'Odbiorca zobaczy mapę do wskazanego rozdziału. Link nie zawiera Twoich notatek ani danych konta.' : 'The recipient will see the map through this chapter. The link does not include your notes or account details.'}</p></div><div class="tw:min-w-0 tw:border tw:border-[#789181] tw:bg-[#f6f4ed] tw:p-5 tw:text-[#27352f] tw:md:p-7"><p class="tw:mt-0 tw:mb-5 tw:border-b tw:border-[#b5c4b4] tw:pb-4 tw:font-['Playfair_Display',serif] tw:text-2xl" id="map-share-boundary"></p><label class="tw:mb-2 tw:block tw:text-xs tw:font-bold" for="map-share-url">{pl ? 'Link do mapy' : 'Map link'}</label><div class="tw:flex tw:min-w-0 tw:flex-col tw:gap-2 tw:sm:flex-row"><input class="tw:min-h-12 tw:min-w-0 tw:flex-1 tw:border tw:border-[#8da293] tw:bg-white tw:px-3 tw:text-sm" id="map-share-url" type="text" readonly /><button class="tw:min-h-12 tw:cursor-pointer tw:border-0 tw:bg-[#334b3d] tw:px-5 tw:font-bold tw:text-white tw:hover:bg-[#496653] tw:focus-visible:outline-2 tw:focus-visible:outline-offset-2 tw:focus-visible:outline-[#a35e3e]" id="map-share-copy" type="button">{pl ? 'Kopiuj link' : 'Copy link'}</button></div><p class="tw:mt-3 tw:min-h-5 tw:text-xs tw:leading-5" id="map-share-status" role="status"></p></div></section><section class="map-connections" aria-labelledby="map-connections-heading"><div class="map-connections-head"><div><p class="eyebrow">✦ {pl ? 'ODCZYTAJ MAPĘ' : 'READ THE MAP'}</p><h2 id="map-connections-heading">{pl ? 'Powiązania w skrócie' : 'Connections at a glance'}</h2></div><div><p id="map-summary" aria-live="polite"></p><a id="reading-sheet-link" class="reading-sheet-link" hidden>{pl ? 'Karta czytelnika do druku' : 'Printable reading sheet'} ↗</a></div></div><ul id="map-connections-list" class="map-connections-list"></ul></section><section class="story-columns"><div><h2>{pl ? 'Bohaterowie i relacje' : 'Characters & connections'}</h2><div id="character-list"></div></div><div><h2>{pl ? 'Oś wydarzeń' : 'Story timeline'}</h2><div id="event-list"></div></div></section></div></> : <h1>{status === 404 ? (pl ? 'Nie znaleziono książki' : 'Book not found') : (pl ? 'Książka jest chwilowo niedostępna' : 'Book temporarily unavailable')}</h1>}</main>
  {book && <script src="../../../scripts/story.js"></script>}
  <SiteFooter lang={lang} variant="relationship-atlas" />
</Layout>
