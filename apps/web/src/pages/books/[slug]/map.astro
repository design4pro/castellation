---
import '../../../styles/tailwind.css';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const slug = Astro.params.slug;
const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
let book, story;
let status = 200;
try {
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 ? 404 : 503;
  else { const data = await response.json(); book = data.book; story = data.story; }
} catch { status = 503; }
Astro.response.status = status;
const title = book?.title || 'Book';
const pl = lang === 'pl';
---
<Layout title={book ? (pl ? `Mapa bohaterów - ${title} - Castellation` : `${title} character map - Castellation`) : (pl ? 'Mapa bohaterów - Castellation' : 'Character map - Castellation')} lang={lang} description={book ? (pl ? `Odkrywaj mapę bohaterów ${title} i ich relacje według przeczytanego rozdziału.` : `Explore the character map of ${title} and follow connections by chapter.`) : ''} noindex={!book || Astro.url.searchParams.has('volume') || Astro.url.searchParams.has('chapter')}>
  <SiteHeader lang={lang} />
  <main class="wrap book-page map-page">{book ? <><Breadcrumbs lang={lang} structured={!Astro.url.searchParams.has('volume') && !Astro.url.searchParams.has('chapter')} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: pl ? 'Mapa bohaterów' : 'Character map' }]} /><div class="map-page-intro"><p class="eyebrow">✦ {pl ? 'TWOJA MAPA OPOWIEŚCI' : 'YOUR STORY MAP'}</p><h1 id="book-title">{title}</h1><p id="book-author">{book.author}</p><p>{pl ? 'Wybierz przeczytany rozdział i odkrywaj powiązania bohaterów we własnym tempie.' : 'Choose the chapter you have read and explore character connections at your own pace.'}</p></div><div class="book-toolbar" id="story-map"><div><h2>{pl ? 'Powiązania bohaterów' : 'Character connections'}</h2><p class="muted">{pl ? 'Przeciągnij, aby przesunąć. Zsuń palce, aby przybliżyć.' : 'Drag to move. Pinch to zoom.'}</p></div><div class="map-boundary"><div class="map-boundary-copy"><span aria-hidden="true">✳</span><div><strong>{pl ? 'Twoja granica lektury' : 'Your reading boundary'}</strong><p id="map-boundary-help">{pl ? 'Wybierz ostatni przeczytany rozdział. To ogranicza ryzyko spoilerów, ale nie daje gwarancji.' : 'Choose the last chapter you have read. This reduces spoiler risk but is not a guarantee.'} <a href={`/our-method?lang=${lang}#reading-boundary`}>{pl ? 'Jak to działa' : 'How it works'} ↗</a></p></div></div><label for="progress">{pl ? 'Przeczytano do' : 'Read up to'} <select id="progress" aria-describedby="map-boundary-help"></select></label></div></div>
  <div id="story-app" data-state="loading" data-api={api} data-slug={slug} data-lang={lang} data-positions={JSON.stringify(book.positions)}><div class="map-stage"><div class="graph" id="graph" aria-label={pl ? 'Interaktywny graf powiązań' : 'Interactive relationship graph'}><svg id="graph-svg" viewBox="0 0 800 520" role="group" aria-label={pl ? 'Mapa bohaterów' : 'Character map'}></svg><div class="graph-hint">✳ {pl ? 'DOTKNIJ POSTACI' : 'TAP A CHARACTER'}</div><div class="zoom-controls"><button id="zoom-in" aria-label={pl ? "Powiększ" : "Zoom in"}>+</button><button id="zoom-out" aria-label={pl ? "Pomniejsz" : "Zoom out"}>−</button><button id="zoom-reset" aria-label={pl ? "Przywróć widok" : "Reset zoom"}>⌂</button></div></div><div class="map-stage-rail"><div id="map-detail-prompt" class="map-detail-prompt" hidden><strong>{pl ? 'Odkryj mapę' : 'Explore the map'}</strong><p>{pl ? 'Wybierz postać lub połączenie, aby zobaczyć szczegóły.' : 'Select a character or connection to see its details.'}</p></div><aside id="map-detail" class="map-detail" aria-labelledby="map-detail-name" hidden><div class="map-detail-mark" aria-hidden="true">✳</div><div class="map-detail-content"><p class="eyebrow">{pl ? 'WYBRANA POSTAĆ' : 'SELECTED CHARACTER'}</p><h2 id="map-detail-name" tabindex="-1"></h2><p id="map-detail-description"></p><a id="map-detail-link" class="map-detail-link">{pl ? 'Otwórz profil postaci' : 'Open character profile'} ↗</a></div><button id="map-detail-close" type="button" aria-label={pl ? 'Zamknij szczegóły' : 'Close details'}>×</button></aside>  <div id="chapter-controls" class="chapter-controls" hidden aria-label={pl ? 'Nawigacja po rozdziałach' : 'Chapter navigation'}><button id="chapter-previous" type="button" aria-disabled="true">← {pl ? 'Poprzedni' : 'Previous'}</button><div class="chapter-position"><span class="eyebrow">{pl ? 'TWÓJ PUNKT W HISTORII' : 'YOUR PLACE IN THE STORY'}</span><strong id="chapter-position-label" aria-live="polite"></strong><span class="chapter-track" aria-hidden="true"><span id="chapter-track-fill"></span></span></div><button id="chapter-next" type="button" aria-disabled="true">{pl ? 'Następny' : 'Next'} →</button></div><div class="progress-memory" id="progress-memory" hidden><span aria-hidden="true">✳</span><p id="progress-memory-text" role="status"></p><a href={`/account?lang=${lang}`}>{pl ? 'Konto i synchronizacja' : 'Account and sync'} ↗</a></div></div></div><noscript><p class="map-no-script">{pl ? 'Mapa wymaga JavaScript. Otwórz spis bohaterów, aby przeglądać profile.' : 'The map requires JavaScript. Open the character list to browse profiles.'}</p><style>.map-load-state { display: none; }</style> <a href={`/books/${encodeURIComponent(slug || '')}/characters?lang=${lang}`}>{pl ? 'Zobacz bohaterów' : 'See the characters'} ↗</a></noscript><div class="map-load-state"><p id="status" role="status">{pl ? 'Przygotowujemy mapę...' : 'Preparing your map...'}</p><button id="map-retry" type="button" hidden>{pl ? 'Spróbuj ponownie' : 'Try again'}</button></div><section class="chapter-discoveries" aria-labelledby="chapter-discoveries-heading"><div class="chapter-discoveries-intro"><p class="eyebrow">✦ {pl ? 'NOWY FRAGMENT HISTORII' : 'A NEW PART OF THE STORY'}</p><h2 id="chapter-discoveries-heading">{pl ? 'W tym rozdziale' : 'In this chapter'}</h2><p id="chapter-discoveries-position" role="status"></p></div><div id="chapter-discoveries-list" class="chapter-discoveries-list"></div></section><section class="map-share tw:my-12 tw:grid tw:gap-8 tw:bg-[#263e33] tw:p-6 tw:text-[#f6f4ed] tw:md:grid-cols-[1.2fr_1fr] tw:md:items-end tw:md:gap-12 tw:md:p-12" id="map-share" aria-labelledby="map-share-title" hidden><div><p class="tw:mb-5 tw:text-xs tw:font-bold tw:tracking-[0.16em] tw:text-[#f0c3a5]">✦ {pl ? 'CZYTAJCIE RAZEM' : 'READ TOGETHER'}</p><h2 id="map-share-title" class="tw:my-0 tw:font-['Playfair_Display',serif] tw:text-4xl tw:leading-[1.08] tw:tracking-tight tw:md:text-5xl">{pl ? 'Podziel się historią' : 'Share the story'}<br /><em class="tw:font-normal tw:text-[#f0c3a5]">{pl ? 'na tym etapie.' : 'at your chapter.'}</em></h2><p class="tw:mt-5 tw:max-w-md tw:leading-7 tw:text-[#e1e9df]">{pl ? 'Odbiorca zobaczy mapę do wskazanego rozdziału. Link nie zawiera Twoich notatek ani danych konta.' : 'The recipient will see the map through this chapter. The link does not include your notes or account details.'}</p></div><div class="tw:min-w-0 tw:border tw:border-[#789181] tw:bg-[#f6f4ed] tw:p-5 tw:text-[#27352f] tw:md:p-7"><p class="tw:mt-0 tw:mb-5 tw:border-b tw:border-[#b5c4b4] tw:pb-4 tw:font-['Playfair_Display',serif] tw:text-2xl" id="map-share-boundary"></p><label class="tw:mb-2 tw:block tw:text-xs tw:font-bold" for="map-share-url">{pl ? 'Link do mapy' : 'Map link'}</label><div class="tw:flex tw:min-w-0 tw:flex-col tw:gap-2 tw:sm:flex-row"><input class="tw:min-h-12 tw:min-w-0 tw:flex-1 tw:border tw:border-[#8da293] tw:bg-white tw:px-3 tw:text-sm" id="map-share-url" type="text" readonly /><button class="tw:min-h-12 tw:cursor-pointer tw:border-0 tw:bg-[#334b3d] tw:px-5 tw:font-bold tw:text-white tw:hover:bg-[#496653] tw:focus-visible:outline-2 tw:focus-visible:outline-offset-2 tw:focus-visible:outline-[#a35e3e]" id="map-share-copy" type="button">{pl ? 'Kopiuj link' : 'Copy link'}</button></div><p class="tw:mt-3 tw:min-h-5 tw:text-xs tw:leading-5" id="map-share-status" role="status"></p></div></section><section class="map-connections" aria-labelledby="map-connections-heading"><div class="map-connections-head"><div><p class="eyebrow">✦ {pl ? 'ODCZYTAJ MAPĘ' : 'READ THE MAP'}</p><h2 id="map-connections-heading">{pl ? 'Powiązania w skrócie' : 'Connections at a glance'}</h2></div><div><p id="map-summary" aria-live="polite"></p><a id="reading-sheet-link" class="reading-sheet-link" hidden>{pl ? 'Karta czytelnika do druku' : 'Printable reading sheet'} ↗</a></div></div><ul id="map-connections-list" class="map-connections-list"></ul></section><section class="story-columns"><div><h2>{pl ? 'Bohaterowie i relacje' : 'Characters & connections'}</h2><div id="character-list"></div></div><div><h2>{pl ? 'Oś wydarzeń' : 'Story timeline'}</h2><div id="event-list"></div></div></section></div></> : <h1>{status === 404 ? (pl ? 'Nie znaleziono książki' : 'Book not found') : (pl ? 'Książka jest chwilowo niedostępna' : 'Book temporarily unavailable')}</h1>}</main>
  {book && <script src="../../../scripts/story.js"></script>}
</Layout>

<style>
.chapter-discoveries{display:grid;grid-template-columns:minmax(180px,.75fr) minmax(0,1.25fr);gap:35px;padding:30px 34px;margin-bottom:24px;background:#e9ede4;border-left:4px solid #a35e3e}.chapter-discoveries-intro h2{font:500 clamp(27px,3vw,37px)/1.2 'Playfair Display',serif;margin:12px 0}.chapter-discoveries-intro>p:last-child{font-size:13px;line-height:1.5;color:#405448}.chapter-discoveries-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.chapter-discoveries-group{border-top:1px solid #b5c4b4;padding-top:12px;min-width:0}.chapter-discoveries-group h3{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#855039;margin:0 0 12px}.chapter-discoveries-group ul{list-style:none;padding:0;margin:0}.chapter-discoveries-group li{font-size:13px;line-height:1.55;margin:0 0 10px;overflow-wrap:anywhere}.chapter-discoveries-group a{text-decoration:underline;text-underline-offset:3px}.chapter-discoveries-empty{font-size:13px;line-height:1.6;color:#405448}.chapter-discoveries[hidden],#story-app[data-state="loading"] .chapter-discoveries,#story-app[data-state="error"] .chapter-discoveries{display:none}@media(max-width:760px){.chapter-discoveries{grid-template-columns:1fr;gap:15px;padding:24px}.chapter-discoveries-list{grid-template-columns:1fr;gap:12px}.chapter-discoveries-group li{margin-bottom:6px}}
</style>

<style>.reading-sheet-link{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.reading-sheet-link[hidden]{display:none}</style>

<style>
.map-page{padding-top:28px}.map-page-intro{padding:0;max-width:none}.map-page-intro h1{font-size:clamp(32px,4vw,50px);margin:12px 0 5px}.map-page-intro>p:not(.eyebrow){margin:5px 0}.map-page .book-toolbar{margin:22px 0 16px;padding-top:16px;align-items:end}.map-page .book-toolbar h2{margin:0;font-size:25px}.map-page .book-toolbar .muted{margin:5px 0}.map-stage{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:16px;align-items:stretch;margin-bottom:24px}.map-stage .graph{min-width:0;border:0;border-radius:0;background:#dce6d9}.map-stage .graph svg{min-height:320px}.map-stage-rail{display:flex;flex-direction:column;gap:12px}.map-stage .chapter-controls{grid-template-columns:1fr 1fr;gap:12px;padding:22px 18px;margin:0}.map-stage .chapter-position{grid-column:1/-1;grid-row:1;text-align:left;gap:12px}.map-stage .chapter-position strong{font:500 25px/1.1 'Playfair Display',serif}.map-stage .chapter-controls button{padding:10px 4px}.map-stage .progress-memory{margin:0;flex:1;align-content:start;align-items:start;flex-wrap:wrap;gap:8px}.map-stage .progress-memory p{flex:1;min-width:120px}.map-stage .progress-memory a{margin-left:38px;white-space:normal}.map-stage .graph-hint{color:#405448;font-weight:700}.map-stage .zoom-controls button{width:44px;height:44px}.chapter-discoveries{margin-top:0}@media(max-width:760px){.map-page{padding-top:24px}.map-page-intro h1{font-size:35px;letter-spacing:-1px}.map-page .book-toolbar{margin:18px 0 12px;gap:12px}.map-page .book-toolbar label{width:100%}.map-page .book-toolbar select{width:100%;font-size:16px}.map-stage{grid-template-columns:1fr;gap:10px}.map-stage .graph svg{min-height:260px}.map-stage .chapter-controls{padding:18px}.map-stage .progress-memory{flex:initial}.map-stage .progress-memory a{margin-left:0}}
</style>

<style>
.map-detail-prompt{background:#e9ede4;padding:22px;color:#27352f}.map-detail-prompt[hidden]{display:none}.map-detail-prompt strong{font:500 24px/1.15 'Playfair Display',serif}.map-detail-prompt p{font-size:13px;line-height:1.6;color:#405448;margin:10px 0 0}.map-stage-rail .map-detail{display:block;position:relative;margin:0;padding:24px 20px;background:#263e33}.map-stage-rail .map-detail[hidden]{display:none}.map-stage-rail .map-detail-mark{width:54px;height:54px;font:500 29px 'Playfair Display',serif;margin-bottom:20px}.map-stage-rail .map-detail-content h2{font-size:28px;line-height:1.1;overflow-wrap:anywhere}.map-stage-rail .map-detail-content>p:not(.eyebrow){color:#edf2ec}.map-stage-rail .map-detail-link{color:#fff;line-height:1.5}.map-stage-rail .map-detail button{position:absolute;right:16px;top:16px}.map-stage-rail .map-detail button:focus-visible,.map-stage-rail .map-detail-link:focus-visible{outline:3px solid #e8bea5;outline-offset:4px}@media(max-width:760px){.map-stage-rail .map-detail{padding:24px}.map-stage-rail .map-detail-mark{display:grid}.map-stage-rail .map-detail-content h2{font-size:29px}}
</style>

<style>
.map-share[hidden]{display:none}
</style>

<style>
.map-page .book-toolbar{display:block}.map-boundary{display:flex;justify-content:space-between;align-items:center;gap:28px;background:#334b3d;color:#f6f4ed;padding:22px 26px;margin-top:20px}.map-boundary-copy{display:flex;align-items:start;gap:18px;max-width:610px}.map-boundary-copy>span{font-size:27px;line-height:1;color:#f0c3a5}.map-boundary-copy strong{font:500 23px/1.2 'Playfair Display',serif}.map-boundary-copy p{font-size:13px;line-height:1.6;color:#e1e9df;margin:8px 0 0}.map-boundary-copy a{text-decoration:underline;text-underline-offset:3px;white-space:nowrap}.map-page .book-toolbar .map-boundary label{font-size:12px;font-weight:700;min-width:190px}.map-page .book-toolbar .map-boundary select{width:100%;background:#f6f4ed;color:#27352f;border:1px solid #c4d0c0}.map-boundary a:focus-visible{outline:3px solid #f0c3a5;outline-offset:4px}@media(max-width:760px){.map-boundary{display:block;padding:20px;margin-top:15px}.map-boundary-copy{gap:12px}.map-page .book-toolbar .map-boundary label{display:block;margin-top:18px;min-width:0}.map-boundary-copy strong{font-size:21px}}
</style>

<style>.edge-group.is-selected .edge{stroke:#a35e3e;stroke-width:4}.edge-group.is-selected .edge-label{font-weight:700}.edge-group:focus-visible{outline:none}.edge-group:focus-visible .edge{stroke:#a35e3e;stroke-width:4}</style>
