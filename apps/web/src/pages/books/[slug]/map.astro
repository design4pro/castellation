---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const slug = Astro.params.slug;
const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
let book, story;
let status = 200;
try {
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 ? 404 : 503;
  else { const data = await response.json(); book = data.book; story = data.story; }
} catch { status = 503; }
Astro.response.status = status;
const title = book?.title || 'Book';
const pl = lang === 'pl';
---
<Layout title={book ? (pl ? `Mapa bohaterów - ${title} - Castellation` : `${title} character map - Castellation`) : (pl ? 'Mapa bohaterów - Castellation' : 'Character map - Castellation')} lang={lang} description={book ? (pl ? `Odkrywaj mapę bohaterów ${title} i ich relacje według przeczytanego rozdziału.` : `Explore the character map of ${title} and follow connections by chapter.`) : ''} noindex={!book || Astro.url.searchParams.has('volume') || Astro.url.searchParams.has('chapter')}>
  <SiteHeader lang={lang} />
  <main class="wrap book-page map-page">{book ? <><Breadcrumbs lang={lang} structured={!Astro.url.searchParams.has('volume') && !Astro.url.searchParams.has('chapter')} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: pl ? 'Mapa bohaterów' : 'Character map' }]} /><div class="map-page-intro"><p class="eyebrow">✦ {pl ? 'TWOJA MAPA OPOWIEŚCI' : 'YOUR STORY MAP'}</p><h1 id="book-title">{title}</h1><p id="book-author">{book.author}</p><p>{pl ? 'Wybierz przeczytany rozdział i odkrywaj powiązania bohaterów we własnym tempie.' : 'Choose the chapter you have read and explore character connections at your own pace.'}</p></div><div class="book-toolbar" id="story-map"><div><h2>{pl ? 'Powiązania bohaterów' : 'Character connections'}</h2><p class="muted">{pl ? 'Przeciągnij, aby przesunąć. Zsuń palce, aby przybliżyć.' : 'Drag to move. Pinch to zoom.'}</p></div><label for="progress">{pl ? 'Przeczytano do' : 'Read up to'} <select id="progress"></select></label></div>
  <div id="chapter-controls" class="chapter-controls" hidden aria-label={pl ? 'Nawigacja po rozdziałach' : 'Chapter navigation'}><button id="chapter-previous" type="button" aria-disabled="true">← {pl ? 'Poprzedni' : 'Previous'}</button><div class="chapter-position"><span class="eyebrow">{pl ? 'TWÓJ PUNKT W HISTORII' : 'YOUR PLACE IN THE STORY'}</span><strong id="chapter-position-label" aria-live="polite"></strong><span class="chapter-track" aria-hidden="true"><span id="chapter-track-fill"></span></span></div><button id="chapter-next" type="button" aria-disabled="true">{pl ? 'Następny' : 'Next'} →</button></div><div class="progress-memory" id="progress-memory" hidden><span aria-hidden="true">✳</span><p id="progress-memory-text" role="status"></p><a href={`/account?lang=${lang}`}>{pl ? 'Konto i synchronizacja' : 'Account and sync'} ↗</a></div><div id="story-app" data-state="loading" data-api={api} data-slug={slug} data-lang={lang} data-positions={JSON.stringify(book.positions)}><section class="chapter-discoveries" aria-labelledby="chapter-discoveries-heading"><div class="chapter-discoveries-intro"><p class="eyebrow">✦ {pl ? 'NOWY FRAGMENT HISTORII' : 'A NEW PART OF THE STORY'}</p><h2 id="chapter-discoveries-heading">{pl ? 'W tym rozdziale' : 'In this chapter'}</h2><p id="chapter-discoveries-position" role="status"></p></div><div id="chapter-discoveries-list" class="chapter-discoveries-list"></div></section><div class="graph" id="graph" aria-label={pl ? 'Interaktywny graf powiązań' : 'Interactive relationship graph'}><svg id="graph-svg" viewBox="0 0 800 520" role="group" aria-label={pl ? 'Mapa bohaterów' : 'Character map'}></svg><div class="graph-hint">✳ {pl ? 'DOTKNIJ POSTACI' : 'TAP A CHARACTER'}</div><div class="zoom-controls"><button id="zoom-in" aria-label={pl ? "Powiększ" : "Zoom in"}>+</button><button id="zoom-out" aria-label={pl ? "Pomniejsz" : "Zoom out"}>−</button><button id="zoom-reset" aria-label={pl ? "Przywróć widok" : "Reset zoom"}>⌂</button></div></div><noscript><p class="map-no-script">{pl ? 'Mapa wymaga JavaScript. Otwórz spis bohaterów, aby przeglądać profile.' : 'The map requires JavaScript. Open the character list to browse profiles.'}</p><style>.map-load-state { display: none; }</style> <a href={`/books/${encodeURIComponent(slug || '')}/characters?lang=${lang}`}>{pl ? 'Zobacz bohaterów' : 'See the characters'} ↗</a></noscript><div class="map-load-state"><p id="status" role="status">{pl ? 'Przygotowujemy mapę...' : 'Preparing your map...'}</p><button id="map-retry" type="button" hidden>{pl ? 'Spróbuj ponownie' : 'Try again'}</button></div><aside id="map-detail" class="map-detail" aria-labelledby="map-detail-name" hidden><div class="map-detail-mark" aria-hidden="true">✳</div><div class="map-detail-content"><p class="eyebrow">{pl ? 'WYBRANA POSTAĆ' : 'SELECTED CHARACTER'}</p><h2 id="map-detail-name" tabindex="-1"></h2><p id="map-detail-description"></p><a id="map-detail-link" class="map-detail-link">{pl ? 'Otwórz profil postaci' : 'Open character profile'} ↗</a></div><button id="map-detail-close" type="button" aria-label={pl ? 'Zamknij szczegóły postaci' : 'Close character details'}>×</button></aside><section class="map-connections" aria-labelledby="map-connections-heading"><div class="map-connections-head"><div><p class="eyebrow">✦ {pl ? 'ODCZYTAJ MAPĘ' : 'READ THE MAP'}</p><h2 id="map-connections-heading">{pl ? 'Powiązania w skrócie' : 'Connections at a glance'}</h2></div><div><p id="map-summary" aria-live="polite"></p><a id="reading-sheet-link" class="reading-sheet-link" hidden>{pl ? 'Karta czytelnika do druku' : 'Printable reading sheet'} ↗</a></div></div><ul id="map-connections-list" class="map-connections-list"></ul></section><section class="story-columns"><div><h2>{pl ? 'Bohaterowie i relacje' : 'Characters & connections'}</h2><div id="character-list"></div></div><div><h2>{pl ? 'Oś wydarzeń' : 'Story timeline'}</h2><div id="event-list"></div></div></section></div></> : <h1>{status === 404 ? (pl ? 'Nie znaleziono książki' : 'Book not found') : (pl ? 'Książka jest chwilowo niedostępna' : 'Book temporarily unavailable')}</h1>}</main>
  {book && <script src="../../../scripts/story.js"></script>}
</Layout>

<style>
.chapter-discoveries{display:grid;grid-template-columns:minmax(180px,.75fr) minmax(0,1.25fr);gap:35px;padding:30px 34px;margin-bottom:24px;background:#e9ede4;border-left:4px solid #a35e3e}.chapter-discoveries-intro h2{font:500 clamp(27px,3vw,37px)/1.2 'Playfair Display',serif;margin:12px 0}.chapter-discoveries-intro>p:last-child{font-size:13px;line-height:1.5;color:#405448}.chapter-discoveries-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.chapter-discoveries-group{border-top:1px solid #b5c4b4;padding-top:12px;min-width:0}.chapter-discoveries-group h3{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#855039;margin:0 0 12px}.chapter-discoveries-group ul{list-style:none;padding:0;margin:0}.chapter-discoveries-group li{font-size:13px;line-height:1.55;margin:0 0 10px;overflow-wrap:anywhere}.chapter-discoveries-group a{text-decoration:underline;text-underline-offset:3px}.chapter-discoveries-empty{font-size:13px;line-height:1.6;color:#405448}.chapter-discoveries[hidden],#story-app[data-state="loading"] .chapter-discoveries,#story-app[data-state="error"] .chapter-discoveries{display:none}@media(max-width:760px){.chapter-discoveries{grid-template-columns:1fr;gap:15px;padding:24px}.chapter-discoveries-list{grid-template-columns:1fr;gap:12px}.chapter-discoveries-group li{margin-bottom:6px}}
</style>

<style>.reading-sheet-link{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.reading-sheet-link[hidden]{display:none}</style>
