---
import SiteFooter from '../../../../components/SiteFooter.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Layout from '../../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug, relation: relationId } = Astro.params;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const volume = Astro.url.searchParams.get('volume'), chapter = Astro.url.searchParams.get('chapter');
const hasProgress = volume !== null || chapter !== null;
const progressQuery = hasProgress ? `?volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
let book, progress, relation, from, to, story, status = 200;
try {
  const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}${progressQuery}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 || response.status === 400 ? 404 : 503;
  else { const data = await response.json(); book = data.book; progress = data.progress; story = data.story; relation = data.story.relations.find((item) => item.id === relationId); from = data.story.characters.find((item) => item.id === relation?.from); to = data.story.characters.find((item) => item.id === relation?.to); if (!relation || !from || !to) status = 404; }
} catch { status = 503; }
Astro.response.status = status;
const relationChapter = relation && book.chapters.find((item) => item.volume === relation.volume && item.chapter === relation.chapter);
const chapterEvents = relationChapter ? story.events.filter((event) => event.volume === relation.volume && event.chapter === relation.chapter) : [];
const title = relation ? `${from.name} ${relation.label.toLowerCase()} ${to.name} - ${book.title} - Castellation` : (pl ? 'Relacja niedostępna - Castellation' : 'Connection unavailable - Castellation');
const description = relation ? (pl ? `Poznaj powiązanie ${from.name} i ${to.name} w ${book.title}, widoczne do wybranego rozdziału.` : `Explore the connection between ${from.name} and ${to.name} in ${book.title} at this point in the story.`) : '';
---
<Layout lang={lang} title={title} description={description} noindex={!relation || hasProgress}>
  <SiteHeader lang={lang} />
  <main class="wrap relation-detail">{relation ? <><Breadcrumbs lang={lang} structured={!hasProgress} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: pl ? 'Powiązania' : 'Connections', href: `/books/${encodeURIComponent(slug || '')}/connections?lang=${lang}` }, { label: `${from.name} · ${to.name}` }]} /><header class="relation-header"><p class="eyebrow">✦ {pl ? 'JEDNO POWIĄZANIE / JEDNA HISTORIA' : 'ONE CONNECTION / ONE STORY'}</p><p class="relation-book">{book.title} / {book.author}</p><h1>{from.name} <em>{relation.label}</em> {to.name}</h1><p class="relation-scope">{pl ? 'Informacje do tomu' : 'Details through volume'} {progress.volume}, {pl ? 'rozdziału' : 'chapter'} {progress.chapter}.</p></header><section class="relation-spread" aria-label={pl ? 'Bohaterowie i ich powiązanie' : 'Characters and their connection'}><a class="relation-person relation-person-from" href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(from.slug)}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}><span class="relation-role">{pl ? 'OD' : 'FROM'}</span><span class="relation-initial" aria-hidden="true">{from.name.slice(0, 1)}</span><span class="relation-person-copy"><strong>{from.name}</strong>{from.descriptions.at(-1)?.text && <span>{from.descriptions.at(-1).text}</span>}</span><span class="relation-person-action">{pl ? 'Otwórz profil' : 'Open profile'}: {from.name} <span aria-hidden="true">↗</span></span></a><div class="relation-bridge"><span aria-hidden="true">↓</span><strong>{relation.label}</strong><span aria-hidden="true">↓</span></div><a class="relation-person relation-person-to" href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(to.slug)}?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}><span class="relation-role">{pl ? 'DO' : 'TO'}</span><span class="relation-initial" aria-hidden="true">{to.name.slice(0, 1)}</span><span class="relation-person-copy"><strong>{to.name}</strong>{to.descriptions.at(-1)?.text && <span>{to.descriptions.at(-1).text}</span>}</span><span class="relation-person-action">{pl ? 'Otwórz profil' : 'Open profile'}: {to.name} <span aria-hidden="true">↗</span></span></a></section>{relationChapter && <section class="relation-context" aria-labelledby="relation-context-title"><div class="relation-context-intro"><p class="eyebrow">✦ {pl ? 'MIEJSCE W OPOWIEŚCI' : 'A PLACE IN THE STORY'}</p><h2 id="relation-context-title">{pl ? 'Wróć do rozdziału.' : 'Return to the chapter.'}</h2><p>{pl ? 'To powiązanie przypisano do tego rozdziału. Przewodnik zawiera jego szczegóły.' : 'This connection is assigned to this chapter. The guide contains details from it.'}</p><a href={`/books/${encodeURIComponent(slug || '')}/chapters/${relation.volume}-${relation.chapter}?lang=${lang}`}>{pl ? 'Otwórz przewodnik po rozdziale' : 'Open the chapter guide'} ↗</a></div><div class="relation-context-chapter"><span>{pl ? 'TOM' : 'VOLUME'} {relation.volume} / {pl ? 'ROZDZIAŁ' : 'CHAPTER'} {relation.chapter}</span><h3>{relationChapter.title}</h3>{chapterEvents.length > 0 && <><p>{pl ? 'WYDARZENIA W TYM ROZDZIALE' : 'EVENTS IN THIS CHAPTER'}</p><ul>{chapterEvents.map((event) => <li>{event.title}</li>)}</ul></>}</div></section>}<aside class="relation-return"><div><h2>{pl ? 'Zobacz tę relację w całej historii.' : 'See this connection in the wider story.'}</h2><p>{pl ? 'Mapa zachowa wybrany rozdział.' : 'The map keeps your selected chapter.'}</p></div><a class="primary-button" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{pl ? 'Otwórz mapę historii' : 'Open the story map'} <span aria-hidden="true">↗</span></a></aside></> : <h1>{status === 503 ? (pl ? 'Relacja jest chwilowo niedostępna' : 'Connection temporarily unavailable') : (pl ? 'Nie znaleziono relacji' : 'Connection not found')}</h1>}</main>
  <SiteFooter lang={lang} />
</Layout>
<style>
.relation-detail{padding-block:35px 90px}.relation-header{padding:24px 0 30px}.relation-book{font-size:13px;color:#53675a;margin:15px 0}.relation-header h1{font:500 clamp(30px,3.8vw,53px)/1.13 'Playfair Display',serif;letter-spacing:-.035em;margin:15px 0;overflow-wrap:anywhere}.relation-header h1 em{font-weight:400;color:#a35e3e}.relation-scope{font-size:13px;color:#405448;margin:0}.relation-spread{display:grid;grid-template-columns:minmax(0,1fr) 150px minmax(0,1fr);background:#263e33}.relation-person{position:relative;min-width:0;min-height:330px;padding:30px;color:#f6f4ed;display:flex;flex-direction:column;overflow:hidden}.relation-person-from{background:#334b3d}.relation-person-to{background:#85513c}.relation-role{font-size:10px;font-weight:700;letter-spacing:.15em}.relation-initial{position:absolute;top:20px;right:28px;font:500 clamp(100px,13vw,170px)/1 'Playfair Display',serif;color:#f6f4ed;opacity:.13}.relation-person-copy{position:relative;display:flex;flex-direction:column;gap:13px;margin:auto 0 25px}.relation-person-copy strong{font:500 clamp(30px,3.3vw,46px)/1.08 'Playfair Display',serif;overflow-wrap:anywhere}.relation-person-copy>span{max-width:300px;color:#fff;line-height:1.6;font-size:14px}.relation-person-action{border-top:1px solid #c1cfc1;padding-top:16px;font-size:13px;font-weight:700;display:flex;justify-content:space-between;gap:12px}.relation-person:hover .relation-person-action{text-decoration:underline;text-underline-offset:4px}.relation-person:focus-visible{outline:3px solid #bc6f42;outline-offset:4px}.relation-bridge{color:#f6f4ed;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;text-align:center;padding:16px;overflow-wrap:anywhere}.relation-bridge strong{font:400 italic 23px/1.2 'Playfair Display',serif;color:#f1c7ab}.relation-bridge>span{font-size:22px;color:#f1c7ab;transform:rotate(-90deg)}.relation-context{display:grid;grid-template-columns:1fr 1fr;background:#e1e8dc;margin-top:28px}.relation-context-intro,.relation-context-chapter{padding:clamp(24px,4vw,42px)}.relation-context-intro h2{font:500 clamp(28px,3vw,40px)/1.15 'Playfair Display',serif;margin:15px 0}.relation-context-intro>p:not(.eyebrow){color:#405448;line-height:1.7;max-width:40ch}.relation-context-intro a{display:inline-block;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px;margin-top:15px}.relation-context-intro a:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}.relation-context-chapter{background:#d0ddce}.relation-context-chapter>span,.relation-context-chapter>p{font-size:10px;letter-spacing:.12em;font-weight:700;color:#75432e}.relation-context-chapter h3{font:500 clamp(28px,3vw,40px)/1.15 'Playfair Display',serif;margin:20px 0 30px}.relation-context-chapter ul{padding:0;list-style:none;margin:12px 0 0}.relation-context-chapter li{border-top:1px solid #9fb39f;padding:12px 0;line-height:1.5}.relation-return{display:flex;align-items:center;justify-content:space-between;gap:25px;padding:30px 0;border-bottom:1px solid #b9c9b9}.relation-return h2{font:500 clamp(25px,2.5vw,34px)/1.2 'Playfair Display',serif;margin:0 0 8px}.relation-return p{color:#405448;line-height:1.6;margin:0}.relation-return .primary-button{flex:none}@media(max-width:760px){.relation-detail{padding-block:24px 65px}.relation-header{padding:18px 0 24px}.relation-header h1{font-size:34px}.relation-spread{grid-template-columns:1fr}.relation-person{min-height:225px;padding:24px}.relation-initial{font-size:100px}.relation-person-copy{margin:28px 0 22px}.relation-person-copy strong{font-size:32px}.relation-bridge{flex-direction:row;gap:15px;padding:13px}.relation-bridge>span{transform:none}.relation-context{grid-template-columns:1fr}.relation-return{display:block}.relation-return .primary-button{margin-top:20px}}
</style>
