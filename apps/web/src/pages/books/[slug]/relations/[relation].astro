---
import SiteHeader from '../../../../components/SiteHeader.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Layout from '../../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug, relation: relationId } = Astro.params;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const volume = Astro.url.searchParams.get('volume'), chapter = Astro.url.searchParams.get('chapter');
const hasProgress = volume !== null || chapter !== null;
const progressQuery = hasProgress ? `?volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
const linkProgress = hasProgress ? `&volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
let book, progress, relation, from, to, status = 200;
try {
  const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}${progressQuery}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 || response.status === 400 ? 404 : 503;
  else { const data = await response.json(); book = data.book; progress = data.progress; relation = data.story.relations.find((item) => item.id === relationId); from = data.story.characters.find((item) => item.id === relation?.from); to = data.story.characters.find((item) => item.id === relation?.to); if (!relation || !from || !to) status = 404; }
} catch { status = 503; }
Astro.response.status = status;
const title = relation ? `${from.name} ${relation.label.toLowerCase()} ${to.name} - ${book.title} - Castellation` : (pl ? 'Relacja niedostępna - Castellation' : 'Connection unavailable - Castellation');
const description = relation ? (pl ? `Poznaj powiązanie ${from.name} i ${to.name} w ${book.title}, widoczne do wybranego rozdziału.` : `Explore the connection between ${from.name} and ${to.name} in ${book.title} at this point in the story.`) : '';
---
<Layout lang={lang} title={title} description={description} noindex={!relation || hasProgress}>
  <SiteHeader lang={lang} />
  <main class="wrap relation-detail">{relation ? <><Breadcrumbs lang={lang} structured={!hasProgress} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: pl ? 'Powiązania' : 'Connections', href: `/books/${encodeURIComponent(slug || '')}/connections?lang=${lang}` }, { label: `${from.name} · ${to.name}` }]} /><header class="relation-hero"><p class="eyebrow">✦ {pl ? 'JEDNO POWIĄZANIE / JEDNA HISTORIA' : 'ONE CONNECTION / ONE STORY'}</p><p class="relation-book">{book.title} / {book.author}</p><h1>{from.name}<br /><em>{relation.label}</em><br />{to.name}</h1><p class="relation-scope">✳ {pl ? 'Informacje do tomu' : 'Details through volume'} {progress.volume}, {pl ? 'rozdziału' : 'chapter'} {progress.chapter}.</p></header><section aria-labelledby="relation-people"><div class="collection-bar"><h2 id="relation-people">{pl ? 'Poznaj bohaterów' : 'Meet the characters'}</h2><span>02</span></div><div class="relation-people">{[from, to].map((character, index) => <article><div class="relation-portrait" aria-hidden="true"><span>{character.name.slice(0, 1)}</span><small>0{index + 1} / ✳</small></div><p class="eyebrow">{index === 0 ? (pl ? 'OD' : 'FROM') : (pl ? 'DO' : 'TO')}</p><h3>{character.name}</h3><p>{character.descriptions.at(-1)?.text}</p><a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(character.slug)}?lang=${lang}${linkProgress}`}>{pl ? 'Otwórz profil' : 'Open profile'}: {character.name} ↗</a></article>)}</div></section><aside class="relation-next"><div><p class="eyebrow">✦ {pl ? 'SZERSZY OBRAZ' : 'THE WIDER PICTURE'}</p><h2>{pl ? 'Zobacz pozostałe wątki.' : 'See the other threads.'}</h2><p>{pl ? 'Odkrywaj relacje widoczne na tym etapie czytania.' : 'Explore the connections visible at this point in the story.'}</p></div><a class="primary-button" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${progress.volume}&chapter=${progress.chapter}`}>{pl ? 'Otwórz mapę historii' : 'Open the story map'} ↗</a></aside></> : <h1>{status === 503 ? (pl ? 'Relacja jest chwilowo niedostępna' : 'Connection temporarily unavailable') : (pl ? 'Nie znaleziono relacji' : 'Connection not found')}</h1>}</main>
  <footer class="wrap footer"><a class="brand" href={`/?lang=${lang}`}>✳ castellation<span class="brand-dot">.</span></a><p>{pl ? 'Historie są lepsze, gdy widzisz ich powiązania.' : 'Stories are better when you see the connections.'}</p><span>© {new Date().getFullYear()} CASTELLATION</span></footer>
</Layout>
<style>
.relation-detail{padding-block:45px 100px}.relation-hero{padding:35px 0 65px}.relation-book{font-size:14px;color:#53675a;margin-top:25px}.relation-hero h1{font:500 clamp(45px,6vw,76px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:28px 0;overflow-wrap:anywhere}.relation-hero h1 em{color:#a35e3e;font-weight:400}.relation-scope{font-size:13px;color:#53675a}.relation-people{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:30px}.relation-people article{background:#e6ebe0;padding:30px}.relation-people article:nth-child(2){background:#eae2d6}.relation-portrait{height:190px;background:#334b3d;color:#e6c0a5;display:flex;align-items:center;justify-content:center;position:relative;border-radius:45% 45% 2px 2px}.relation-people article:nth-child(2) .relation-portrait{background:#915c43}.relation-portrait span{font:500 80px 'Playfair Display',serif}.relation-portrait small{position:absolute;bottom:15px;font-size:10px;letter-spacing:.14em}.relation-people .eyebrow{margin-top:25px}.relation-people h3{font:500 32px 'Playfair Display',serif;margin:12px 0}.relation-people article>p:not(.eyebrow){color:#405448;line-height:1.7;min-height:3em}.relation-people article>a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.relation-next{display:flex;justify-content:space-between;align-items:end;gap:30px;padding:38px;background:#e1e8dc;margin-top:65px}.relation-next h2{font:500 clamp(30px,3vw,42px) 'Playfair Display',serif;margin:15px 0}.relation-next p:not(.eyebrow){color:#405448;line-height:1.7}@media(max-width:760px){.relation-detail{padding-block:30px 65px}.relation-hero{padding:25px 0 45px}.relation-people{grid-template-columns:1fr;gap:16px}.relation-portrait{height:150px}.relation-portrait span{font-size:60px}.relation-next{display:block;padding:25px}.relation-next .primary-button{margin-top:12px}}
</style>
