---
import ChapterSource from '../../../../components/ChapterSource.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Layout from '../../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug, position } = Astro.params;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const match = /^(\d+)-(\d+)$/.exec(position || '');
const volume = Number(match?.[1]), chapterNumber = Number(match?.[2]);
let data, chapter, status = 200;
if (!match || !Number.isSafeInteger(volume) || !Number.isSafeInteger(chapterNumber) || volume < 1 || chapterNumber < 1 || position !== `${volume}-${chapterNumber}`) status = 404;
else try {
  const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}?volume=${volume}&chapter=${chapterNumber}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 400 || response.status === 404 ? 404 : 503;
  else { data = await response.json(); chapter = data.book.chapters.find((item) => item.volume === volume && item.chapter === chapterNumber); if (!chapter) status = 404; }
} catch { status = 503; }
Astro.response.status = status;
const events = chapter ? data.story.events.filter((event) => event.volume === volume && event.chapter === chapterNumber) : [];
const characters = chapter ? data.story.characters.filter((character) => character.volume === volume && character.chapter === chapterNumber) : [];
const relations = chapter ? data.story.relations.filter((relation) => relation.volume === volume && relation.chapter === chapterNumber).map((relation) => ({ ...relation, fromCharacter: data.story.characters.find((character) => character.id === relation.from), toCharacter: data.story.characters.find((character) => character.id === relation.to) })).filter((relation) => relation.fromCharacter && relation.toCharacter) : [];
const first = chapter && data.book.positions[0]?.volume === volume && data.book.positions[0]?.chapter === chapterNumber;
if (first) return Astro.redirect(`/books/${encodeURIComponent(slug || '')}/opening?lang=${lang}`, 301);
const title = chapter ? `${chapter.title} - ${data.book.title} - Castellation` : (pl ? 'Rozdział niedostępny - Castellation' : 'Chapter unavailable - Castellation');
const description = chapter ? (pl ? `Wydarzenia i bohaterowie rozdziału ${chapter.title} z ${data.book.title}.` : `Explore the events and characters of ${chapter.title} from ${data.book.title}.`) : '';
---
<Layout lang={lang} title={title} description={description} noindex={!chapter || !events.length}>
  <SiteHeader lang={lang} />
  <main class="wrap chapter-page">{chapter ? <><Breadcrumbs lang={lang} structured={events.length > 0} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: data.book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: chapter.title }]} /><header class="chapter-page-hero"><div><p class="eyebrow">✦ {pl ? 'PRZEWODNIK PO ROZDZIALE' : 'A CHAPTER GUIDE'}</p><p class="chapter-page-book">{data.book.title} / {data.book.author}</p><h1>{chapter.title}</h1><p>{pl ? 'Tom' : 'Volume'} {volume} · {pl ? 'Rozdział' : 'Chapter'} {chapterNumber}</p></div><div class="chapter-page-art" aria-hidden="true"><span>{String(chapterNumber).padStart(2, '0')}</span><small>✳ CASTELLATION</small></div></header><div class="chapter-page-notice">✦ {pl ? 'Ta strona zawiera informacje z tego rozdziału. Wróć do książki, jeśli jeszcze go nie czytasz.' : 'This page contains details from this chapter. Return to the book if you have not read it yet.'}</div>
    {events.length > 0 && <section class="chapter-page-section"><div class="collection-bar"><h2>{pl ? 'Co się wydarza' : 'What happens'}</h2><span>{String(events.length).padStart(2, '0')}</span></div><ol class="chapter-page-events">{events.map((event, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{event.title}</h3><p>{event.description}</p></div></li>)}</ol></section>}
    {characters.length > 0 && <section class="chapter-page-section"><div class="collection-bar"><h2>{pl ? 'Nowe postacie' : 'New characters'}</h2><span>{String(characters.length).padStart(2, '0')}</span></div><div class="chapter-page-links">{characters.map((character) => <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(character.slug)}?lang=${lang}&volume=${volume}&chapter=${chapterNumber}`}><strong>{character.name}</strong><span>{character.descriptions.at(-1)?.text}</span><span aria-hidden="true">↗</span></a>)}</div></section>}
    {relations.length > 0 && <section class="chapter-page-section"><div class="collection-bar"><h2>{pl ? 'Nowe powiązania' : 'New connections'}</h2><span>{String(relations.length).padStart(2, '0')}</span></div><ul class="chapter-page-relations">{relations.map((relation) => <li>{relation.fromCharacter.name} · {relation.label} → {relation.toCharacter.name}</li>)}</ul></section>}
    <ChapterSource slug={slug} volume={chapter.volume} chapter={chapter.chapter} lang={lang} /><aside class="chapter-page-cta"><div><p class="eyebrow">✦ {pl ? 'ZOBACZ CAŁĄ MAPĘ' : 'SEE THE FULL PICTURE'}</p><h2>{pl ? 'Podążaj za powiązaniami.' : 'Follow the connections.'}</h2></div><a class="primary-button" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${volume}&chapter=${chapterNumber}`}>{pl ? 'Otwórz mapę tego rozdziału' : 'Open the map at this chapter'} ↗</a></aside></> : <h1>{status === 503 ? (pl ? 'Rozdział jest chwilowo niedostępny' : 'Chapter temporarily unavailable') : (pl ? 'Nie znaleziono rozdziału' : 'Chapter not found')}</h1>}</main>
  <footer class="wrap footer"><a class="brand" href={`/?lang=${lang}`}>✳ castellation<span class="brand-dot">.</span></a><p>{pl ? 'Historie są lepsze, gdy widzisz ich powiązania.' : 'Stories are better when you see the connections.'}</p><span>© {new Date().getFullYear()} CASTELLATION</span></footer>
</Layout>
<style>
.chapter-page{padding-block:45px 95px}.chapter-page-hero{display:grid;grid-template-columns:1fr .7fr;gap:45px;align-items:center;padding:30px 0 55px}.chapter-page-hero h1{font:500 clamp(48px,6vw,78px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:20px 0}.chapter-page-book,.chapter-page-hero div>p:last-child{color:#53675a}.chapter-page-art{min-height:280px;background:#334b3d;border-radius:48% 48% 2px 2px;color:#e6c0a5;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px}.chapter-page-art span{font:500 100px 'Playfair Display',serif}.chapter-page-art small{font-size:10px;letter-spacing:.15em}.chapter-page-notice{padding:20px 24px;background:#e9e5d9;border-left:3px solid #a35e3e;line-height:1.6;font-size:14px}.chapter-page-section{margin-top:60px}.chapter-page-events{list-style:none;padding:0;margin:0}.chapter-page-events li{display:grid;grid-template-columns:60px 1fr;gap:24px;border-bottom:1px solid #d9ddd3;padding:24px 0}.chapter-page-events li>span{color:#a35e3e;font-size:12px}.chapter-page-events h3{font:500 25px 'Playfair Display',serif;margin:0}.chapter-page-events p,.chapter-page-links span{line-height:1.7;color:#53675a}.chapter-page-links a{display:grid;grid-template-columns:1fr 2fr auto;gap:20px;padding:22px 0;border-bottom:1px solid #d9ddd3;align-items:center}.chapter-page-links strong{font:500 24px 'Playfair Display',serif}.chapter-page-relations{list-style:none;padding:0}.chapter-page-relations li{padding:20px 0;border-bottom:1px solid #d9ddd3}.chapter-page-cta{background:#e1e8dc;padding:35px;margin-top:70px;display:flex;justify-content:space-between;align-items:end;gap:25px}.chapter-page-cta h2{font:500 clamp(30px,3vw,42px) 'Playfair Display',serif;margin:12px 0 0}@media(max-width:760px){.chapter-page{padding-block:30px 65px}.chapter-page-hero{grid-template-columns:1fr;gap:20px}.chapter-page-art{min-height:180px}.chapter-page-art span{font-size:70px}.chapter-page-events li{grid-template-columns:35px 1fr;gap:12px}.chapter-page-links a{grid-template-columns:1fr auto}.chapter-page-links a span:nth-child(2){grid-column:1/-1;grid-row:2}.chapter-page-cta{display:block;padding:25px}.chapter-page-cta .primary-button{margin-top:22px}}
</style>
