---
import SiteFooter from '../../../../components/SiteFooter.astro';
import ChapterSource from '../../../../components/ChapterSource.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Layout from '../../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug, position } = Astro.params;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const match = /^(\d+)-(\d+)$/.exec(position || '');
const volume = Number(match?.[1]), chapterNumber = Number(match?.[2]);
let data, chapter, status = 200;
if (!match || !Number.isSafeInteger(volume) || !Number.isSafeInteger(chapterNumber) || volume < 1 || chapterNumber < 1 || position !== `${volume}-${chapterNumber}`) status = 404;
else try {
  const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}?volume=${volume}&chapter=${chapterNumber}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 400 || response.status === 404 ? 404 : 503;
  else { data = await response.json(); chapter = data.book.chapters.find((item) => item.volume === volume && item.chapter === chapterNumber); if (!chapter) status = 404; }
} catch { status = 503; }
Astro.response.status = status;
const events = chapter ? data.story.events.filter((event) => event.volume === volume && event.chapter === chapterNumber) : [];
const characters = chapter ? data.story.characters.filter((character) => character.volume === volume && character.chapter === chapterNumber) : [];
const relations = chapter ? data.story.relations.filter((relation) => relation.volume === volume && relation.chapter === chapterNumber).map((relation) => ({ ...relation, fromCharacter: data.story.characters.find((character) => character.id === relation.from), toCharacter: data.story.characters.find((character) => character.id === relation.to) })).filter((relation) => relation.fromCharacter && relation.toCharacter) : [];
const positionIndex = chapter ? data.book.positions.findIndex((item) => item.volume === volume && item.chapter === chapterNumber) : -1;
const previousPosition = positionIndex > 0 ? data.book.positions[positionIndex - 1] : null;
const nextPosition = positionIndex >= 0 ? data.book.positions[positionIndex + 1] : null;
const chapterHref = (item) => `/books/${encodeURIComponent(slug || '')}/chapters/${item.volume}-${item.chapter}?lang=${lang}`;
const first = chapter && positionIndex === 0;
if (first) return Astro.redirect(`/books/${encodeURIComponent(slug || '')}/opening?lang=${lang}`, 301);
const title = chapter ? `${chapter.title} - ${data.book.title} - Castellation` : (pl ? 'Rozdział niedostępny - Castellation' : 'Chapter unavailable - Castellation');
const description = chapter ? (pl ? `Wydarzenia i bohaterowie rozdziału ${chapter.title} z ${data.book.title}.` : `Explore the events and characters of ${chapter.title} from ${data.book.title}.`) : '';
---
<Layout lang={lang} title={title} description={description} noindex={!chapter || !events.length}>
  <SiteHeader lang={lang} />
  <main class="wrap chapter-page">{chapter ? <><Breadcrumbs lang={lang} structured={events.length > 0} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: data.book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: chapter.title }]} /><header class="chapter-page-hero"><div><p class="eyebrow">✦ {pl ? 'PRZEWODNIK PO ROZDZIALE' : 'A CHAPTER GUIDE'}</p><p class="chapter-page-book">{data.book.title} / {data.book.author}</p><h1>{chapter.title}</h1><p>{pl ? 'Tom' : 'Volume'} {volume} · {pl ? 'Rozdział' : 'Chapter'} {chapterNumber}</p></div><div class="chapter-page-art" aria-hidden="true"><span>{String(chapterNumber).padStart(2, '0')}</span><small>✳ CASTELLATION</small></div></header><div class="chapter-page-notice">✦ {pl ? 'Ta strona zawiera informacje z tego rozdziału. Wróć do książki, jeśli jeszcze go nie czytasz.' : 'This page contains details from this chapter. Return to the book if you have not read it yet.'}</div>
    {(previousPosition || nextPosition) && <nav class="chapter-turn" aria-label={pl ? 'Nawigacja między rozdziałami' : 'Chapter navigation'}><div class="chapter-turn-intro"><p>✦ {pl ? 'TWOJA DROGA PRZEZ HISTORIĘ' : 'YOUR WAY THROUGH THE STORY'}</p><h2>{pl ? 'Kartka po kartce.' : 'Page by page.'}</h2>{nextPosition && <span>{pl ? 'Kolejny przewodnik zawiera szczegóły następnego rozdziału.' : 'The next guide contains details from the next chapter.'}</span>}</div><div class="chapter-turn-pages">{previousPosition ? <a href={chapterHref(previousPosition)}><small>← {pl ? 'POPRZEDNI' : 'PREVIOUS'}</small><strong>{pl ? 'Rozdział' : 'Chapter'} {previousPosition.chapter}</strong><span>{pl ? 'Tom' : 'Volume'} {previousPosition.volume}</span></a> : <div class="chapter-turn-empty" aria-hidden="true"></div>}<div class="chapter-turn-current" aria-current="page"><small>{pl ? 'TERAZ CZYTASZ' : 'YOU ARE HERE'}</small><strong>{pl ? 'Rozdział' : 'Chapter'} {chapterNumber}</strong><span>{pl ? 'Tom' : 'Volume'} {volume}</span></div>{nextPosition ? <a href={chapterHref(nextPosition)}><small>{pl ? 'NASTĘPNY' : 'NEXT'} →</small><strong>{pl ? 'Rozdział' : 'Chapter'} {nextPosition.chapter}</strong><span>{pl ? 'Tom' : 'Volume'} {nextPosition.volume}</span></a> : <div class="chapter-turn-empty" aria-hidden="true"></div>}</div></nav>}
    {events.length > 0 && <section class="chapter-page-section"><div class="collection-bar"><h2>{pl ? 'Co się wydarza' : 'What happens'}</h2><span>{String(events.length).padStart(2, '0')}</span></div><ol class="chapter-page-events">{events.map((event, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{event.title}</h3><p>{event.description}</p></div></li>)}</ol></section>}
    {characters.length > 0 && <section class="chapter-page-section"><div class="collection-bar"><h2>{pl ? 'Nowe postacie' : 'New characters'}</h2><span>{String(characters.length).padStart(2, '0')}</span></div><div class="chapter-page-links">{characters.map((character) => <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(character.slug)}?lang=${lang}&volume=${volume}&chapter=${chapterNumber}`}><strong>{character.name}</strong><span>{character.descriptions.at(-1)?.text}</span><span aria-hidden="true">↗</span></a>)}</div></section>}
    {relations.length > 0 && <section class="chapter-page-section"><div class="collection-bar"><h2>{pl ? 'Nowe powiązania' : 'New connections'}</h2><span>{String(relations.length).padStart(2, '0')}</span></div><ul class="chapter-page-relations">{relations.map((relation) => <li><div class="relation-person"><span>{pl ? 'OD' : 'FROM'}</span><a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(relation.fromCharacter.slug)}?lang=${lang}&volume=${volume}&chapter=${chapterNumber}`}>{relation.fromCharacter.name} ↗</a></div><div class="relation-direction"><span>{relation.label}</span><b aria-hidden="true">→</b></div><div class="relation-person"><span>{pl ? 'DO' : 'TO'}</span><a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(relation.toCharacter.slug)}?lang=${lang}&volume=${volume}&chapter=${chapterNumber}`}>{relation.toCharacter.name} ↗</a></div></li>)}</ul><a class="relation-map-link" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${volume}&chapter=${chapterNumber}`}>{pl ? 'Zobacz powiązania na mapie tego rozdziału' : 'See these connections on the map at this chapter'} ↗</a></section>}
    <ChapterSource slug={slug} volume={chapter.volume} chapter={chapter.chapter} lang={lang} /><aside class="chapter-page-cta"><div><p class="eyebrow">✦ {pl ? 'ZOBACZ CAŁĄ MAPĘ' : 'SEE THE FULL PICTURE'}</p><h2>{pl ? 'Podążaj za powiązaniami.' : 'Follow the connections.'}</h2></div><a class="primary-button" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${volume}&chapter=${chapterNumber}`}>{pl ? 'Otwórz mapę tego rozdziału' : 'Open the map at this chapter'} ↗</a></aside></> : <h1>{status === 503 ? (pl ? 'Rozdział jest chwilowo niedostępny' : 'Chapter temporarily unavailable') : (pl ? 'Nie znaleziono rozdziału' : 'Chapter not found')}</h1>}</main>
  <SiteFooter lang={lang} />
</Layout>
<style>
.chapter-page{padding-block:45px 95px}.chapter-page-hero{display:grid;grid-template-columns:1fr .7fr;gap:45px;align-items:center;padding:30px 0 55px}.chapter-page-hero h1{font:500 clamp(48px,6vw,78px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:20px 0}.chapter-page-book,.chapter-page-hero div>p:last-child{color:#53675a}.chapter-page-art{min-height:280px;background:#334b3d;border-radius:48% 48% 2px 2px;color:#e6c0a5;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px}.chapter-page-art span{font:500 100px 'Playfair Display',serif}.chapter-page-art small{font-size:10px;letter-spacing:.15em}.chapter-page-notice{padding:20px 24px;background:#e9e5d9;border-left:3px solid #a35e3e;line-height:1.6;font-size:14px}.chapter-turn{margin-top:55px;background:#293f34;color:#f6f4ed;display:grid;grid-template-columns:1fr 2fr}.chapter-turn-intro{padding:30px}.chapter-turn-intro p,.chapter-turn-pages small{font-size:10px;font-weight:700;letter-spacing:.12em;color:#f0c3a5}.chapter-turn-intro h2{font:500 32px/1.15 'Playfair Display',serif;margin:15px 0}.chapter-turn-intro>span{display:block;font-size:13px;line-height:1.6;color:#e0e9de}.chapter-turn-pages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.chapter-turn-pages>a,.chapter-turn-current,.chapter-turn-empty{border-left:1px solid #789181;padding:30px 20px;display:flex;flex-direction:column;gap:12px;justify-content:center}.chapter-turn-pages strong{font:500 23px/1.2 'Playfair Display',serif}.chapter-turn-pages span{font-size:12px;color:#e0e9de}.chapter-turn-current{background:#e5d8c9;color:#293f34}.chapter-turn-current small{color:#87452c}.chapter-turn-current span{color:#405448}.chapter-turn-pages a:hover{background:#3c5948}.chapter-turn-pages a:focus-visible{outline:3px solid #f0c3a5;outline-offset:-5px}@media(max-width:760px){.chapter-turn{grid-template-columns:1fr}.chapter-turn-pages>a,.chapter-turn-current,.chapter-turn-empty{padding:20px 14px;border-top:1px solid #789181}.chapter-turn-pages strong{font-size:18px}.chapter-turn-pages small{font-size:9px}}.chapter-page-section{margin-top:60px}.chapter-page-events{list-style:none;padding:0;margin:0}.chapter-page-events li{display:grid;grid-template-columns:60px 1fr;gap:24px;border-bottom:1px solid #d9ddd3;padding:24px 0}.chapter-page-events li>span{color:#a35e3e;font-size:12px}.chapter-page-events h3{font:500 25px 'Playfair Display',serif;margin:0}.chapter-page-events p,.chapter-page-links span{line-height:1.7;color:#53675a}.chapter-page-links a{display:grid;grid-template-columns:1fr 2fr auto;gap:20px;padding:22px 0;border-bottom:1px solid #d9ddd3;align-items:center}.chapter-page-links strong{font:500 24px 'Playfair Display',serif}.chapter-page-relations{list-style:none;padding:0;margin:0}.chapter-page-relations li{display:grid;grid-template-columns:minmax(0,1fr) minmax(120px,.7fr) minmax(0,1fr);align-items:stretch;background:#334b3d;color:#f6f4ed;margin-top:16px}.relation-person{padding:28px;display:flex;flex-direction:column;gap:16px;min-width:0}.relation-person>span{font-size:10px;font-weight:700;letter-spacing:.12em;color:#f1c5ab}.relation-person a{font:500 clamp(22px,2.8vw,32px)/1.2 'Playfair Display',serif;overflow-wrap:anywhere;text-decoration:underline;text-decoration-color:#91a696;text-underline-offset:6px}.relation-person a:hover{text-decoration-color:#f1c5ab}.relation-person a:focus-visible,.relation-map-link:focus-visible{outline:3px solid #f1c5ab;outline-offset:4px}.relation-direction{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:8px;border-inline:1px solid #789181;padding:20px;color:#f1c5ab;font-size:13px}.relation-direction b{font-size:30px;font-weight:400}.relation-map-link{display:inline-block;margin-top:24px;font-size:14px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.chapter-page-cta{background:#e1e8dc;padding:35px;margin-top:70px;display:flex;justify-content:space-between;align-items:end;gap:25px}.chapter-page-cta h2{font:500 clamp(30px,3vw,42px) 'Playfair Display',serif;margin:12px 0 0}@media(max-width:760px){.chapter-page{padding-block:30px 65px}.chapter-page-hero{grid-template-columns:1fr;gap:20px}.chapter-page-art{min-height:180px}.chapter-page-art span{font-size:70px}.chapter-page-events li{grid-template-columns:35px 1fr;gap:12px}.chapter-page-links a{grid-template-columns:1fr auto}.chapter-page-links a span:nth-child(2){grid-column:1/-1;grid-row:2}.chapter-page-relations li{grid-template-columns:1fr}.relation-person{padding:22px}.relation-direction{border-inline:0;border-block:1px solid #789181;padding:12px;flex-direction:row}.relation-direction b{transform:rotate(90deg)}.chapter-page-cta{display:block;padding:25px}.chapter-page-cta .primary-button{margin-top:22px}}
</style>
