---
import SiteFooter from '../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ChapterSource from '../../../components/ChapterSource.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug } = Astro.params;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const openingImages = {
  'alices-adventures-in-wonderland': '/images/alice-rabbit-hole.webp',
  'a-christmas-carol': '/images/christmas-carol-opening.webp',
};
const openingImage = openingImages[slug || ''];
let book, story, chapter;
let status = 200;
try {
  const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 ? 404 : 503;
  else {
    const data = await response.json(); book = data.book; story = data.story;
    chapter = book.chapters.find((item) => item.volume === data.progress.volume && item.chapter === data.progress.chapter);
    if (!chapter) status = 404;
  }
} catch { status = 503; }
Astro.response.status = status;
const title = chapter ? `${chapter.title} - ${book.title} - Castellation` : (pl ? 'Początek historii - Castellation' : 'The beginning - Castellation');
const description = chapter ? (pl ? `Poznaj wydarzenia i bohaterów rozdziału ${chapter.title} z ${book.title}.` : `Explore the events and characters in ${chapter.title} from ${book.title}.`) : '';
---
<Layout title={title} description={description} lang={lang} noindex={!chapter}>
  <SiteHeader lang={lang} />
  <main class="wrap opening-page">{chapter ? <><Breadcrumbs lang={lang} structured={true} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: chapter.title }]} /><section class:list={["opening-hero", { "has-opening-image": openingImage }]}><div class="opening-intro"><p class="eyebrow">✦ {pl ? 'NA POCZĄTKU HISTORII' : 'AT THE BEGINNING OF THE STORY'}</p><p class="opening-book">{book.title} / {book.author}</p><h1>{chapter.title}</h1><p class="opening-chapter">{pl ? 'Tom' : 'Volume'} {chapter.volume} · {pl ? 'Rozdział' : 'Chapter'} {chapter.chapter}</p><a class="opening-map-link" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${chapter.volume}&chapter=${chapter.chapter}`}>{pl ? 'Zobacz mapę tego rozdziału' : 'See the map for this chapter'} <span aria-hidden="true">↗</span></a></div>{openingImage && <div class="opening-visual" aria-hidden="true"><img src={openingImage} alt="" width="1200" height="800" /><span>{pl ? 'PIERWSZY ROZDZIAŁ' : 'THE FIRST CHAPTER'} / 01</span></div>}</section><div class="opening-note">✦ {pl ? 'Ta strona zawiera informacje z tego rozdziału.' : 'This page contains details from this chapter.'}</div>
  <div class="chapter-briefing"><section class="opening-events" aria-labelledby="opening-events-title"><div class="chapter-briefing-head"><h2 id="opening-events-title">{pl ? 'Co się wydarza' : 'What happens'}</h2><span>{String(story.events.length).padStart(2, '0')}</span></div>{story.events.length ? <ol>{story.events.map((event, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{event.title}</h3><p>{event.description}</p></div></li>)}</ol> : <p class="empty-state">{pl ? 'Brak dostępnych wydarzeń.' : 'No events are available yet.'}</p>}</section><section class="opening-cast" aria-labelledby="opening-cast-title"><div class="chapter-briefing-head"><h2 id="opening-cast-title">{pl ? 'Poznaj bohaterów' : 'Meet the characters'}</h2><span>{String(story.characters.length).padStart(2, '0')}</span></div><div class="opening-cast-list">{story.characters.map((character) => <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(character.slug)}?lang=${lang}&volume=${chapter.volume}&chapter=${chapter.chapter}`}><span aria-hidden="true">{character.name.slice(0, 1)}</span><strong>{character.name}</strong><span aria-hidden="true">↗</span></a>)}</div>{story.characters.length === 0 && <p>{pl ? 'Brak dostępnych postaci.' : 'No characters are available yet.'}</p>}</section></div><ChapterSource slug={slug} volume={chapter.volume} chapter={chapter.chapter} lang={lang} /></> : <h1>{status === 503 ? (pl ? 'Historia jest chwilowo niedostępna' : 'Story temporarily unavailable') : (pl ? 'Nie znaleziono rozdziału' : 'Chapter not found')}</h1>}</main>
  <SiteFooter lang={lang} />
</Layout>

<style>
.opening-page{padding-top:35px}.opening-hero{grid-template-columns:minmax(0,1fr) auto;gap:30px;align-items:end;padding:22px 0 28px}.opening-book{margin:18px 0 10px}.opening-hero h1{font-size:clamp(42px,5vw,66px);letter-spacing:-.035em}.opening-chapter{margin:16px 0 0}.opening-map-link{display:flex;justify-content:space-between;gap:26px;align-items:center;background:#283e34;color:#fff;min-height:56px;padding:16px 20px;font-size:13px;font-weight:700}.opening-map-link:hover{background:#3d5a49}.opening-map-link:focus-visible{outline:3px solid #bc6f42;outline-offset:4px}.opening-note{padding:13px 0}.chapter-briefing{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(250px,.7fr);margin-top:28px;background:#e8eee3}.opening-events,.opening-cast{padding:34px}.opening-events{background:#334b3d;color:#f6f4ed}.opening-cast{min-width:0}.chapter-briefing-head{display:flex;align-items:baseline;justify-content:space-between;gap:15px;border-bottom:1px solid #aebfb0;padding-bottom:16px}.chapter-briefing-head h2{font:500 clamp(26px,2.8vw,36px)/1.15 'Playfair Display',serif;margin:0}.chapter-briefing-head>span{font-size:11px;letter-spacing:.1em}.opening-events ol{margin:0}.opening-events li{grid-template-columns:42px minmax(0,1fr);gap:12px;border-color:#819a86;padding:30px 0}.opening-events li>span{color:#f1c5ab}.opening-events h3{font-size:clamp(26px,3vw,38px);line-height:1.2}.opening-events li p{color:#f6f4ed;line-height:1.7;margin-bottom:0}.opening-events .empty-state{color:#f6f4ed}.opening-cast-list{grid-template-columns:1fr;gap:0;margin:0}.opening-cast-list a{background:transparent;border-bottom:1px solid #b6c6b6;padding:18px 0;min-height:72px}.opening-cast-list a:hover{background:#d9e5d7}.opening-cast-list a:focus-visible{outline:3px solid #a35e3e;outline-offset:3px}.opening-cast-list a>span:first-child{width:40px;flex:none;font-size:30px}.opening-cast-list strong{font-size:21px;overflow-wrap:anywhere}.opening-cast>p{line-height:1.6;color:#405448}@media(max-width:760px){.opening-page{padding-top:24px}.opening-hero{grid-template-columns:1fr;gap:20px;padding:18px 0 24px}.opening-hero h1{font-size:42px}.opening-map-link{width:100%}.chapter-briefing{grid-template-columns:1fr;margin-top:20px}.opening-events,.opening-cast{padding:25px}.opening-events li{grid-template-columns:28px minmax(0,1fr);padding:24px 0}.opening-events h3{font-size:27px}}
</style>

<style>
.opening-hero.has-opening-image{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);align-items:stretch;gap:0;padding:0;margin-top:20px;background:#30463a;color:#f6f4ed;overflow:hidden}.has-opening-image .opening-intro{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:clamp(28px,5vw,64px)}.has-opening-image .eyebrow,.has-opening-image .opening-chapter{color:#f2c9af}.has-opening-image .opening-book{color:#e0e9dd;line-height:1.6}.has-opening-image h1{font:500 clamp(43px,5vw,70px)/1.04 'Playfair Display',serif;letter-spacing:-.04em;margin:8px 0;overflow-wrap:anywhere}.has-opening-image .opening-map-link{margin-top:28px;background:#f0d0b8;color:#263a30;min-width:min(100%,270px)}.has-opening-image .opening-map-link:hover{background:#fff0df}.opening-visual{position:relative;min-height:350px}.opening-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.opening-visual span{position:absolute;right:18px;bottom:18px;background:#30463a;color:#fff;padding:10px 12px;font-size:10px;font-weight:700;letter-spacing:.1em}.opening-hero:not(.has-opening-image) .opening-intro{display:flex;flex-direction:column;align-items:flex-start}.opening-hero:not(.has-opening-image) .opening-map-link{margin-top:24px}@media(max-width:760px){.opening-hero.has-opening-image{grid-template-columns:1fr;margin-top:15px}.has-opening-image .opening-intro{padding:30px 25px}.has-opening-image h1{font-size:clamp(38px,10vw,56px)}.has-opening-image .opening-map-link{width:100%}.opening-visual{min-height:220px;aspect-ratio:16/9}}
</style>
