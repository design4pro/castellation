---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ChapterSource from '../../../components/ChapterSource.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug } = Astro.params;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
let book, story, chapter;
let status = 200;
try {
  const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 ? 404 : 503;
  else {
    const data = await response.json(); book = data.book; story = data.story;
    chapter = book.chapters.find((item) => item.volume === data.progress.volume && item.chapter === data.progress.chapter);
    if (!chapter) status = 404;
  }
} catch { status = 503; }
Astro.response.status = status;
const title = chapter ? `${chapter.title} - ${book.title} - Castellation` : (pl ? 'Początek historii - Castellation' : 'The beginning - Castellation');
const description = chapter ? (pl ? `Poznaj wydarzenia i bohaterów rozdziału ${chapter.title} z ${book.title}.` : `Explore the events and characters in ${chapter.title} from ${book.title}.`) : '';
---
<Layout title={title} description={description} lang={lang} noindex={!chapter}>
  <SiteHeader lang={lang} />
  <main class="wrap opening-page">{chapter ? <><Breadcrumbs lang={lang} structured={true} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: book.title, href: `/books/${encodeURIComponent(slug || '')}?lang=${lang}` }, { label: chapter.title }]} /><section class="opening-hero"><div><p class="eyebrow">✦ {pl ? 'NA POCZĄTKU HISTORII' : 'AT THE BEGINNING OF THE STORY'}</p><p class="opening-book">{book.title} / {book.author}</p><h1>{chapter.title}</h1><p class="opening-chapter">{pl ? 'Tom' : 'Volume'} {chapter.volume} · {pl ? 'Rozdział' : 'Chapter'} {chapter.chapter}</p></div><div class="opening-symbol" aria-hidden="true">✳</div></section><div class="opening-note">✦ {pl ? 'Ta strona zawiera informacje z tego rozdziału.' : 'This page contains details from this chapter.'}</div>
  <section class="opening-events"><div class="collection-bar"><h2>{pl ? 'Co się wydarza' : 'What happens'}</h2><span>{String(story.events.length).padStart(2, '0')}</span></div>{story.events.length ? <ol>{story.events.map((event, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{event.title}</h3><p>{event.description}</p></div></li>)}</ol> : <p class="empty-state">{pl ? 'Brak dostępnych wydarzeń.' : 'No events are available yet.'}</p>}</section>
  <section class="opening-cast"><div class="collection-bar"><h2>{pl ? 'Poznaj bohaterów' : 'Meet the characters'}</h2><span>{String(story.characters.length).padStart(2, '0')}</span></div><div class="opening-cast-list">{story.characters.map((character) => <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(character.slug)}?lang=${lang}`}><span aria-hidden="true">{character.name.slice(0, 1)}</span><strong>{character.name}</strong><span aria-hidden="true">↗</span></a>)}</div></section><ChapterSource slug={slug} volume={chapter.volume} chapter={chapter.chapter} lang={lang} /><div class="opening-next"><p>{pl ? 'Czytasz dalej? Odkrywaj historię we własnym tempie.' : 'Reading on? Explore the story at your own pace.'}</p><a class="primary-button" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}`}>{pl ? 'Otwórz mapę historii' : 'Open the story map'} ↗</a></div></> : <h1>{status === 503 ? (pl ? 'Historia jest chwilowo niedostępna' : 'Story temporarily unavailable') : (pl ? 'Nie znaleziono rozdziału' : 'Chapter not found')}</h1>}</main>
  <footer class="wrap footer"><a class="brand" href={`/?lang=${lang}`}>✳ castellation<span class="brand-dot">.</span></a><p>{pl ? 'Historie są lepsze, gdy widzisz ich powiązania.' : 'Stories are better when you see the connections.'}</p><span>© {new Date().getFullYear()} CASTELLATION</span></footer>
</Layout>
