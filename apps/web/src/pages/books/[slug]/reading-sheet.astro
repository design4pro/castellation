---
import SiteHeader from '../../../components/SiteHeader.astro';
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const { slug } = Astro.params;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const volume = Astro.url.searchParams.get('volume'), chapter = Astro.url.searchParams.get('chapter');
const hasProgress = volume !== null || chapter !== null;
const query = hasProgress ? `?volume=${encodeURIComponent(volume ?? '')}&chapter=${encodeURIComponent(chapter ?? '')}` : '';
let data, status = 200;
try {
  const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}${query}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 || response.status === 400 ? 404 : 503;
  else data = await response.json();
} catch { status = 503; }
Astro.response.status = status;
const characters = data?.story.characters || [];
const relations = data ? data.story.relations.map((relation) => ({ ...relation, fromCharacter: characters.find((character) => character.id === relation.from), toCharacter: characters.find((character) => character.id === relation.to) })).filter((relation) => relation.fromCharacter && relation.toCharacter) : [];
const title = data ? (pl ? `Karta bohaterów do druku - ${data.book.title} - Castellation` : `${data.book.title} printable character sheet - Castellation`) : (pl ? 'Karta czytelnika - Castellation' : 'Reading sheet - Castellation');
const description = data ? (pl ? `Karta postaci i relacji z ${data.book.title} do wybranego rozdziału, gotowa do druku.` : `A printable character and relationship sheet for ${data.book.title}, limited to your selected chapter.`) : '';
---
<Layout lang={lang} title={title} description={description} noindex={!data || hasProgress}>
  <SiteHeader lang={lang} />
  <main class="wrap reading-sheet">{data ? <><header class="sheet-header"><div><p class="sheet-kicker">✳ CASTELLATION / {pl ? 'KARTA CZYTELNIKA' : 'READING SHEET'}</p><h1>{data.book.title}</h1><p>{data.book.author}</p></div><div class="sheet-scope"><strong>{pl ? 'Zakres lektury' : 'Reading boundary'}</strong><span>{pl ? 'Tom' : 'Volume'} {data.progress.volume} · {pl ? 'Rozdział' : 'Chapter'} {data.progress.chapter}</span></div></header><div class="sheet-notice">{pl ? 'Karta zawiera informacje do wskazanego rozdziału. Numery rozdziałów mogą różnić się między wydaniami.' : 'This sheet contains information up to the selected chapter. Chapter numbering may differ between editions.'}</div><div class="sheet-actions"><button id="print-sheet" type="button" hidden>{pl ? 'Drukuj kartę' : 'Print this sheet'} ↗</button><a href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}&volume=${data.progress.volume}&chapter=${data.progress.chapter}`}>{pl ? 'Wróć do mapy' : 'Return to the map'} ↗</a></div><div class="sheet-workspace"><div class="sheet-reference"><section class="sheet-section"><h2>{pl ? 'Postacie' : 'Characters'} <span>{String(characters.length).padStart(2, '0')}</span></h2><ul class="sheet-characters">{characters.map((character) => <li><a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(character.slug)}?lang=${lang}&volume=${data.progress.volume}&chapter=${data.progress.chapter}`}><span class="sheet-character-initial" aria-hidden="true">{character.name.slice(0, 1)}</span><span class="sheet-character-copy"><strong>{character.name}</strong><span>{character.descriptions.at(-1)?.text}</span></span><span class="sheet-character-arrow" aria-hidden="true">↗</span></a></li>)}</ul></section><section class="sheet-section"><h2>{pl ? 'Relacje' : 'Connections'} <span>{String(relations.length).padStart(2, '0')}</span></h2>{relations.length ? <ul class="sheet-relations">{relations.map((relation) => <li><strong>{relation.fromCharacter.name}</strong><span>{relation.label} →</span><strong>{relation.toCharacter.name}</strong></li>)}</ul> : <p>{pl ? 'Brak widocznych relacji na tym etapie.' : 'No connections are visible at this point.'}</p>}</section></div><section class="sheet-notes" data-slug={slug} data-volume={data.progress.volume} data-chapter={data.progress.chapter} data-lang={lang}><h2>{pl ? 'Moje notatki' : 'My notes'}</h2><p id="sheet-notes-help">{pl ? 'Zapisuj pytania i spostrzeżenia dla tego rozdziału. Notatki pozostają w tej przeglądarce i nie synchronizują się z kontem.' : 'Keep questions and observations for this chapter. Notes stay in this browser and do not sync to your account.'}</p><div id="sheet-notes-editor" hidden><div class="note-prompts"><p>{pl ? 'ZACZNIJ OD PYTANIA' : 'START WITH A QUESTION'}</p><div><button type="button" data-note-prompt={pl ? 'Która postać mnie zaskoczyła?' : 'Which character surprised me?'}>{pl ? 'Która postać mnie zaskoczyła?' : 'Which character surprised me?'}</button><button type="button" data-note-prompt={pl ? 'Która relacja przyciągnęła moją uwagę?' : 'Which connection caught my attention?'}>{pl ? 'Która relacja przyciągnęła moją uwagę?' : 'Which connection caught my attention?'}</button><button type="button" data-note-prompt={pl ? 'Do której sceny chcę wrócić?' : 'Which scene do I want to revisit?'}>{pl ? 'Do której sceny chcę wrócić?' : 'Which scene do I want to revisit?'}</button></div></div><label for="sheet-note">{pl ? 'Notatki do rozdziału' : 'Notes for this chapter'}</label><textarea id="sheet-note" aria-describedby="sheet-notes-help sheet-notes-status" maxlength="3000" rows="9"></textarea><p id="sheet-notes-status" role="status"></p></div><p id="sheet-notes-fallback">{pl ? 'Aby pisać na stronie, włącz JavaScript. Możesz też wydrukować puste linie.' : 'Enable JavaScript to write here, or print the blank lines.'}</p><div id="sheet-print-note" aria-hidden="true"></div></section></div><p class="sheet-credit">✳ CASTELLATION / {pl ? 'TWOJE HISTORIE, TWOJE TEMPO' : 'YOUR STORIES, YOUR PACE'}</p></> : <h1>{status === 503 ? (pl ? 'Karta jest chwilowo niedostępna' : 'Reading sheet temporarily unavailable') : (pl ? 'Nie znaleziono tego zakresu lektury' : 'Reading position not found')}</h1>}</main>
  <script>
    const printButton = document.querySelector<HTMLButtonElement>('#print-sheet');
    if (printButton) { printButton.hidden = false; printButton.addEventListener('click', () => window.print()); }
    const notes = document.querySelector<HTMLElement>('.sheet-notes');
    const editor = document.querySelector<HTMLElement>('#sheet-notes-editor');
    const field = document.querySelector<HTMLTextAreaElement>('#sheet-note');
    const printed = document.querySelector<HTMLElement>('#sheet-print-note');
    const status = document.querySelector<HTMLElement>('#sheet-notes-status');
    if (notes && editor && field && printed && status) {
      const pl = notes.dataset.lang === 'pl';
      const key = `castellation:reading-note:${notes.dataset.slug}:${notes.dataset.volume}:${notes.dataset.chapter}`;
      const saved = pl ? 'Zapisano w tej przeglądarce.' : 'Saved in this browser.';
      const failed = pl ? 'Nie udało się zapisać notatki w tej przeglądarce.' : 'Could not save the note in this browser.';
      editor.hidden = false;
      notes.classList.add('notes-enabled');
      try { field.value = localStorage.getItem(key) || ''; status.textContent = field.value ? saved : ''; }
      catch { status.textContent = failed; }
      const update = () => {
        printed.textContent = field.value;
        try { localStorage.setItem(key, field.value); if (status.textContent !== saved) status.textContent = saved; }
        catch { if (status.textContent !== failed) status.textContent = failed; }
      };
      printed.textContent = field.value;
      field.addEventListener('input', update);
      editor.querySelectorAll<HTMLButtonElement>('[data-note-prompt]').forEach((button) => {
        button.addEventListener('click', () => {
          const prompt = button.dataset.notePrompt || '';
          const addition = `${field.value ? '\n\n' : ''}${prompt}\n`;
          if (field.value.length + addition.length > field.maxLength) {
            status.textContent = pl ? 'Brakuje miejsca na pytanie w tej notatce.' : 'There is not enough room for this question.';
            return;
          }
          field.value += addition;
          update();
          field.focus();
          field.setSelectionRange(field.value.length, field.value.length);
        });
      });
      window.addEventListener('beforeprint', () => { printed.textContent = field.value; });
    }
  </script>
</Layout>
<style>
.reading-sheet{padding-block:65px 100px;max-width:1050px}.sheet-header{display:flex;align-items:end;justify-content:space-between;gap:30px;border-bottom:2px solid #334b3d;padding-bottom:30px}.sheet-kicker{font-size:10px;letter-spacing:.15em;font-weight:700;color:#985438}.sheet-header h1{font:500 clamp(40px,5vw,66px)/1.1 'Playfair Display',serif;letter-spacing:-.04em;margin:20px 0 12px}.sheet-header p:not(.sheet-kicker){color:#53675a}.sheet-scope{display:flex;flex-direction:column;gap:8px;border-left:3px solid #a35e3e;padding-left:18px;font-size:13px;white-space:nowrap}.sheet-notice{background:#e9e5d9;padding:18px 22px;margin-top:25px;font-size:13px;line-height:1.6;color:#405448}.sheet-actions{display:flex;align-items:center;flex-wrap:wrap;gap:25px;margin:25px 0 50px}.sheet-actions button{background:#334b3d;color:white;border:0;padding:16px 20px;font-weight:700;cursor:pointer}.sheet-actions a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:4px}.sheet-section{margin-top:45px}.sheet-section h2,.sheet-notes h2{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid #aab8a8;padding-bottom:15px;font:500 30px 'Playfair Display',serif}.sheet-section h2 span{font:700 11px 'DM Sans',sans-serif;color:#53675a}.sheet-characters,.sheet-relations{list-style:none;margin:0;padding:0}.sheet-characters li{display:grid;grid-template-columns:1fr 2fr;gap:25px;padding:18px 0;border-bottom:1px solid #d9ddd3}.sheet-characters strong{font:500 22px 'Playfair Display',serif}.sheet-characters span{font-size:14px;line-height:1.6;color:#405448}.sheet-relations li{display:flex;flex-wrap:wrap;gap:12px;padding:16px 0;border-bottom:1px solid #d9ddd3;font-size:14px}.sheet-relations span{color:#985438}.sheet-notes{margin-top:55px}.sheet-notes p{font-size:13px;color:#53675a}.sheet-notes div{height:150px;background:repeating-linear-gradient(to bottom,transparent 0,transparent 36px,#cbd5c9 37px)}.sheet-credit{margin-top:45px;font-size:10px;letter-spacing:.14em;color:#53675a}@media(max-width:760px){.reading-sheet{padding-block:40px 70px}.sheet-header{display:block}.sheet-scope{margin-top:25px}.sheet-characters li{grid-template-columns:1fr;gap:8px}}@media print{:global(.site-header){display:none!important}:global(body){background:white;color:black}.reading-sheet{width:100%;max-width:none;padding:0}.sheet-header h1{font-size:34px}.sheet-actions{display:none}.sheet-notice{background:white;border-left:2px solid black;padding:8px 12px}.sheet-section{margin-top:25px}.sheet-characters li,.sheet-relations li{break-inside:avoid;padding:10px 0}.sheet-notes{margin-top:30px}.sheet-notes div{border-bottom:1px solid #aaa}.sheet-credit{margin-top:25px}}
</style>

<style>
.sheet-workspace{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:35px;align-items:start}.sheet-reference .sheet-section:first-child{margin-top:0}.sheet-notes{background:#e2eade;padding:28px;margin:0}.sheet-notes h2{margin:0 0 16px}.sheet-notes p{line-height:1.6;margin:0 0 16px}.sheet-notes label{display:block;font-size:13px;font-weight:700;margin:22px 0 10px}.sheet-notes textarea{display:block;width:100%;min-height:220px;resize:vertical;padding:15px;background:#f8f8f1;border:1px solid #9aaf9d;color:#27352f;font:16px/1.6 'DM Sans',sans-serif}.sheet-notes textarea:focus-visible{outline:3px solid #a35e3e;outline-offset:3px}.sheet-notes #sheet-notes-status{min-height:1.5em;margin:10px 0 0;font-size:12px}.sheet-notes #sheet-notes-editor{height:auto;background:none}.sheet-notes #sheet-notes-editor[hidden]{display:none}.sheet-notes #sheet-print-note{display:block;margin-top:20px;height:150px;background:repeating-linear-gradient(to bottom,transparent 0,transparent 36px,#9fb2a0 37px)}.sheet-notes.notes-enabled #sheet-print-note,.sheet-notes.notes-enabled #sheet-notes-fallback{display:none}@media(max-width:760px){.sheet-workspace{grid-template-columns:1fr;gap:35px}.sheet-notes{padding:24px}}@media print{.sheet-workspace{display:block}.sheet-reference .sheet-section{margin-top:25px}.sheet-notes{background:white;padding:0;margin-top:30px;break-inside:avoid}.sheet-notes #sheet-notes-editor,.sheet-notes #sheet-notes-fallback{display:none!important}.sheet-notes #sheet-print-note,.sheet-notes.notes-enabled #sheet-print-note{display:block;white-space:pre-wrap;overflow-wrap:anywhere;min-height:150px;height:auto;background:none;color:black;font-size:12pt;line-height:1.6}.sheet-notes #sheet-print-note:empty{height:150px;background:repeating-linear-gradient(to bottom,transparent 0,transparent 36px,#aaa 37px)}}
</style>

<style>
.sheet-characters{display:grid;gap:12px}.sheet-characters li{display:block;border:0;padding:0}.sheet-characters a{display:grid;grid-template-columns:58px minmax(0,1fr) auto;gap:16px;align-items:start;background:#e7ede3;padding:18px;min-height:100px}.sheet-characters li:nth-child(even) a{background:#eee5d9}.sheet-character-initial{width:58px;height:58px;display:grid;place-items:center;border-radius:50%;background:#334b3d;color:white!important;font:500 29px 'Playfair Display',serif!important}.sheet-character-copy{display:flex;flex-direction:column;gap:7px;min-width:0}.sheet-character-copy strong{overflow-wrap:anywhere}.sheet-character-arrow{font-size:20px!important;color:#87452c!important}.sheet-characters a:hover strong{text-decoration:underline;text-underline-offset:4px}.sheet-characters a:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}@media(max-width:760px){.sheet-characters a{grid-template-columns:48px minmax(0,1fr) auto;gap:12px;padding:15px}.sheet-character-initial{width:48px;height:48px;font-size:24px!important}}@media print{.sheet-characters{display:block}.sheet-characters li{border-bottom:1px solid #aaa}.sheet-characters a{display:grid;grid-template-columns:1fr 2fr;gap:20px;background:white!important;padding:10px 0;min-height:0;color:black}.sheet-character-initial,.sheet-character-arrow{display:none}.sheet-character-copy{display:contents}.sheet-character-copy span{color:black}}
</style>

<style>.sheet-notes .note-prompts{height:auto;background:none;margin:22px 0 0}.sheet-notes .note-prompts>p{font-size:10px;font-weight:700;letter-spacing:.12em;color:#87452c}.sheet-notes .note-prompts>div{height:auto;background:none;display:grid;gap:8px}.note-prompts button{text-align:left;border:1px solid #9aaf9d;background:#f8f8f1;color:#27352f;padding:12px 14px;font:500 15px/1.4 'DM Sans',sans-serif;cursor:pointer}.note-prompts button:hover{background:#d2dfcf}.note-prompts button:focus-visible{outline:3px solid #a35e3e;outline-offset:3px}</style>
