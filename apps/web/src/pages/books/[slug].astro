---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SharePanel from '../../components/SharePanel.astro';
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const slug = Astro.params.slug;
const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
let book, story;
let status = 200;
try {
  const url = `${api}/api/books/${encodeURIComponent(slug || '')}`;
  const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
  if (!response.ok) status = response.status === 404 ? 404 : 503;
  else { const data = await response.json(); book = data.book; story = data.story; }
} catch { status = 503; }
Astro.response.status = status;
const title = book?.title || 'Book';
const pl = lang === 'pl';
const laterChapterPages = book ? (await Promise.all(book.positions.slice(1).map(async (position) => {
  try {
    const url = `${api}/api/books/${encodeURIComponent(slug || '')}?volume=${position.volume}&chapter=${position.chapter}`;
    const response = import.meta.env.PUBLIC_API_URL ? await fetch(url) : await env.API.fetch(new Request(url));
    if (!response.ok) return null;
    const data = await response.json();
    return data.story.events.some((event) => event.volume === position.volume && event.chapter === position.chapter) ? { ...position, title: data.book.chapters.find((item) => item.volume === position.volume && item.chapter === position.chapter)?.title } : null;
  } catch { return null; }
}))).filter(Boolean) : [];
const firstPosition = book?.positions[0];
const chapterPages = book ? [
  ...(firstPosition && story.events.some((event) => event.volume === firstPosition.volume && event.chapter === firstPosition.chapter) ? [firstPosition] : []),
  ...laterChapterPages,
].map((position) => ({ ...position, title: position.title || book.chapters.find((item) => item.volume === position.volume && item.chapter === position.chapter)?.title })) : [];

---
<Layout title={`${title} - Castellation`} lang={lang} description={book ? (pl ? `Odkryj bohaterów i relacje w ${title} - ${book.author}. Przeglądaj mapę historii we własnym tempie.` : `Explore the characters and connections in ${title} by ${book.author}, at your own reading pace.`) : ''} noindex={!book || Astro.url.searchParams.has('volume') || Astro.url.searchParams.has('chapter')}>
  <SiteHeader lang={lang} />
  <main class="wrap book-page"><Breadcrumbs lang={lang} structured={!!book && !Astro.url.searchParams.has('volume') && !Astro.url.searchParams.has('chapter')} items={[{ label: pl ? 'Biblioteka' : 'Library', href: `/library?lang=${lang}` }, { label: title }]} />{book ? <><section class="book-opening"><div class="book-opening-copy"><p class="eyebrow">✦ {pl ? 'WEJDŹ DO HISTORII' : 'STEP INSIDE THE STORY'}</p><h1 id="book-title">{title}</h1><p class="book-byline"><a class="author-link" href={`/authors/${encodeURIComponent(book.author)}?lang=${lang}`} id="book-author">{book.author}</a></p><p class="book-opening-intro">{pl ? 'Poznaj bohaterów i odkrywaj ich powiązania wraz z lekturą.' : 'Meet the characters and follow their connections as you read.'}</p><p><a class="guide-inline-link" href={`/how-it-works?lang=${lang}`}>{pl ? 'Jak to działa?' : 'How does it work?'} ↗</a></p><div class="book-opening-actions"><a class="primary-button" id="story-map" href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}`}>{pl ? 'Odkryj mapę' : 'Explore the map'} <span aria-hidden="true">↗</span></a><a class="cast-directory-link" href={`/books/${encodeURIComponent(slug || '')}/characters?lang=${lang}`}>{pl ? 'Poznaj bohaterów' : 'Meet the characters'} <span aria-hidden="true">↗</span></a>{story.relations.length > 0 && <a class="cast-directory-link" href={`/books/${encodeURIComponent(slug || '')}/connections?lang=${lang}`}>{pl ? 'Poznaj relacje' : 'Explore connections'} <span aria-hidden="true">↗</span></a>}</div></div><div class="book-opening-art">{['alices-adventures-in-wonderland', 'a-christmas-carol'].includes(book.slug) ? <><img class="story-illustration" src={book.slug === 'a-christmas-carol' ? '/images/christmas-carol-opening.webp' : '/images/alice-rabbit-hole.webp'} alt="" width="768" height="1152" /><span class="story-illustration-shade" aria-hidden="true"></span></> : <span class="book-opening-mark" aria-hidden="true">✳</span>}<span class="book-opening-label">{pl ? 'NA POCZĄTKU HISTORII' : 'AT THE BEGINNING'}</span>{story.events[0] && <><strong>{story.events[0].title}</strong><p>{story.events[0].description}</p>{book.chapters.some((item) => item.volume === book.positions[0]?.volume && item.chapter === book.positions[0]?.chapter) && <a class="opening-link" href={`/books/${encodeURIComponent(slug || '')}/opening?lang=${lang}`}>{pl ? 'Odkryj początek historii' : 'Explore the beginning'} ↗</a>}</>}</div></section>{book.positions.length > 0 && <section class="reading-entry" aria-labelledby="reading-entry-title"><div class="reading-entry-copy"><p class="eyebrow">✦ {pl ? 'TWOJA HISTORIA, TWOJE TEMPO' : 'YOUR STORY, YOUR PACE'}</p><h2 id="reading-entry-title">{pl ? 'Gdzie jesteś' : 'Where are you'}<br /><em>{pl ? 'w historii?' : 'in the story?'}</em></h2><p>{pl ? 'Wybierz przeczytany rozdział, aby zobaczyć mapę na tym etapie lektury.' : 'Choose the chapter you have read to see the map at your place in the story.'}</p></div><div class="reading-entry-action"><span class="reading-entry-symbol" aria-hidden="true">✳</span><form id="reading-entry-form" action={`/books/${encodeURIComponent(slug || '')}/map`} method="get"><fieldset class="reading-entry-choices"><legend>{pl ? 'Przeczytano do' : 'Read up to'}</legend><div>{book.positions.map((position, index) => <label class="reading-entry-choice"><input type="radio" name="position" value={`${position.volume}:${position.chapter}`} required checked={book.positions.length === 1 && index === 0} /><span><small>{pl ? 'TOM' : 'VOLUME'} {position.volume}</small><strong>{pl ? 'Rozdział' : 'Chapter'} {position.chapter}</strong></span></label>)}</div></fieldset><input type="hidden" name="lang" value={lang} /><input type="hidden" name="volume" /><input type="hidden" name="chapter" /><button class="reading-entry-submit" type="submit">{pl ? 'Otwórz mapę na tym etapie' : 'Open the map at this chapter'} <span aria-hidden="true">↗</span></button></form><noscript><p>{pl ? 'Wybór rozdziału wymaga JavaScript. Otwórz mapę, aby wybrać rozdział.' : 'Choosing a chapter here requires JavaScript. Open the map to choose your chapter.'}</p><a href={`/books/${encodeURIComponent(slug || '')}/map?lang=${lang}`}>{pl ? 'Otwórz mapę' : 'Open the map'} ↗</a><style>#reading-entry-form{display:none}</style></noscript></div></section>}{story.characters.length > 0 && <section class="book-cast-preview" aria-labelledby="book-cast-preview-title"><div class="book-cast-preview-head"><div><p class="eyebrow">✦ {pl ? 'POZNAJ BOHATERÓW' : 'MEET THE CHARACTERS'}</p><h2 id="book-cast-preview-title">{pl ? 'Pierwsze spotkania' : 'First encounters'}</h2></div><p>{pl ? 'Informacje do tomu' : 'Details through volume'} {book.positions[0].volume}, {pl ? 'rozdziału' : 'chapter'} {book.positions[0].chapter}.</p></div><div class="book-cast-preview-list">{story.characters.slice(0, 2).map((character) => <a href={`/books/${encodeURIComponent(slug || '')}/characters/${encodeURIComponent(character.slug)}?lang=${lang}`}><span class="book-cast-preview-initial" aria-hidden="true">{character.name.slice(0, 1)}</span><span class="book-cast-preview-copy"><strong>{character.name}</strong><span>{character.descriptions.at(-1)?.text}</span></span><span aria-hidden="true">↗</span></a>)}</div><p><a class="book-cast-preview-all" href={`/books/${encodeURIComponent(slug || '')}/reading-sheet?lang=${lang}`}>{pl ? 'Karta bohaterów do druku' : 'Printable character sheet'} ↗</a></p><a class="book-cast-preview-all" href={`/books/${encodeURIComponent(slug || '')}/characters?lang=${lang}`}>{pl ? 'Zobacz wszystkich dostępnych bohaterów' : 'See all available characters'} ↗</a></section>}{chapterPages.length > 0 && <section class="chapter-shelf" aria-labelledby="chapter-shelf-heading"><div><p class="eyebrow">✦ {pl ? 'CZYTAJ WE WŁASNYM TEMPIE' : 'READ AT YOUR OWN PACE'}</p><h2 id="chapter-shelf-heading">{pl ? 'Wybierz rozdział.' : 'Choose a chapter.'}</h2><p>{pl ? 'Wybierz przeczytany rozdział. Tytuły i przewodniki mogą ujawniać szczegóły opowieści.' : 'Choose a chapter you have read. Titles and guides may reveal story details.'}</p></div><ol>{chapterPages.map((item) => <li><a href={item.volume === firstPosition?.volume && item.chapter === firstPosition?.chapter ? `/books/${encodeURIComponent(slug || '')}/opening?lang=${lang}` : `/books/${encodeURIComponent(slug || '')}/chapters/${item.volume}-${item.chapter}?lang=${lang}`}><span class="chapter-shelf-number">{pl ? 'TOM' : 'VOLUME'} {item.volume} · {pl ? 'ROZDZIAŁ' : 'CHAPTER'} {item.chapter}</span><strong>{item.title || `${pl ? 'Rozdział' : 'Chapter'} ${item.chapter}`}</strong><span class="chapter-shelf-action">{pl ? 'Otwórz przewodnik' : 'Open chapter guide'} <span aria-hidden="true">↗</span></span></a></li>)}</ol></section>}<SharePanel lang={lang} url={new URL(`/books/${encodeURIComponent(slug || '')}?lang=${lang}`, Astro.url.origin).href} /></> : <h1>{status === 404 ? (pl ? 'Nie znaleziono książki' : 'Book not found') : (pl ? 'Książka jest chwilowo niedostępna' : 'Book temporarily unavailable')}</h1>}</main>
  <script>
    const entryForm = document.querySelector<HTMLFormElement>('#reading-entry-form');
    entryForm?.addEventListener('submit', () => {
      const selected = entryForm.querySelector<HTMLInputElement>('[name=position]:checked')!;
      const position = selected.value.split(':');
      selected.disabled = true;
      entryForm.querySelector<HTMLInputElement>('[name=volume]')!.value = position[0];
      entryForm.querySelector<HTMLInputElement>('[name=chapter]')!.value = position[1];
    });
    if (location.hash === '#story-map') location.replace(`${location.pathname.replace(/\/$/, '')}/map${location.search}`);
  </script>
</Layout>

<style>.chapter-shelf{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:40px;background:#e9e5d9;margin-bottom:70px}.chapter-shelf h2{font:500 clamp(32px,3vw,42px) 'Playfair Display',serif;margin:14px 0}.chapter-shelf p:not(.eyebrow){color:#53675a;line-height:1.7}.chapter-shelf ol{list-style:none;padding:0;margin:0}.chapter-shelf a{display:grid;grid-template-columns:1fr 1.4fr auto;gap:15px;align-items:center;padding:20px 0;border-bottom:1px solid #bdbfb4}.chapter-shelf a span:first-child{font-size:11px;color:#53675a}.chapter-shelf a strong{font:500 22px 'Playfair Display',serif}.chapter-shelf a:hover strong{text-decoration:underline;text-underline-offset:4px}@media(max-width:760px){.chapter-shelf{grid-template-columns:1fr;gap:10px;padding:25px;margin-bottom:45px}}</style>

<style>
.reading-entry{display:grid;grid-template-columns:1.1fr 1fr;background:#263d32;color:#f6f4ed;margin:10px 0 75px;overflow:hidden}.reading-entry-copy{padding:55px 55px 60px}.reading-entry-copy .eyebrow{color:#eac2a9}.reading-entry-copy h2{font:500 clamp(42px,5vw,68px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:22px 0}.reading-entry-copy h2 em{color:#e6b89d;font-weight:400}.reading-entry-copy>p:last-child{max-width:370px;color:#e1e9df;line-height:1.7;margin-bottom:0}.reading-entry-action{position:relative;background:#e0e8dc;color:#27352f;padding:48px;display:flex;align-items:end;min-width:0}.reading-entry-symbol{position:absolute;top:24px;right:34px;font-size:72px;color:#9eb6a2;line-height:1}.reading-entry-action form{width:100%;position:relative}.reading-entry-choices{border:0;padding:0;margin:0}.reading-entry-choices legend{font-weight:700;font-size:13px;margin-bottom:12px}.reading-entry-choices>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}.reading-entry-choice{position:relative;cursor:pointer}.reading-entry-choice input{position:absolute;opacity:0}.reading-entry-choice>span{display:flex;flex-direction:column;gap:8px;min-height:86px;padding:16px;border:1px solid #819886;background:#f6f4ed}.reading-entry-choice small{font-size:10px;font-weight:700;letter-spacing:.1em;color:#53675a}.reading-entry-choice strong{font:500 22px/1.2 'Playfair Display',serif}.reading-entry-choice input:checked+span{background:#334b3d;color:#fff;border-color:#334b3d}.reading-entry-choice input:checked+span small{color:#f0c3a5}.reading-entry-choice input:focus-visible+span{outline:3px solid #bc6f42;outline-offset:3px}.reading-entry-submit{margin-top:14px;width:100%;min-height:56px;border:0;background:#263d32;color:#fff;padding:16px 20px;display:flex;justify-content:space-between;gap:15px;text-align:left;font-weight:700;cursor:pointer}.reading-entry-submit:hover{background:#41614c}.reading-entry-submit:focus-visible{outline:3px solid #bc6f42;outline-offset:3px}.reading-entry-action noscript{line-height:1.6}.reading-entry-action noscript a{text-decoration:underline}@media(max-width:760px){.reading-entry{grid-template-columns:1fr;margin-bottom:50px}.reading-entry-copy{padding:32px 25px}.reading-entry-copy h2{font-size:42px;margin:16px 0}.reading-entry-action{padding:72px 25px 25px}.reading-entry-symbol{font-size:45px;top:18px;right:25px}}
</style>

<style>.chapter-shelf{background:#334b3d;color:#f6f4ed;align-items:start}.chapter-shelf .eyebrow{color:#f0c3a5}.chapter-shelf p:not(.eyebrow){color:#e1e9df}.chapter-shelf ol{display:grid;gap:10px}.chapter-shelf a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px 20px;background:#e5ece2;color:#27352f;padding:22px;border:0}.chapter-shelf .chapter-shelf-number{grid-column:1/-1;color:#87452c;font-size:10px;font-weight:700;letter-spacing:.1em}.chapter-shelf a strong{font:500 clamp(22px,2.4vw,30px)/1.15 'Playfair Display',serif;overflow-wrap:anywhere}.chapter-shelf .chapter-shelf-action{font-size:12px;font-weight:700;align-self:end}.chapter-shelf a:hover{background:#d0dfce}.chapter-shelf a:focus-visible{outline:3px solid #f0c3a5;outline-offset:4px}@media(max-width:760px){.chapter-shelf a{grid-template-columns:1fr}.chapter-shelf .chapter-shelf-number{grid-column:auto}}</style>
