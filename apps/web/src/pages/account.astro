---
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const signup = Astro.url.searchParams.get('mode') === 'signup';
const api = import.meta.env.PUBLIC_API_URL || Astro.url.origin;
---
<Layout title={pl ? 'Konto - Castellation' : 'Account - Castellation'} lang={lang} noindex={true}>
<SiteHeader lang={lang} />
<main class="wrap account-shell"><section class="account-story"><p class="eyebrow">✦ {pl ? 'CZYTAJ PO SWOJEMU' : 'READ AT YOUR OWN PACE'}</p><h1>{pl ? 'Twoja historia,' : 'Your story,'}<br /><em>{pl ? 'Twoje miejsce.' : 'your place.'}</em></h1><p>{pl ? 'Wybierz, jak chcesz wracać do swojej lektury.' : 'Choose how you want to return to your reading.'}</p><div class="account-options"><div><span class="account-option-number" aria-hidden="true">01</span><div><h2>{pl ? 'W tej przeglądarce' : 'In this browser'}</h2><p>{pl ? 'Korzystaj bez konta. Postęp jest zapisywany osobno na tym urządzeniu.' : 'Explore without an account. Progress is saved separately in this browser.'}</p><a class="account-guest" href={`/library?lang=${lang}`}>{pl ? 'Odkryj bibliotekę bez konta' : 'Explore without an account'} ↗</a></div></div><div><span class="account-option-number" aria-hidden="true">02</span><div><h2>{pl ? 'Na koncie' : 'With an account'}</h2><p>{pl ? 'Zapisuj postęp na koncie i wracaj do niego na innych urządzeniach. Lokalna kopia pozostaje osobna.' : 'Save progress to your account and return on other devices. Your browser copy stays separate.'}</p></div></div></div></section><section class="account-page" data-api={api} data-lang={lang}>
  <p class="eyebrow">CASTELLATION</p><h2>{signup ? (pl ? 'Utwórz konto' : 'Create your account') : (pl ? 'Zaloguj się' : 'Sign in')}</h2>
  <p class="muted">{signup ? (pl ? 'Zapisuj postęp i wracaj do historii na innych urządzeniach.' : 'Save your progress and return to your stories on other devices.') : (pl ? 'Wróć do zapisanego postępu czytania.' : 'Return to your saved reading progress.')}</p>
  <div id="signed-in" hidden><p id="account-email"></p><button id="sign-out" class="primary-button" type="button">{pl ? 'Wyloguj' : 'Sign out'}</button></div>
  <div id="auth-unavailable" class="auth-unavailable" hidden><p>{pl ? 'Usługa konta jest chwilowo niedostępna. Spróbuj ponownie lub przeglądaj bibliotekę bez konta.' : 'The account service is temporarily unavailable. Try again or explore the library without an account.'}</p><button id="auth-retry" class="secondary-button" type="button">{pl ? 'Spróbuj ponownie' : 'Try again'}</button></div>
  <form id="account-form" data-action={signup ? 'signup' : 'signin'} hidden>{signup && <><label for="account-name">{pl ? 'Imię' : 'Name'}</label><input id="account-name" name="name" autocomplete="name" required maxlength="100" /></>}<label for="account-email-input">E-mail</label><input id="account-email-input" name="email" type="email" autocomplete="email" required maxlength="254" /><label for="account-password">{pl ? 'Hasło - co najmniej 12 znaków' : 'Password - at least 12 characters'}</label><div class="account-password-field"><input id="account-password" name="password" type="password" autocomplete={signup ? 'new-password' : 'current-password'} required minlength="12" maxlength="128" aria-describedby={signup ? "password-requirement" : undefined} /><button id="password-visibility" type="button" aria-controls="account-password" aria-pressed="false">{pl ? 'Pokaż hasło' : 'Show password'}</button></div>{signup && <div class="signup-support"><div class="password-requirement"><span id="password-symbol" aria-hidden="true">○</span><div><strong>{pl ? 'Długość hasła' : 'Password length'}</strong><p id="password-requirement">{pl ? 'Co najmniej 12 znaków.' : 'At least 12 characters.'}</p></div><span id="password-count" aria-hidden="true">0 / 12</span></div><p id="password-feedback" role="status"></p><div class="signup-next"><span aria-hidden="true">↗</span><p>{pl ? 'Po utworzeniu konta sprawdź e-mail i potwierdź adres przed zalogowaniem.' : 'After creating your account, check your email and verify your address before signing in.'}</p></div></div>}<div class="account-actions"><button class="primary-button" type="submit">{signup ? (pl ? 'Utwórz konto' : 'Create account') : (pl ? 'Zaloguj' : 'Sign in')}</button></div>{!signup && <button id="forgot-password" class="secondary-button" type="button">{pl ? 'Nie pamiętam hasła' : 'Forgot password'}</button>}<p class="account-switch">{signup ? (pl ? 'Masz już konto?' : 'Already have an account?') : (pl ? 'Nie masz jeszcze konta?' : 'New to Castellation?')} <a href={signup ? `/account?lang=${lang}` : `/account?lang=${lang}&mode=signup`}>{signup ? (pl ? 'Zaloguj się' : 'Sign in') : (pl ? 'Utwórz konto' : 'Create an account')} ↗</a></p></form>
  <noscript><p>{pl ? 'Logowanie i rejestracja wymagają JavaScript.' : 'Sign-in and registration require JavaScript.'}</p></noscript>
  <p id="account-status" role="status"></p><p><a class="guide-inline-link" href={`/help?lang=${lang}#progress`}>{pl ? 'Pomoc: konto i postęp' : 'Help: account and progress'} ↗</a></p>
</section></main>
<script>
import { createAuthClient } from 'better-auth/client';
const root=document.querySelector<HTMLElement>('.account-page')!;
const api=root.dataset.api!, pl=root.dataset.lang==='pl';
const status=document.querySelector<HTMLElement>('#account-status')!;
const form=document.querySelector<HTMLFormElement>('#account-form')!;
const signed=document.querySelector<HTMLElement>('#signed-in')!;
const unavailable=document.querySelector<HTMLElement>('#auth-unavailable')!;
const auth=createAuthClient({baseURL:api,fetchOptions:{credentials:'include'}});
async function refresh(){
  form.hidden=true; signed.hidden=true; unavailable.hidden=true;
  try {
    const result=await auth.getSession();
    if(result.error) throw Error('Session unavailable');
    if(result.data?.user){signed.hidden=false;document.querySelector('#account-email')!.textContent=result.data.user.email;}
    else form.hidden=false;
  } catch { unavailable.hidden=false; }
}
const passwordField = document.querySelector<HTMLInputElement>('#account-password')!;
const passwordVisibility = document.querySelector<HTMLButtonElement>('#password-visibility')!;
passwordVisibility.addEventListener('click', () => {
  const visible = passwordField.type === 'password';
  passwordField.type = visible ? 'text' : 'password';
  passwordVisibility.setAttribute('aria-pressed', String(visible));
});
const requirement = document.querySelector<HTMLElement>('.password-requirement');
const count = document.querySelector<HTMLElement>('#password-count');
const feedback = document.querySelector<HTMLElement>('#password-feedback');
const symbol = document.querySelector<HTMLElement>('#password-symbol');
if (requirement && count && feedback && symbol) {
  let met = false;
  passwordField.addEventListener('input', () => {
    const length = passwordField.value.length;
    const nowMet = length >= passwordField.minLength;
    count.textContent = `${Math.min(length, passwordField.minLength)} / ${passwordField.minLength}`;
    symbol.textContent = nowMet ? '✓' : '○';
    requirement.classList.toggle('is-met', nowMet);
    if (nowMet !== met) feedback.textContent = nowMet ? (pl ? 'Wymagana długość została osiągnięta.' : 'Minimum length reached.') : (pl ? 'Hasło wymaga co najmniej 12 znaków.' : 'The password needs at least 12 characters.');
    met = nowMet;
  });
}
document.querySelector('#auth-retry')!.addEventListener('click',()=>{void refresh();});
form.addEventListener('submit',async(event)=>{event.preventDefault();const action=form.dataset.action;const values=new FormData(form);const email=String(values.get('email')||'').trim();const password=String(values.get('password')||'');const name=String(values.get('name')||'').trim();if(action==='signup'&&!name){status.textContent=pl?'Podaj imię.':'Enter your name.';return;}status.textContent=pl?'Proszę czekać...':'Please wait...';try{const result=action==='signup'?await auth.signUp.email({email,password,name}):await auth.signIn.email({email,password});if(result.error)throw Error();form.reset();passwordField.type='password';passwordVisibility.setAttribute('aria-pressed','false');if(action==='signup'){status.textContent=pl?'Sprawdź e-mail i potwierdź adres przed zalogowaniem.':'Check your email and verify your address before signing in.';}else{status.textContent='';}await refresh();}catch{status.textContent=action==='signup'?(pl?'Nie udało się utworzyć konta.':'Unable to create an account.'):(pl?'Nie udało się zalogować.':'Unable to sign in.');}});
document.querySelector('#forgot-password')?.addEventListener('click',async()=>{const email=(document.querySelector<HTMLInputElement>('#account-email-input')?.value||'').trim();if(!email){status.textContent=pl?'Podaj adres e-mail.':'Enter your email address.';return;}try{const result=await auth.requestPasswordReset({email,redirectTo:`${location.origin}/reset-password?lang=${pl?'pl':'en'}`});if(result.error)throw Error();status.textContent=pl?'Jeśli konto istnieje, otrzymasz wiadomość z linkiem.':'If the account exists, a reset link will be sent.';}catch{status.textContent=pl?'Nie udało się wysłać prośby.':'Unable to request a reset.';}});
document.querySelector('#sign-out')!.addEventListener('click',async()=>{try{const result=await auth.signOut();if(result.error)throw Error();status.textContent='';await refresh();}catch{status.textContent=pl?'Nie udało się wylogować.':'Unable to sign out.';}});
if(api)refresh();else status.textContent=pl?'Brak skonfigurowanego API.':'The API is not configured.';
</script>
</Layout>

<style>
.account-shell{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(40px,6vw,90px);padding-block:50px 90px}.account-story{min-height:0;padding:42px 45px 38px}.account-story h1{font-size:clamp(40px,4.4vw,62px);margin:18px 0}.account-story>p:not(.eyebrow){margin:0 0 30px}.account-options{width:100%;border-top:1px solid #88a08c}.account-options>div{display:grid;grid-template-columns:46px minmax(0,1fr);gap:15px;padding:22px 0;border-bottom:1px solid #88a08c}.account-option-number{font:400 24px 'Playfair Display',serif;color:#eac1a7}.account-options h2{font:500 25px/1.2 'Playfair Display',serif;margin:0}.account-options p{color:#e2ebe1;font-size:14px;line-height:1.6;margin:10px 0}.account-guest{display:inline-block;color:#fff;margin-top:4px}.account-guest:focus-visible{outline:3px solid #eac1a7;outline-offset:4px}.account-page{padding:20px 0}.account-page h2{margin:15px 0}.account-page form{margin-top:24px}@media(max-width:760px){.account-shell{grid-template-columns:1fr;gap:20px;padding-block:28px 60px}.account-page{grid-row:1;padding:10px 0 20px}.account-page h2{font-size:38px}.account-story{padding:28px 25px}.account-story h1{font-size:39px}.account-options>div{grid-template-columns:35px minmax(0,1fr);gap:10px}.account-options h2{font-size:23px}}
</style>

<style>
.account-page{background:#e9eee5;padding:38px!important;border-top:4px solid #a35e3e}.account-page form{max-width:100%}.account-password-field{display:flex;align-items:stretch;background:#fff;border:1px solid #9eafa0}.account-page .account-password-field input{flex:1;min-width:0;border:0;background:transparent;margin:0}.account-password-field button{border:0;border-left:1px solid #c3d0c2;background:#f6f4ed;color:#27352f;padding:0 14px;font-size:12px;font-weight:700;cursor:pointer}.account-password-field button:hover{background:#dce8db}.account-password-field button:focus-visible{outline:3px solid #a35e3e;outline-offset:-4px}@media(max-width:760px){.account-page{padding:25px!important}.account-password-field button{padding:0 10px}}
</style>

<style>.signup-support{margin:12px 0 20px;background:#fff;border:1px solid #b6c6b6}.password-requirement{display:grid;grid-template-columns:26px 1fr auto;gap:12px;align-items:center;padding:16px}.password-requirement>span:first-child{font-size:22px;color:#6a796d}.password-requirement strong{font-size:13px}.password-requirement p{font-size:12px;color:#405448;margin:4px 0 0}.password-requirement>span:last-child{font-size:12px;font-weight:700;color:#405448}.password-requirement.is-met{background:#dcebdd}.password-requirement.is-met>span:first-child{color:#235a38}.signup-support #password-feedback{font-size:12px;min-height:0;margin:0 16px;color:#405448}.signup-support #password-feedback:empty{display:none}.signup-next{display:flex;gap:12px;padding:15px 16px;border-top:1px solid #c7d4c6}.signup-next span{font-size:20px;color:#87452c}.signup-next p{font-size:13px;line-height:1.55;color:#405448;margin:0}</style>
