---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const initialQuery = Astro.url.searchParams.get('q')?.slice(0, 200) || '';
type Book = { slug: string; title: string; author: string };
let books: Book[] = [];
let unavailable = false;
try {
  const api = import.meta.env.PUBLIC_API_URL;
  const response = api ? await fetch(`${api}/api/books`) : await env.API.fetch(new Request(`${Astro.url.origin}/api/books`));
  if (!response.ok) throw new Error('Catalog unavailable');
  books = (await response.json()).books;
} catch {
  unavailable = true;
  Astro.response.status = 503;
}
const storyIntroductions: Record<string, { en: string; pl: string }> = {
  'a-christmas-carol': { en: 'A solitary miser is visited by the ghost of his former partner on Christmas Eve.', pl: 'W wigilijny wieczór samotnego skąpca odwiedza duch dawnego wspólnika.' },
  'alices-adventures-in-wonderland': { en: 'A curious girl follows a White Rabbit into an extraordinary world.', pl: 'Ciekawska dziewczynka podąża za Białym Królikiem do niezwykłego świata.' },
};
const authors = [...new Set(books.map((book) => book.author).filter(Boolean))].sort((a, b) => a.localeCompare(b));
---
<Layout lang={lang} title={pl ? 'Biblioteka książek i map bohaterów - Castellation' : 'Book library and character maps - Castellation'} description={pl ? 'Przeglądaj książki i odkrywaj mapy bohaterów oraz ich relacje we własnym tempie.' : 'Browse books and explore character maps and relationships at your own reading pace.'}>
  <SiteHeader lang={lang} />
  <main class="wrap collection">
    <div class="collection-heading"><div><p class="eyebrow">✦ {pl ? 'BIBLIOTEKA CASTELLATION' : 'THE CASTELLATION LIBRARY'}</p><h1>{pl ? 'Wybierz świat,' : 'Choose a world,'}<br /><em>{pl ? 'wejdź do historii.' : 'enter the story.'}</em></h1></div><div class="collection-intro"><p>{pl ? 'Odkrywaj książki poprzez ich bohaterów. Wybierz historię, aby zobaczyć powiązania odkrywane wraz z czytaniem.' : 'Discover books through the characters who bring them to life. Choose a story to explore connections as you read.'}</p><span>✳ {pl ? 'WYBIERZ SWÓJ ROZDZIAŁ' : 'CHOOSE YOUR CHAPTER'}</span></div></div>
    {books.length > 1 && <div id="library-finder" class="library-finder" data-lang={lang} hidden><div><p class="eyebrow">✦ {pl ? 'ZNAJDŹ SWOJĄ HISTORIĘ' : 'FIND YOUR STORY'}</p><label for="library-query">{pl ? 'Szukaj tytułu lub autora' : 'Search by title or author'}</label><p>{pl ? 'Wpisz kilka liter, aby zawęzić bibliotekę.' : 'Type a few letters to narrow the library.'}</p></div><div class="library-finder-controls"><div><input id="library-query" type="search" value={initialQuery} autocomplete="off" placeholder={pl ? 'Tytuł lub autor' : 'Title or author'} /><button id="library-clear" type="button">{pl ? 'Wyczyść' : 'Clear'}</button></div><p id="library-search-status" role="status" aria-live="polite"></p></div></div>}
    <section aria-labelledby="collection-title"><div class="collection-bar"><h2 id="collection-title">{pl ? 'Wszystkie historie' : 'All stories'}</h2><span id="library-result-count">{String(books.length).padStart(2, '0')}</span></div>
      {unavailable ? <p class="empty-state">{pl ? 'Biblioteka jest chwilowo niedostępna. Spróbuj ponownie później.' : 'The library is temporarily unavailable. Please try again later.'}</p> : books.length ? <ol class="collection-list" id="library-books">{books.map((book, index) => <li data-search={`${book.title} ${book.author}`}><a class="collection-item" href={`/books/${encodeURIComponent(book.slug)}?lang=${lang}`}><span class="collection-number">{String(index + 1).padStart(2, '0')} / {pl ? 'HISTORIA' : 'STORY'}</span><span class="collection-visual" aria-hidden="true">{book.slug === 'alices-adventures-in-wonderland' ? <img src="/images/alice-rabbit-hole.webp" alt="" width="768" height="1152" loading="lazy" /> : book.slug === 'a-christmas-carol' ? <img src="/images/christmas-carol-opening.webp" alt="" width="768" height="1152" loading="lazy" /> : <span>✳</span>}</span><span class="collection-book"><span>{book.author}</span><strong>{book.title}</strong>{storyIntroductions[book.slug] && <span class="collection-description">{storyIntroductions[book.slug][lang]}</span>}</span><span class="collection-link">{pl ? 'Odkryj historię' : 'Explore story'} <span aria-hidden="true">↗</span></span></a></li>)}</ol> : <p class="empty-state">{pl ? 'Biblioteka jest przygotowywana. Wróć wkrótce.' : 'The library is being prepared. Please come back soon.'}</p>}
      {books.length > 1 && <div id="library-no-results" class="library-no-results" hidden><div><p class="library-empty-kicker">✦ {pl ? 'SPRÓBUJ INNEJ DROGI' : 'TRY ANOTHER WAY'}</p><h3>{pl ? 'Nie znaleźliśmy tej historii.' : 'We couldn’t find that story.'}</h3><p>{pl ? 'Sprawdź tytuł lub nazwisko albo wróć do całej biblioteki.' : 'Check the title or author, or return to the full library.'}</p><div class="library-empty-actions"><button id="library-reset-results" type="button">{pl ? 'Pokaż wszystkie książki' : 'Show all books'} ↗</button><a href={`/characters?lang=${lang}`}>{pl ? 'Odkryj bohaterów' : 'Explore characters'} ↗</a></div></div><span aria-hidden="true">✳</span></div>}
    </section>
    <aside class="shelf-note"><span aria-hidden="true">✳</span><div><p class="eyebrow">✦ {pl ? 'SZTUKA WYBIERANIA' : 'THE ART OF CHOOSING'}</p><h2>{pl ? 'Nie wiesz, od której historii zacząć?' : 'Not sure which story to choose?'}</h2><a href={`/guides/choose-your-next-classic?lang=${lang}`}>{pl ? 'Znajdź swój następny klasyk' : 'Find your next classic'} ↗</a></div></aside>
    {books.length > 0 && <aside class="library-people"><div><p class="eyebrow">✦ {pl ? 'ZACZNIJ OD POSTACI' : 'START WITH A CHARACTER'}</p><h2>{pl ? 'Kogo chcesz poznać?' : 'Who will you meet?'}</h2><p>{pl ? 'Odkrywaj bohaterów z początków różnych historii w jednym miejscu.' : 'Discover characters from the beginnings of different stories in one place.'}</p></div><a class="primary-button" href={`/characters?lang=${lang}`}>{pl ? 'Poznaj bohaterów' : 'Meet the characters'} ↗</a></aside>}
    {authors.length > 0 && <section class="library-authors" aria-labelledby="authors-title"><div><p class="eyebrow">✦ {pl ? 'INNY SPOSÓB ODKRYWANIA' : 'ANOTHER WAY TO DISCOVER'}</p><h2 id="authors-title">{pl ? 'Podążaj za autorem.' : 'Follow the author.'}</h2><p>{pl ? 'Zobacz historie dostępne w bibliotece, zebrane według autorów.' : 'Find the stories in our library, gathered by author.'}</p></div><ul>{authors.map((author) => <li><a href={`/authors/${encodeURIComponent(author)}?lang=${lang}`}><span aria-hidden="true">✳</span><strong>{author}</strong><span aria-hidden="true">↗</span></a></li>)}</ul></section>}
  </main>
  <SiteFooter lang={lang} />
<script>
  const finder = document.querySelector<HTMLElement>('#library-finder');
  const query = document.querySelector<HTMLInputElement>('#library-query');
  const clear = document.querySelector<HTMLButtonElement>('#library-clear');
  const status = document.querySelector<HTMLElement>('#library-search-status');
  const noResults = document.querySelector<HTMLElement>('#library-no-results');
  const items = [...document.querySelectorAll<HTMLElement>('#library-books > li')];
  const resultCount = document.querySelector<HTMLElement>('#library-result-count');
  const resetResults = document.querySelector<HTMLButtonElement>('#library-reset-results');
  if (finder && query && clear && status && noResults) {
    const pl = finder.dataset.lang === 'pl';
    const normalize = (value: string) => value.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().trim();
    const update = () => {
      const terms = normalize(query.value).split(/\s+/).filter(Boolean);
      let count = 0;
      items.forEach((item) => { const text = normalize(item.dataset.search || ''); const matches = terms.every((term) => text.includes(term)); item.hidden = !matches; if (matches) count++; });
      noResults.hidden = count !== 0;
      if (resultCount) resultCount.textContent = String(count).padStart(2, '0');
      status.textContent = pl ? `Wyniki: ${count} z ${items.length}` : `Results: ${count} of ${items.length}`;
    };
    query.addEventListener('input', update);
    const reset = () => { query.value = ''; update(); query.focus(); };
    clear.addEventListener('click', reset);
    resetResults?.addEventListener('click', reset);
    finder.hidden = false; update();
  }
</script>
</Layout>
<style>
.library-finder[hidden],.library-no-results[hidden],.collection-list li[hidden]{display:none}.library-finder{display:grid;grid-template-columns:1fr 1.2fr;align-items:center;gap:45px;background:#e1e8dc;padding:34px 38px;margin-bottom:60px}.library-finder label{display:block;font:500 clamp(25px,2.5vw,34px) 'Playfair Display',serif;margin:12px 0}.library-finder>div>p:not(.eyebrow){font-size:13px;line-height:1.6;color:#405448}.library-finder-controls>div{display:flex;align-items:stretch;border-bottom:2px solid #536d5b}.library-finder input{min-width:0;flex:1;border:0;background:transparent;padding:16px 10px;font:16px 'DM Sans',sans-serif;color:#27352f}.library-finder input:focus-visible{outline:2px solid #a35e3e;outline-offset:2px}.library-finder button{border:0;background:#334b3d;color:white;padding:0 20px;font-weight:700;cursor:pointer}.library-finder button:hover{background:#496653}.library-finder button:focus-visible{outline:3px solid #a35e3e;outline-offset:3px}.library-finder-controls>p{font-size:12px;color:#405448;min-height:1.5em}.library-no-results{padding:26px 0;color:#405448;line-height:1.6}@media(max-width:760px){.library-finder{grid-template-columns:minmax(0,1fr);gap:15px;padding:25px;margin-bottom:40px}.library-finder>div{min-width:0}}
</style>

<style>.library-people{display:flex;align-items:end;justify-content:space-between;gap:30px;background:#e1e8dc;padding:40px;margin-top:70px}.library-people h2{font:500 clamp(30px,3vw,42px) 'Playfair Display',serif;margin:15px 0}.library-people p:not(.eyebrow){color:#405448;line-height:1.7;max-width:430px}@media(max-width:760px){.library-people{display:block;padding:25px;margin-top:45px}.library-people .primary-button{margin-top:15px}}</style>

<style>
.collection-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;list-style:none;padding:0;margin:24px 0 0}.collection-list li{min-width:0}.collection-item{min-height:420px;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:stretch;padding:32px;background:#30463a;color:#f8f5ec;border:0}.collection-list li:nth-child(even) .collection-item{background:#a55f40}.collection-number{font-size:10px;letter-spacing:.16em;font-weight:700}.collection-emblem{position:absolute;right:30px;top:40px;font-size:clamp(90px,14vw,180px);line-height:1;color:#e7c6ac;opacity:.42}.collection-book{position:relative;display:flex;flex-direction:column;gap:12px;margin:auto 0 32px}.collection-book>span{font-size:12px;letter-spacing:.12em;text-transform:uppercase}.collection-book strong{max-width:500px;font:500 clamp(36px,4vw,62px)/1.05 'Playfair Display',serif;letter-spacing:-.035em}.collection-link{display:flex;justify-content:space-between;border-top:1px solid #ffffff80;padding-top:18px;font-size:13px;font-weight:700}.collection-item:hover .collection-book strong{text-decoration:underline;text-underline-offset:6px}.collection-item:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}.shelf-note{display:flex;gap:35px;align-items:center;background:#e1e8dc;padding:38px;margin-top:60px}.shelf-note>span{font-size:76px;color:#a35e3e}.shelf-note h2{font:500 clamp(27px,3vw,40px)/1.15 'Playfair Display',serif;margin:12px 0}.shelf-note a{font-weight:700;text-decoration:underline;text-underline-offset:5px}@media(max-width:700px){.collection-list{grid-template-columns:1fr}.collection-item{min-height:320px;padding:26px}.collection-emblem{font-size:100px}.shelf-note{padding:25px;gap:20px}.shelf-note>span{font-size:42px}}
</style>
<style>
.collection-item .collection-number,.collection-item .collection-book>span{color:#fff}.collection-item .collection-link,.collection-item .collection-link span{color:#fff}
</style>

<style>
.collection{padding-top:48px}.collection-heading{padding-bottom:32px;align-items:end}.collection-heading h1{font-size:clamp(43px,5vw,68px);margin-top:15px}.collection-intro>span{margin-top:12px}.library-finder{display:flex;justify-content:space-between;gap:24px;padding:14px 20px;margin-bottom:34px;background:#e1e8dc}.library-finder>div:first-child{display:flex;align-items:center}.library-finder .eyebrow,.library-finder>div>p:not(.eyebrow){display:none}.library-finder label{font:600 14px 'DM Sans',sans-serif;margin:0}.library-finder-controls{width:min(100%,480px)}.library-finder input{padding:10px}.library-finder-controls>p{margin:4px 0 0}.collection-list{gap:20px}.collection-item{min-height:380px;padding:30px 34px;background:#30463a}.collection-list li:nth-child(even) .collection-item{background:#904d33}.collection-emblem{background:none;display:block;height:auto;top:24px;right:30px;font-size:120px;color:#e7c6ac;opacity:.25}.collection-book{margin:auto 0 28px;gap:14px}.collection-book strong{font-size:clamp(32px,3.8vw,54px);max-width:430px}.collection-book .collection-description{font:400 15px/1.6 'DM Sans',sans-serif;letter-spacing:normal;text-transform:none;max-width:360px;color:#fff}.collection-link{padding-top:16px}.collection-item:hover{background:#3d5949}.collection-list li:nth-child(even) .collection-item:hover{background:#a35e3e}@media(max-width:760px){.collection{padding-top:38px}.collection-heading{gap:12px;padding-bottom:24px}.collection-heading h1{font-size:42px}.collection-intro p{margin:0}.collection-intro>span{margin-top:8px}.library-finder{display:block;padding:16px;margin-bottom:26px}.library-finder-controls{width:100%}.library-finder label{margin-bottom:6px}.collection-item{min-height:310px;padding:26px}.collection-book strong{font-size:36px}.collection-emblem{height:auto;font-size:90px}}
</style>
<style>
.collection-item{display:grid;grid-template-columns:70px minmax(0,1fr);grid-template-rows:auto 1fr auto;column-gap:24px;background:linear-gradient(90deg,#30463a 0 104px,#e3eadf 104px);color:#27352f;padding:0 28px 28px 0}.collection-list li:nth-child(even) .collection-item{background:linear-gradient(90deg,#904d33 0 104px,#eee4d9 104px)}.collection-number{grid-column:1;grid-row:1;writing-mode:vertical-rl;transform:rotate(180deg);margin:28px auto 0}.collection-emblem{position:static;grid-column:1;grid-row:2;align-self:center;justify-self:center;font-size:54px;opacity:1;color:#e7c6ac}.collection-book{grid-column:2;grid-row:2;margin:48px 0 36px;padding-left:18px}.collection-item .collection-book>span{color:#405448}.collection-book .collection-description{color:#405448}.collection-link{grid-column:2;grid-row:3;margin-left:18px;border-color:#9aab9d;color:#27352f}.collection-item .collection-link,.collection-item .collection-link span{color:#27352f}.collection-item:hover{background:linear-gradient(90deg,#3d5949 0 104px,#d9e4d7 104px)}.collection-list li:nth-child(even) .collection-item:hover{background:linear-gradient(90deg,#a35e3e 0 104px,#e7d9ca 104px)}@media(max-width:760px){.collection-item{grid-template-columns:54px minmax(0,1fr);column-gap:14px;background:linear-gradient(90deg,#30463a 0 78px,#e3eadf 78px);padding:0 20px 22px 0}.collection-list li:nth-child(even) .collection-item{background:linear-gradient(90deg,#904d33 0 78px,#eee4d9 78px)}.collection-item:hover{background:linear-gradient(90deg,#3d5949 0 78px,#d9e4d7 78px)}.collection-list li:nth-child(even) .collection-item:hover{background:linear-gradient(90deg,#a35e3e 0 78px,#e7d9ca 78px)}.collection-emblem{font-size:42px}.collection-book{padding-left:10px;margin:38px 0 26px}.collection-link{margin-left:10px}}
</style>
<style>
.collection-item{display:flex;padding:32px 28px 28px 128px}.collection-number{position:absolute;top:28px;left:38px;margin:0}.collection-emblem{position:absolute;top:auto;bottom:38px;left:26px}.collection-book{padding:0;margin:auto 0 30px}.collection-link{margin-left:0}@media(max-width:760px){.collection-item{padding:28px 20px 24px 96px}.collection-number{top:24px;left:27px}.collection-emblem{left:18px;bottom:28px}.collection-book{padding:0;margin:auto 0 24px}.collection-link{margin-left:0}}
</style>

<style>
.library-no-results:not([hidden]){display:grid;grid-template-columns:minmax(0,1fr) auto;gap:30px;align-items:center;background:#293f34;color:#f6f4ed;padding:40px;margin-top:24px}.library-empty-kicker{font-size:10px;font-weight:700;letter-spacing:.14em;color:#f0c3a5}.library-no-results h3{font:500 clamp(30px,3.5vw,46px)/1.15 'Playfair Display',serif;margin:18px 0}.library-no-results p:not(.library-empty-kicker){color:#e1e9df;line-height:1.7}.library-no-results>span{font-size:100px;color:#86a18b}.library-empty-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:25px}.library-empty-actions button{border:0;background:#f6f4ed;color:#263e33;padding:16px 20px;font:inherit;font-weight:700;cursor:pointer}.library-empty-actions a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:4px}.library-empty-actions button:focus-visible,.library-empty-actions a:focus-visible{outline:3px solid #f0c3a5;outline-offset:4px}@media(max-width:760px){.library-no-results:not([hidden]){grid-template-columns:1fr;padding:25px}.library-no-results>span{display:none}.library-empty-actions{align-items:start;flex-direction:column;gap:18px}}
</style>

<style>.collection-item,.collection-list li:nth-child(even) .collection-item{display:grid;grid-template-columns:minmax(135px,.8fr) minmax(0,1.2fr);grid-template-rows:auto 1fr auto;gap:0;background:#e3eadf;color:#27352f;padding:0;min-height:400px}.collection-list li:nth-child(even) .collection-item{background:#eee4d9}.collection-visual{grid-column:1;grid-row:1/4;position:relative;overflow:hidden;background:#334b3d;min-height:400px}.collection-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .35s}.collection-visual>span{display:grid;place-items:center;height:100%;font-size:70px;color:#e7c6ac}.collection-number{position:static;grid-column:2;grid-row:1;writing-mode:initial;transform:none;margin:0;padding:28px 25px 0;color:#87452c!important}.collection-book{grid-column:2;grid-row:2;padding:0 25px;margin:auto 0 20px}.collection-book strong{font-size:clamp(27px,3vw,44px);line-height:1.08}.collection-link{grid-column:2;grid-row:3;margin:0 25px 25px;padding-top:15px}.collection-item:hover,.collection-list li:nth-child(even) .collection-item:hover{background:#d9e4d7}.collection-item:hover .collection-visual img{transform:scale(1.035)}@media(max-width:760px){.collection-item,.collection-list li:nth-child(even) .collection-item{grid-template-columns:minmax(110px,.7fr) minmax(0,1.3fr);min-height:300px}.collection-visual{min-height:300px}.collection-number{padding:22px 18px 0}.collection-book{padding:0 18px;margin:auto 0 16px}.collection-book strong{font-size:clamp(24px,6vw,36px)}.collection-link{margin:0 18px 20px}}@media(max-width:360px){.collection-item,.collection-list li:nth-child(even) .collection-item{grid-template-columns:1fr}.collection-visual{grid-column:1;grid-row:1;min-height:200px}.collection-number{grid-column:1;grid-row:2}.collection-book{grid-column:1;grid-row:3;margin:20px 0}.collection-link{grid-column:1;grid-row:4}}@media(prefers-reduced-motion:reduce){.collection-visual img{transition:none}.collection-item:hover .collection-visual img{transform:none}}</style>
