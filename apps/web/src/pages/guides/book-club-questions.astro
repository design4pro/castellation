---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
let books = [];
try {
  const api = import.meta.env.PUBLIC_API_URL;
  const response = api ? await fetch(`${api}/api/books`) : await env.API.fetch(new Request(`${Astro.url.origin}/api/books`));
  if (response.ok) books = (await response.json()).books;
} catch { /* The questions remain available when the catalog is unavailable. */ }

const questions = pl ? [
  { n: '01', theme: 'PIERWSZE WRAŻENIE', text: 'Która postać najbardziej Cię zaciekawiła i jaki szczegół zwrócił Twoją uwagę?', hint: 'Wskaż scenę, którą przeczytała cała grupa.' },
  { n: '02', theme: 'POŁĄCZENIE', text: 'Która relacja wydaje się najważniejsza na tym etapie? Co pokazuje jej kierunek?', hint: 'Nazwij, kto podejmuje działanie i wobec kogo.' },
  { n: '03', theme: 'PERSPEKTYWA', text: 'Czy dwie osoby mogłyby inaczej opisać to samo spotkanie?', hint: 'Oddziel to, co mówi tekst, od własnego przypuszczenia.' },
  { n: '04', theme: 'PYTANIE BEZ ODPOWIEDZI', text: 'Czego jeszcze nie wiemy o wybranej postaci?', hint: 'Zostaw pytanie otwarte, nawet jeśli ktoś już zna odpowiedź.' },
  { n: '05', theme: 'POWRÓT DO KSIĄŻKI', text: 'Do której sceny warto wrócić, aby sprawdzić różne interpretacje?', hint: 'Porównajcie fragment we własnych wydaniach.' },
] : [
  { n: '01', theme: 'FIRST IMPRESSION', text: 'Which character made you curious, and what detail caught your attention?', hint: 'Point to a scene everyone in the group has read.' },
  { n: '02', theme: 'CONNECTION', text: 'Which relationship feels most important so far? What does its direction tell you?', hint: 'Name who is acting and who receives the action.' },
  { n: '03', theme: 'PERSPECTIVE', text: 'Could two people describe the same encounter differently?', hint: 'Separate what the text says from your own inference.' },
  { n: '04', theme: 'AN OPEN QUESTION', text: 'What do we not yet know about a character?', hint: 'Leave the question open even if someone already knows the answer.' },
  { n: '05', theme: 'RETURN TO THE BOOK', text: 'Which scene would help you compare different interpretations?', hint: 'Look up the passage in your own editions.' },
];
---
<Layout lang={lang} title={pl ? 'Pytania do klubu książki bez spoilerów - Castellation' : 'Spoiler-aware book club questions about characters - Castellation'} description={pl ? 'Pięć pytań o postacie i relacje oraz sposób na rozmowę w grupie czytającej na różnym etapie.' : 'Five questions about characters and relationships, with a simple way to discuss a book at different reading stages.'}>
  <SiteHeader lang={lang} />
  <main><header class="club-hero"><div class="wrap club-hero-inner"><div><a href={`/guides?lang=${lang}`} class="club-back">← {pl ? 'Wszystkie przewodniki' : 'All guides'}</a><p class="club-kicker">✦ {pl ? 'DO WSPÓLNEJ LEKTURY' : 'FOR READING TOGETHER'}</p><h1>{pl ? 'Dobra rozmowa' : 'A good conversation'}<br /><em>{pl ? 'zaczyna się pytaniem.' : 'starts with a question.'}</em></h1><p>{pl ? 'Pięć pytań o bohaterów i ich relacje - do wykorzystania w klubie książki albo we dwoje.' : 'Five questions about characters and their connections, for a book club or a conversation with a friend.'}</p></div><div class="club-hero-art" aria-hidden="true"><span>?</span><i></i><span>✳</span><small>READ / NOTICE / DISCUSS</small></div></div></header>
    <div class="wrap club-content"><aside class="club-boundary"><span aria-hidden="true">✦</span><div><h2>{pl ? 'Najpierw ustalcie granicę.' : 'First, agree on a boundary.'}</h2><p>{pl ? 'Wybierzcie ostatni rozdział, który wszyscy przeczytali. Rozmawiajcie tylko o informacjach do tego miejsca. Jeśli korzystacie z mapy, ustawcie ten sam rozdział i sprawdźcie numerację we własnych wydaniach.' : 'Choose the last chapter everyone has read. Discuss only information up to that point. If you use a map, set it to the same chapter and check the numbering in your own editions.'}</p></div></aside><section aria-labelledby="club-questions-heading"><div class="club-section-heading"><div><p class="eyebrow">✦ {pl ? 'ZAPISZ LUB WYDRUKUJ' : 'SAVE OR PRINT'}</p><h2 id="club-questions-heading">{pl ? 'Pytania do rozmowy' : 'Questions to discuss'}</h2></div><div class="club-print-action"><p>{pl ? 'Wybierzcie jedno pytanie lub przejdźcie przez wszystkie.' : 'Choose one question or work through all five.'}</p><button type="button" id="club-print">{pl ? 'Drukuj pytania' : 'Print the questions'} ↗</button></div></div><div class="club-conversation"><nav class="club-index" aria-label={pl ? "Wybierz temat rozmowy" : "Choose a conversation topic"}><p>{pl ? "WYBIERZ TEMAT" : "CHOOSE A TOPIC"}</p>{questions.map((q) => <a href={`#question-${q.n}`}><span aria-hidden="true">{q.n}</span>{q.theme}<span aria-hidden="true">↘</span></a>)}</nav><ol class="club-questions">{questions.map((q) => <li id={`question-${q.n}`}><span aria-hidden="true">{q.n}</span><div><p>{q.theme}</p><h3>{q.text}</h3><small>{q.hint}</small></div></li>)}</ol></div></section>
    {books.length > 0 && <section class="club-practice" aria-labelledby="club-practice-heading"><div><p class="eyebrow">✦ {pl ? 'WYPRÓBUJCIE NA MAPIE' : 'TRY IT WITH A MAP'}</p><h2 id="club-practice-heading">{pl ? 'Zacznijcie od historii.' : 'Start with a story.'}</h2><p>{pl ? 'Otwórzcie mapę i ustawcie wspólny zakres przed rozmową.' : 'Open a map and set your shared reading boundary before you begin.'}</p></div><div>{books.map((book) => <a href={`/books/${encodeURIComponent(book.slug)}/map?lang=${lang}`}>{book.title} <span aria-hidden="true">↗</span></a>)}</div></section>}</div></main>
  <SiteFooter lang={lang} />
</Layout>
<script>
  document.getElementById('club-print')?.addEventListener('click', () => window.print());
</script>
<style>
.club-hero{background:#334b3d;color:#f6f4ed}.club-hero-inner{display:grid;grid-template-columns:1.4fr 1fr;gap:70px;align-items:center;padding-block:65px 80px}.club-back{font-size:13px;text-decoration:underline;text-underline-offset:4px}.club-kicker{font-size:10px;letter-spacing:.16em;font-weight:700;color:#e3b799;margin-top:60px}.club-hero h1{font:500 clamp(47px,5.5vw,76px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:25px 0}.club-hero h1 em{color:#e3b799;font-weight:400}.club-hero-inner>div>p:last-child{line-height:1.8;color:#dce5d8;max-width:500px}.club-hero-art{height:300px;border:1px solid #789181;border-radius:50% 50% 0 0;display:flex;justify-content:center;align-items:center;gap:20px;position:relative;color:#e3b799;font:500 75px 'Playfair Display',serif}.club-hero-art i{width:20%;height:1px;background:#789181}.club-hero-art small{position:absolute;bottom:25px;font:700 9px 'DM Sans',sans-serif;letter-spacing:.16em}.club-content{padding-block:65px 100px}.club-boundary{display:grid;grid-template-columns:50px 1fr;gap:20px;padding:30px;background:#e9e5d9;border-left:4px solid #a35e3e}.club-boundary>span{font-size:35px;color:#a35e3e}.club-boundary h2,.club-section-heading h2,.club-practice h2{font:500 clamp(30px,3vw,43px) 'Playfair Display',serif;margin:0 0 15px}.club-boundary p,.club-practice p:not(.eyebrow){line-height:1.75;color:#405448;max-width:800px}.club-section-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin:75px 0 20px}.club-section-heading>p{color:#53675a;font-size:14px}.club-print-action p{color:#53675a;font-size:14px}.club-print-action button{border:0;background:#293f34;color:white;padding:16px 20px;font:inherit;font-size:13px;font-weight:700;cursor:pointer}.club-print-action button:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}.club-questions{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.club-questions li{display:grid;grid-template-columns:55px 1fr;gap:18px;padding:30px;background:#e8ede3;min-height:240px}.club-questions li:first-child{grid-column:1/-1;background:#334b3d;color:#fff;min-height:220px}.club-questions li:first-child p,.club-questions li:first-child>span{color:#f0c3a5}.club-questions li:first-child small{color:#e1e9df}.club-questions li>span{font:400 42px 'Playfair Display',serif;color:#a35e3e}.club-questions li p{font-size:10px;letter-spacing:.14em;font-weight:700;color:#985438;margin:0 0 12px}.club-questions h3{font:500 clamp(24px,2.4vw,32px)/1.25 'Playfair Display',serif;margin:0 0 12px;max-width:850px}.club-questions small{font-size:13px;line-height:1.6;color:#53675a}.club-practice{display:grid;grid-template-columns:1fr 1fr;gap:45px;background:#e1e8dc;padding:38px;margin-top:70px}.club-practice a{display:flex;justify-content:space-between;gap:15px;font:500 22px 'Playfair Display',serif;border-bottom:1px solid #b5c4b4;padding:18px 0}.club-practice a:hover{text-decoration:underline;text-underline-offset:4px}@media(max-width:760px){.club-hero-inner{grid-template-columns:1fr;gap:25px;padding-block:45px 55px}.club-kicker{margin-top:45px}.club-hero-art{height:160px;font-size:50px}.club-content{padding-block:40px 70px}.club-boundary{grid-template-columns:1fr;gap:0;padding:25px}.club-section-heading{display:block;margin-top:50px}.club-questions{grid-template-columns:1fr}.club-questions li:first-child{grid-column:auto}.club-questions li{grid-template-columns:42px 1fr;gap:15px;padding:24px;min-height:0}.club-questions li>span{font-size:30px}.club-practice{grid-template-columns:1fr;gap:10px;padding:25px;margin-top:50px}}@media print{.site-header,.footer,.club-back,.club-hero-art,.club-practice{display:none!important}.club-hero{background:white;color:black}.club-hero-inner,.club-content{padding:0}.club-hero h1{font-size:32px}.club-hero h1 em{color:black}.club-hero-inner>div>p:last-child{color:black}.club-boundary{background:white;padding:10px}.club-print-action button{display:none}.club-questions{display:block}.club-questions li,.club-questions li:first-child{break-inside:avoid;background:white;color:black;border-top:1px solid #999;min-height:0;padding:12px 0}.club-questions li:first-child p,.club-questions li:first-child>span,.club-questions li:first-child small{color:black}.club-section-heading{margin-top:25px}}
</style>

<style>
.club-conversation{display:grid;grid-template-columns:minmax(210px,.55fr) minmax(0,1.45fr);gap:clamp(24px,4vw,55px);align-items:start}.club-index{position:sticky;top:24px;background:#293f34;color:#f6f4ed;padding:26px}.club-index p{font-size:10px;letter-spacing:.14em;font-weight:700;color:#f0c3a5;margin:0 0 18px}.club-index a{display:grid;grid-template-columns:28px 1fr auto;align-items:center;gap:9px;border-top:1px solid #819a86;padding:16px 0;font-size:11px;font-weight:700;letter-spacing:.06em;line-height:1.4}.club-index a span:first-child{color:#f0c3a5;font:400 22px 'Playfair Display',serif}.club-index a:hover{text-decoration:underline;text-underline-offset:4px}.club-index a:focus-visible{outline:3px solid #f0c3a5;outline-offset:3px}.club-questions{display:block;border-top:1px solid #95a897}.club-questions li,.club-questions li:first-child{grid-column:auto;grid-template-columns:75px minmax(0,1fr);gap:25px;background:transparent;color:#24372e;min-height:0;border-bottom:1px solid #95a897;padding:36px 0;scroll-margin-top:24px}.club-questions li:first-child p,.club-questions li:first-child>span{color:#985438}.club-questions li:first-child small{color:#53675a}.club-questions li>span{font-size:clamp(42px,5vw,64px);line-height:1}.club-questions h3{font-size:clamp(26px,3vw,40px);max-width:660px}.club-questions small{display:block;margin-top:20px;max-width:500px}.club-questions li:target{background:#e5ebdf;outline:12px solid #e5ebdf}@media(max-width:760px){.club-conversation{grid-template-columns:1fr;gap:22px}.club-index{position:static;padding:22px}.club-index a{padding:12px 0}.club-questions li,.club-questions li:first-child{grid-template-columns:42px minmax(0,1fr);gap:14px;padding:25px 0}.club-questions li>span{font-size:36px}.club-questions h3{font-size:26px}}@media print{.club-conversation{display:block}.club-index{display:none}.club-questions li,.club-questions li:first-child{outline:0;background:white;color:black;padding:12px 0}.club-questions li:first-child p,.club-questions li:first-child>span,.club-questions li:first-child small{color:black}}
</style>
