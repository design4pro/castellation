---
import SiteFooter from '../../components/SiteFooter.astro';
import { env } from 'cloudflare:workers';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
const slugs = ['alices-adventures-in-wonderland', 'a-christmas-carol'];
const api = import.meta.env.PUBLIC_API_URL;
const previews = await Promise.all(slugs.map(async (slug) => {
  try {
    const url = `${api || Astro.url.origin}/api/books/${encodeURIComponent(slug)}`;
    const response = api ? await fetch(url) : await env.API.fetch(new Request(url));
    if (!response.ok) return null;
    const data = await response.json();
    return { slug, progress: data.progress, characters: data.story.characters.slice(0, 2) };
  } catch { return null; }
}));
---
<Layout lang={lang} title={pl ? 'Jak wybrać następną klasyczną książkę | Castellation' : 'How to choose your next classic book | Castellation'} description={pl ? 'Wybierz klasyczną książkę według nastroju, bohaterów i rodzaju historii. Poznaj początki Alicji i Opowieści wigilijnej.' : 'Choose a classic book by mood, characters and the kind of story you want. Discover the beginnings of Alice and A Christmas Carol.'}>
  <SiteHeader lang={lang} />
  <main class="wrap choose-guide">
    <p class="eyebrow">✦ {pl ? 'PRZEWODNIK CZYTELNIKA' : 'THE READER’S GUIDE'}</p>
    <h1>{pl ? 'Jak wybrać następny' : 'How to choose your next'} <em>{pl ? 'klasyk?' : 'classic.'}</em></h1>
    <p class="lead">{pl ? 'Zacznij od tego, na co masz ochotę. Ciekawość i nastrój są równie dobrym przewodnikiem jak lista lektur.' : 'Start with what you are in the mood for. Curiosity can be as good a guide as any reading list.'}</p>
    <div class="guide-choices">
      <section><span>01 / ✳</span><h2>{pl ? 'Jeśli szukasz przygody' : 'If you want an adventure'}</h2><p>{pl ? 'Wybierz Alicję w Krainie Czarów. Jej ciekawość prowadzi do świata pełnego niezwykłych spotkań i pytań.' : 'Choose Alice’s Adventures in Wonderland. Her curiosity leads into a world of unusual encounters and questions.'}</p>{previews[0]?.characters.length > 0 && <div class="choice-cast"><p>{pl ? 'KOGO SPOTKASZ NA POCZĄTKU' : 'WHO YOU MEET AT THE BEGINNING'}</p><ul>{previews[0].characters.map((character) => <li><a href={`/books/${previews[0].slug}/characters/${encodeURIComponent(character.slug)}?lang=${lang}&volume=${previews[0].progress.volume}&chapter=${previews[0].progress.chapter}`}>{character.name} ↗</a></li>)}</ul></div>}<a href={`/books/alices-adventures-in-wonderland?lang=${lang}`}>{pl ? 'Odkryj Alicję' : 'Explore Alice'} ↗</a></section>
      <section><span>02 / ✳</span><h2>{pl ? 'Jeśli szukasz opowieści o zmianie' : 'If you want a story of change'}</h2><p>{pl ? 'Sięgnij po Opowieść wigilijną. Zacznij od Scrooge’a i przyjrzyj się ludziom, którzy pojawiają się w jego życiu.' : 'Pick up A Christmas Carol. Begin with Scrooge and notice the people who enter his life.'}</p>{previews[1]?.characters.length > 0 && <div class="choice-cast"><p>{pl ? 'KOGO SPOTKASZ NA POCZĄTKU' : 'WHO YOU MEET AT THE BEGINNING'}</p><ul>{previews[1].characters.map((character) => <li><a href={`/books/${previews[1].slug}/characters/${encodeURIComponent(character.slug)}?lang=${lang}&volume=${previews[1].progress.volume}&chapter=${previews[1].progress.chapter}`}>{character.name} ↗</a></li>)}</ul></div>}<a href={`/books/a-christmas-carol?lang=${lang}`}>{pl ? 'Odkryj Opowieść wigilijną' : 'Explore A Christmas Carol'} ↗</a></section>
    </div>
    <p class="guide-return"><a href={`/library?lang=${lang}`}>{pl ? 'Wróć do biblioteki' : 'Back to the library'} ↗</a></p>
  </main>
  <SiteFooter lang={lang} />
</Layout>
<style>
.choose-guide{padding-block:80px 100px}.choose-guide h1{max-width:850px;font:500 clamp(46px,7vw,88px)/1.05 'Playfair Display',serif;letter-spacing:-.04em;margin:24px 0}.choose-guide h1 em{color:#a35e3e;font-weight:400}.lead{max-width:600px;font-size:18px;line-height:1.75;color:#405448}.guide-choices{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:60px}.guide-choices section{background:#30463a;color:#fff;padding:40px;min-height:340px;display:flex;flex-direction:column}.guide-choices section:nth-child(2){background:#a55f40}.guide-choices section>span{font-size:11px;letter-spacing:.15em}.guide-choices h2{font:500 clamp(30px,3vw,42px)/1.15 'Playfair Display',serif;margin:50px 0 15px}.guide-choices p{line-height:1.7;max-width:430px}.guide-choices a,.guide-return a{font-weight:700;text-decoration:underline;text-underline-offset:5px}.guide-choices a{margin-top:auto;padding-top:20px}.guide-return{margin-top:35px}@media(max-width:700px){.choose-guide{padding-block:50px}.guide-choices{grid-template-columns:1fr}.guide-choices section{min-height:280px;padding:28px}.guide-choices h2{margin-top:35px}}
</style>

<style>
.guide-choices section{position:relative;overflow:hidden}.guide-choices section::after{content:'✳';position:absolute;right:-15px;top:-35px;font-size:170px;line-height:1;color:#fff;opacity:.08;pointer-events:none}.choice-cast{border-top:1px solid #ffffff80;margin-top:20px;padding-top:16px}.choice-cast p{font-size:10px;font-weight:700;letter-spacing:.12em;margin:0 0 12px}.choice-cast ul{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:0}.choice-cast li a{display:inline-block;margin:0;padding:9px 12px;border:1px solid #ffffffa0;font-size:13px;text-decoration:none}.choice-cast li a:hover{text-decoration:underline;text-underline-offset:4px}.choice-cast li a:focus-visible{outline:3px solid #fff;outline-offset:3px}
</style>
