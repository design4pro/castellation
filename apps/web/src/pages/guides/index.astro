---
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
---
<Layout lang={lang} title={pl ? 'Przewodniki czytelnika i historie książek - Castellation' : 'Reading guides and stories behind books - Castellation'} description={pl ? 'Poznaj praktyczne sposoby czytania oraz historie stojące za książkami i ich bohaterami.' : 'Explore practical reading advice and the stories behind books and their characters.'}>
  <SiteHeader lang={lang} />
  <main class="wrap journal">
    <header class="journal-heading"><div><p class="eyebrow">✦ {pl ? 'PRZEWODNIKI CASTELLATION' : 'THE CASTELLATION READER'}</p><h1>{pl ? 'Czytaj głębiej.' : 'Read a little'}<br /><em>{pl ? 'Odkrywaj więcej.' : 'deeper.'}</em></h1></div><p>{pl ? 'Praktyczne wskazówki i historie zza kulis książek - dla ciekawych czytelników.' : 'Practical ideas and stories behind the books, for curious readers.'}</p></header>
    <section aria-labelledby="journal-stories"><div class="journal-bar"><h2 id="journal-stories">{pl ? 'Do przeczytania' : 'Stories to explore'}</h2><span>05 / ✳</span></div>
      <div class="journal-grid">
        <a class="journal-feature" href={`/guides/track-characters?lang=${lang}`}><div class="journal-art" aria-hidden="true"><span>✳</span><i></i><span>✦</span></div><div class="journal-copy"><p class="journal-kicker">01 / {pl ? 'PRAKTYKA CZYTANIA' : 'THE READING PRACTICE'}</p><h3>{pl ? 'Jak zapamiętać bohaterów bez spoilerów' : 'How to keep track of characters without spoilers'}</h3><p>{pl ? 'Proste sposoby na śledzenie postaci i ich relacji bez czytania naprzód.' : 'Simple ways to follow characters and their connections without reading ahead.'}</p><span class="journal-link">{pl ? 'Przeczytaj poradnik' : 'Read the guide'} ↗</span></div></a>
        <a class="journal-secondary" href={`/guides/lewis-carroll-and-alice?lang=${lang}`}><div class="journal-number" aria-hidden="true">02<span>✳</span></div><div class="journal-copy"><p class="journal-kicker">02 / {pl ? 'ZA HISTORIĄ' : 'BEHIND THE STORY'}</p><h3>{pl ? 'Lewis Carroll i początki Alicji' : 'Lewis Carroll and the origins of Alice'}</h3><p>{pl ? 'Od rzecznej wyprawy do Krainy Czarów - poznaj źródła tej opowieści.' : 'From a river journey to Wonderland - explore the sources behind the story.'}</p><span class="journal-link">{pl ? 'Odkryj historię' : 'Explore the story'} ↗</span></div></a>
        <a class="journal-secondary" href={`/guides/alice-down-the-rabbit-hole?lang=${lang}`}><div class="journal-number" aria-hidden="true">03<span>✦</span></div><div class="journal-copy"><p class="journal-kicker">03 / {pl ? 'CZYTAJ BLIŻEJ' : 'A CLOSER READING'}</p><h3>{pl ? 'W głąb króliczej nory' : 'Down the rabbit-hole'}</h3><p>{pl ? 'Ciekawość i niezwykłe szczegóły pierwszego rozdziału Alicji.' : 'Curiosity and the curious details of Alice’s first chapter.'}</p><span class="journal-link">{pl ? 'Czytaj przewodnik' : 'Read the guide'} ↗</span></div></a>
        <a class="journal-secondary" href={`/guides/book-club-questions?lang=${lang}`}><div class="journal-number" aria-hidden="true">04<span>?</span></div><div class="journal-copy"><p class="journal-kicker">04 / {pl ? 'DO WSPÓLNEJ LEKTURY' : 'FOR READING TOGETHER'}</p><h3>{pl ? 'Pytania do klubu książki' : 'Book club questions'}</h3><p>{pl ? 'Pięć pytań o bohaterów, relacje i wspólny zakres lektury.' : 'Five questions about characters, connections and a shared reading boundary.'}</p><span class="journal-link">{pl ? 'Otwórz pytania' : 'Explore the questions'} ↗</span></div></a>
        <a class="journal-secondary" href={`/guides/two-unexpected-beginnings?lang=${lang}`}><div class="journal-number" aria-hidden="true">05<span>✳</span></div><div class="journal-copy"><p class="journal-kicker">05 / {pl ? 'DWA POCZĄTKI' : 'TWO BEGINNINGS'}</p><h3>{pl ? 'Alicja i Scrooge: dwa niezwykłe początki' : 'Alice and Scrooge: two unexpected beginnings'}</h3><p>{pl ? 'Porównaj pierwsze spotkania w dwóch klasycznych historiach.' : 'Compare first encounters in two classic stories.'}</p><span class="journal-link">{pl ? 'Odkryj porównanie' : 'Explore the comparison'} ↗</span></div></a>
      </div>
    </section>
    <aside class="journal-next"><div><p class="eyebrow">✦ {pl ? 'TWOJA NASTĘPNA HISTORIA' : 'YOUR NEXT STORY'}</p><h2>{pl ? 'Poznaj bohaterów bliżej.' : 'Get closer to the characters.'}</h2></div><a class="primary-button" href={`/library?lang=${lang}`}>{pl ? 'Odkryj bibliotekę' : 'Explore the library'} ↗</a></aside>
  </main>
  <footer class="wrap footer"><a class="brand" href={`/?lang=${lang}`}>✳ castellation<span class="brand-dot">.</span></a><p>{pl ? 'Historie są lepsze, gdy widzisz ich powiązania.' : 'Stories are better when you see the connections.'}</p><span>© {new Date().getFullYear()} CASTELLATION</span></footer>
</Layout>
<style>
.journal{padding-block:76px 100px}.journal-heading{display:grid;grid-template-columns:2fr 1fr;gap:40px;align-items:end;padding-bottom:70px}.journal-heading h1{font:500 clamp(50px,6vw,86px)/1.05 'Playfair Display',serif;letter-spacing:-.045em;margin:22px 0 0}.journal-heading h1 em{color:#a35e3e;font-weight:400}.journal-heading>p{max-width:340px;line-height:1.8;color:#53675a}.journal-bar{display:flex;align-items:center;justify-content:space-between;border-block:1px solid #b8c3b7;padding:16px 0}.journal-bar h2{font-size:12px;text-transform:uppercase;letter-spacing:.15em;margin:0}.journal-bar span,.journal-kicker{font-size:10px;font-weight:700;letter-spacing:.14em}.journal-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:30px;margin-top:30px}.journal-feature,.journal-secondary{display:flex;flex-direction:column;background:#e6ebe0}.journal-secondary{background:#eae2d6}.journal-art{height:240px;background:#334b3d;display:flex;align-items:center;justify-content:center;gap:20px;color:#e6c0a5;font-size:76px}.journal-art i{width:25%;height:1px;background:#b4c7b4}.journal-art span:last-child{font-size:50px}.journal-number{height:240px;display:flex;justify-content:space-between;align-items:start;padding:25px 30px;color:#aa6d4d;font:400 120px/.9 'Playfair Display',serif}.journal-number span{font:40px sans-serif}.journal-copy{padding:32px;display:flex;flex:1;flex-direction:column}.journal-kicker{color:#985438;margin:0 0 18px}.journal-copy h3{font:500 clamp(27px,3vw,39px)/1.18 'Playfair Display',serif;margin:0}.journal-copy>p:not(.journal-kicker){line-height:1.7;color:#405448;max-width:480px}.journal-link{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px;margin-top:auto;padding-top:20px}.journal-grid a:hover h3{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}.journal-next{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-top:80px}.journal-next h2{font:500 clamp(30px,3vw,42px) 'Playfair Display',serif;margin:15px 0 0}@media(max-width:760px){.journal{padding-block:50px 70px}.journal-heading,.journal-grid{grid-template-columns:1fr}.journal-heading{gap:15px;padding-bottom:35px}.journal-grid{gap:20px}.journal-art,.journal-number{height:180px}.journal-number{font-size:90px}.journal-copy{padding:25px}.journal-next{display:block;margin-top:55px}.journal-next .primary-button{margin-top:25px}}
</style>
