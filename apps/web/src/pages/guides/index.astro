---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
---
<Layout lang={lang} title={pl ? 'Przewodniki czytelnika i historie książek - Castellation' : 'Reading guides and stories behind books - Castellation'} description={pl ? 'Poznaj praktyczne sposoby czytania oraz historie stojące za książkami i ich bohaterami.' : 'Explore practical reading advice and the stories behind books and their characters.'}>
  <SiteHeader lang={lang} />
  <main class="wrap journal">
    <header class="journal-heading"><div><p class="eyebrow">✦ {pl ? 'PRZEWODNIKI CASTELLATION' : 'THE CASTELLATION READER'}</p><h1>{pl ? 'Czytaj głębiej.' : 'Read a little'}<br /><em>{pl ? 'Odkrywaj więcej.' : 'deeper.'}</em></h1></div><p>{pl ? 'Praktyczne wskazówki i historie zza kulis książek - dla ciekawych czytelników.' : 'Practical ideas and stories behind the books, for curious readers.'}</p></header>
    <section class="guide-choices" aria-labelledby="guide-choices-title"><div class="guide-choices-heading"><div><p class="eyebrow">✦ {pl ? 'ZNAJDŹ SWÓJ KIERUNEK' : 'FIND YOUR WAY IN'}</p><h2 id="guide-choices-title">{pl ? 'Jak chcesz dziś czytać?' : 'How would you like to read?'}</h2></div><a class="guide-choices-all" href={`/reading-paths?lang=${lang}`}>{pl ? 'Zobacz ścieżki czytelnicze' : 'Explore reading paths'} ↗</a></div><div class="guide-choices-list"><a href={`/guides/track-characters?lang=${lang}`}><span class="guide-choice-number" aria-hidden="true">01</span><span><strong>{pl ? 'Śledź bohaterów' : 'Follow the characters'}</strong><small>{pl ? 'Poznawaj postacie bez spoilerów.' : 'Keep track without spoilers.'}</small></span><span aria-hidden="true">↗</span></a><a href={`/guides/alice-down-the-rabbit-hole?lang=${lang}`}><span class="guide-choice-number" aria-hidden="true">02</span><span><strong>{pl ? 'Przyjrzyj się historii' : 'Look closer at a story'}</strong><small>{pl ? 'Odkryj początek Alicji.' : 'Explore Alice’s first chapter.'}</small></span><span aria-hidden="true">↗</span></a><a href={`/guides/book-club-questions?lang=${lang}`}><span class="guide-choice-number" aria-hidden="true">03</span><span><strong>{pl ? 'Rozmawiaj o książkach' : 'Read together'}</strong><small>{pl ? 'Znajdź pytania do rozmowy.' : 'Find questions for your book club.'}</small></span><span aria-hidden="true">↗</span></a></div></section><section aria-labelledby="journal-stories"><div class="journal-bar"><h2 id="journal-stories">{pl ? 'Do przeczytania' : 'Stories to explore'}</h2><span>05 / ✳</span></div>
      <div class="journal-grid">
        <a class="journal-feature" href={`/guides/track-characters?lang=${lang}`}><div class="journal-art" aria-hidden="true"><span>✳</span><i></i><span>✦</span></div><div class="journal-copy"><p class="journal-kicker">01 / {pl ? 'PRAKTYKA CZYTANIA' : 'THE READING PRACTICE'}</p><h3>{pl ? 'Jak zapamiętać bohaterów bez spoilerów' : 'How to keep track of characters without spoilers'}</h3><p>{pl ? 'Proste sposoby na śledzenie postaci i ich relacji bez czytania naprzód.' : 'Simple ways to follow characters and their connections without reading ahead.'}</p><span class="journal-link">{pl ? 'Przeczytaj poradnik' : 'Read the guide'} ↗</span></div></a>
        <a class="journal-secondary" href={`/guides/lewis-carroll-and-alice?lang=${lang}`}><div class="journal-number" aria-hidden="true">02<span>✳</span></div><div class="journal-copy"><p class="journal-kicker">02 / {pl ? 'ZA HISTORIĄ' : 'BEHIND THE STORY'}</p><h3>{pl ? 'Lewis Carroll i początki Alicji' : 'Lewis Carroll and the origins of Alice'}</h3><p>{pl ? 'Od rzecznej wyprawy do Krainy Czarów - poznaj źródła tej opowieści.' : 'From a river journey to Wonderland - explore the sources behind the story.'}</p><span class="journal-link">{pl ? 'Odkryj historię' : 'Explore the story'} ↗</span></div></a>
        <a class="journal-secondary" href={`/guides/alice-down-the-rabbit-hole?lang=${lang}`}><div class="journal-number" aria-hidden="true">03<span>✦</span></div><div class="journal-copy"><p class="journal-kicker">03 / {pl ? 'CZYTAJ BLIŻEJ' : 'A CLOSER READING'}</p><h3>{pl ? 'W głąb króliczej nory' : 'Down the rabbit-hole'}</h3><p>{pl ? 'Ciekawość i niezwykłe szczegóły pierwszego rozdziału Alicji.' : 'Curiosity and the curious details of Alice’s first chapter.'}</p><span class="journal-link">{pl ? 'Czytaj przewodnik' : 'Read the guide'} ↗</span></div></a>
        <a class="journal-secondary" href={`/guides/book-club-questions?lang=${lang}`}><div class="journal-number" aria-hidden="true">04<span>?</span></div><div class="journal-copy"><p class="journal-kicker">04 / {pl ? 'DO WSPÓLNEJ LEKTURY' : 'FOR READING TOGETHER'}</p><h3>{pl ? 'Pytania do klubu książki' : 'Book club questions'}</h3><p>{pl ? 'Pięć pytań o bohaterów, relacje i wspólny zakres lektury.' : 'Five questions about characters, connections and a shared reading boundary.'}</p><span class="journal-link">{pl ? 'Otwórz pytania' : 'Explore the questions'} ↗</span></div></a>
        <a class="journal-secondary" href={`/guides/two-unexpected-beginnings?lang=${lang}`}><div class="journal-number" aria-hidden="true">05<span>✳</span></div><div class="journal-copy"><p class="journal-kicker">05 / {pl ? 'DWA POCZĄTKI' : 'TWO BEGINNINGS'}</p><h3>{pl ? 'Alicja i Scrooge: dwa niezwykłe początki' : 'Alice and Scrooge: two unexpected beginnings'}</h3><p>{pl ? 'Porównaj pierwsze spotkania w dwóch klasycznych historiach.' : 'Compare first encounters in two classic stories.'}</p><span class="journal-link">{pl ? 'Odkryj porównanie' : 'Explore the comparison'} ↗</span></div></a>
      </div>
    </section>
    <section class="reading-edition" aria-labelledby="edition-title">
      <div class="edition-intro"><p class="eyebrow">✦ {pl ? 'KOLEJNE ODKRYCIA' : 'MORE TO DISCOVER'}</p><h2 id="edition-title">{pl ? 'Znajdź swój następny' : 'Find your next'} <em>{pl ? 'punkt zaczepienia.' : 'point of departure.'}</em></h2><p>{pl ? 'Wybierz historię według nastroju albo przyjrzyj się temu, co łączy jej bohaterów.' : 'Choose a story by mood or look closer at what connects its characters.'}</p></div>
      <div class="edition-links">
        <a class="edition-feature" href={`/guides/choose-your-next-classic?lang=${lang}`}><span class="edition-index">01 / {pl ? 'WYBIERZ HISTORIĘ' : 'CHOOSE A STORY'}</span><strong>{pl ? 'Który klasyk wybrać?' : 'Which classic is right for you?'}</strong><span class="edition-detail">{pl ? 'Przygoda czy opowieść o zmianie? Zacznij od nastroju.' : 'Adventure or a story of change? Start with your mood.'}</span><span class="edition-action">{pl ? 'Znajdź swoją książkę' : 'Find your book'} ↗</span></a>
        <a class="edition-row" href={`/guides/reading-character-connections?lang=${lang}`}><span class="edition-index">02 / {pl ? 'SZTUKA CZYTANIA' : 'THE READING PRACTICE'}</span><strong>{pl ? 'Czytaj między bohaterami' : 'Read between characters'}</strong><span class="edition-action">{pl ? 'Poznaj trzy pytania' : 'Explore three questions'} ↗</span></a>
        {!pl && <a class="edition-row" href="/guides/alice-and-the-white-rabbit?lang=en"><span class="edition-index">03 / FIRST ENCOUNTERS</span><strong>Alice &amp; the White Rabbit</strong><span class="edition-action">Follow their first connection ↗</span></a>}
      </div>
    </section>
    <aside class="journal-next"><div><p class="eyebrow">✦ {pl ? 'TWOJA NASTĘPNA HISTORIA' : 'YOUR NEXT STORY'}</p><h2>{pl ? 'Poznaj bohaterów bliżej.' : 'Get closer to the characters.'}</h2></div><a class="primary-button" href={`/library?lang=${lang}`}>{pl ? 'Odkryj bibliotekę' : 'Explore the library'} ↗</a></aside>
  </main>
  <SiteFooter lang={lang} />
</Layout>
<style>
.journal{padding-block:76px 100px}.journal-heading{display:grid;grid-template-columns:2fr 1fr;gap:40px;align-items:end;padding-bottom:70px}.journal-heading h1{font:500 clamp(50px,6vw,86px)/1.05 'Playfair Display',serif;letter-spacing:-.045em;margin:22px 0 0}.journal-heading h1 em{color:#a35e3e;font-weight:400}.journal-heading>p{max-width:340px;line-height:1.8;color:#53675a}.journal-bar{display:flex;align-items:center;justify-content:space-between;border-block:1px solid #b8c3b7;padding:16px 0}.journal-bar h2{font-size:12px;text-transform:uppercase;letter-spacing:.15em;margin:0}.journal-bar span,.journal-kicker{font-size:10px;font-weight:700;letter-spacing:.14em}.journal-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:30px;margin-top:30px}.journal-feature,.journal-secondary{display:flex;flex-direction:column;background:#e6ebe0}.journal-secondary{background:#eae2d6}.journal-art{height:240px;background:#334b3d;display:flex;align-items:center;justify-content:center;gap:20px;color:#e6c0a5;font-size:76px}.journal-art i{width:25%;height:1px;background:#b4c7b4}.journal-art span:last-child{font-size:50px}.journal-number{height:240px;display:flex;justify-content:space-between;align-items:start;padding:25px 30px;color:#aa6d4d;font:400 120px/.9 'Playfair Display',serif}.journal-number span{font:40px sans-serif}.journal-copy{padding:32px;display:flex;flex:1;flex-direction:column}.journal-kicker{color:#985438;margin:0 0 18px}.journal-copy h3{font:500 clamp(27px,3vw,39px)/1.18 'Playfair Display',serif;margin:0}.journal-copy>p:not(.journal-kicker){line-height:1.7;color:#405448;max-width:480px}.journal-link{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px;margin-top:auto;padding-top:20px}.journal-grid a:hover h3{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}.journal-next{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-top:80px}.journal-next h2{font:500 clamp(30px,3vw,42px) 'Playfair Display',serif;margin:15px 0 0}@media(max-width:760px){.journal{padding-block:50px 70px}.journal-heading,.journal-grid{grid-template-columns:1fr}.journal-heading{gap:15px;padding-bottom:35px}.journal-grid{gap:20px}.journal-art,.journal-number{height:180px}.journal-number{font-size:90px}.journal-copy{padding:25px}.journal-next{display:block;margin-top:55px}.journal-next .primary-button{margin-top:25px}}
</style>

<style>
.reading-edition{display:grid;grid-template-columns:minmax(0, .75fr) minmax(0, 1.25fr);gap:clamp(30px,6vw,90px);margin-top:90px;padding:clamp(28px,4vw,52px);background:#e2e7dc}.edition-intro h2{font:500 clamp(36px,4vw,58px)/1.08 'Playfair Display',serif;letter-spacing:-.035em;margin:24px 0}.edition-intro h2 em{color:#985438;font-weight:400}.edition-intro>p:last-child{max-width:300px;line-height:1.7;color:#405448}.edition-links{display:grid;grid-template-columns:1fr 1fr;gap:0 26px}.edition-links a{display:flex;flex-direction:column;align-items:flex-start;min-width:0;padding:22px 0;border-top:1px solid #95a897}.edition-feature{grid-row:span 2}.edition-index{font-size:10px;font-weight:700;letter-spacing:.12em;color:#805039}.edition-links strong{font:500 clamp(24px,2.5vw,34px)/1.15 'Playfair Display',serif;margin:20px 0 12px}.edition-feature strong{font-size:clamp(34px,3.8vw,52px)}.edition-detail{line-height:1.65;color:#405448;max-width:250px}.edition-action{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px;margin-top:auto;padding-top:22px}.edition-links a:hover strong{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}.edition-links a:focus-visible{outline:3px solid #805039;outline-offset:5px}@media(max-width:760px){.reading-edition{grid-template-columns:1fr;gap:22px;margin-top:55px}.edition-intro h2{margin:16px 0}.edition-links{grid-template-columns:1fr}.edition-feature{grid-row:auto}.edition-links strong{margin:12px 0}.edition-links a{padding:22px 0}.edition-action{padding-top:12px}}
</style>

<style>
.journal{padding-top:42px}.journal-heading{padding-bottom:30px}.journal-heading h1{font-size:clamp(44px,5vw,66px);margin-top:14px}.guide-choices{background:#293f34;color:#f6f4ed;margin-bottom:55px;padding:32px 36px}.guide-choices-heading{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:26px}.guide-choices-heading .eyebrow{color:#edc5ac;margin:0 0 12px}.guide-choices h2{font:500 clamp(30px,3.5vw,47px)/1.12 'Playfair Display',serif;letter-spacing:-.025em;margin:0}.guide-choices-all{font-size:12px;font-weight:700;text-decoration:underline;text-underline-offset:5px;white-space:nowrap}.guide-choices-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #91a895}.guide-choices-list>a{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:14px;padding:25px 18px 12px 0;align-items:start}.guide-choices-list>a+a{border-left:1px solid #91a895;padding-left:20px}.guide-choice-number{font:400 25px 'Playfair Display',serif;color:#edc5ac}.guide-choices-list strong{display:block;font:500 clamp(21px,2.2vw,29px)/1.18 'Playfair Display',serif;overflow-wrap:anywhere}.guide-choices-list small{display:block;margin-top:10px;line-height:1.5;font-size:13px;color:#e1e9df}.guide-choices-list>a>span:last-child{font-size:19px;color:#edc5ac}.guide-choices-list>a:hover strong,.guide-choices-all:hover{text-decoration:underline;text-underline-offset:5px}.guide-choices a:focus-visible{outline:3px solid #edc5ac;outline-offset:4px}@media(max-width:760px){.journal{padding-top:32px}.journal-heading{padding-bottom:25px}.journal-heading h1{font-size:43px}.guide-choices{padding:25px;margin-bottom:40px}.guide-choices-heading{display:block;margin-bottom:18px}.guide-choices-all{display:inline-block;margin-top:16px}.guide-choices-list{grid-template-columns:1fr}.guide-choices-list>a,.guide-choices-list>a+a{border-left:0;border-bottom:1px solid #91a895;padding:18px 0}.guide-choices-list strong{font-size:23px}.guide-choices-list small{margin-top:5px}}
</style>
