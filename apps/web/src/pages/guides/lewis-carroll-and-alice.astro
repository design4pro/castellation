---
import SiteFooter from '../../components/SiteFooter.astro';
import RelatedReading from '../../components/RelatedReading.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
let available = false;
try {
  const api = import.meta.env.PUBLIC_API_URL;
  const response = api ? await fetch(`${api}/api/books`) : await env.API.fetch(new Request(`${Astro.url.origin}/api/books`));
  if (response.ok) available = (await response.json()).books.some((book) => book.slug === 'alices-adventures-in-wonderland' && book.author === 'Lewis Carroll');
} catch { /* The article and its sources remain available without the catalog. */ }
---
<Layout lang={lang} title={pl ? 'Lewis Carroll i początki Alicji w Krainie Czarów - Castellation' : 'Lewis Carroll and the origins of Alice in Wonderland - Castellation'} description={pl ? 'Od opowieści podczas wyprawy łodzią po rękopis i książkę: poznaj początki historii Alicji według źródeł bibliotecznych.' : 'From a story told on a boat trip to a manuscript and a book: explore the origins of Alice using library sources.'}>
  <SiteHeader lang={lang} />
  <main><article><header class="origin-hero"><div class="wrap origin-hero-inner"><div><p class="eyebrow">✦ {pl ? 'ZA HISTORIĄ' : 'BEHIND THE STORY'}</p><h1>{pl ? 'Od rzeki' : 'From the river'}<br /><em>{pl ? 'do Krainy Czarów.' : 'to Wonderland.'}</em></h1><p>{pl ? 'Jak opowieść Lewisa Carrolla stała się książką o Alicji.' : 'How a story by Lewis Carroll became a book about Alice.'}</p></div><nav class="origin-journey" aria-label={pl ? 'Etapy powstania Alicji' : 'The making of Alice'}><p>{pl ? 'OD OPOWIEŚCI DO KSIĄŻKI' : 'FROM TALE TO BOOK'}</p><a href="#story-1862"><strong>1862</strong><span>{pl ? 'Opowieść na rzece' : 'A story on the river'}</span><b aria-hidden="true">↗</b></a><a href="#story-1864"><strong>1864</strong><span>{pl ? 'Rękopis dla Alice' : 'A manuscript for Alice'}</span><b aria-hidden="true">↗</b></a><a href="#story-1865"><strong>1865</strong><span>{pl ? 'Pierwsze wydanie' : 'The published book'}</span><b aria-hidden="true">↗</b></a></nav></div></header>
  <div class="wrap origin-layout"><div class="origin-intro"><p class="eyebrow">{pl ? 'LEWIS CARROLL / ALICJA' : 'LEWIS CARROLL / ALICE'}</p><p>{pl ? 'Lewis Carroll to pseudonim Charlesa Lutwidge’a Dodgsona, który wykładał matematykę w Christ Church w Oksfordzie. Historia Alicji powstała z opowieści dla dzieci i przeszła drogę od rękopisu do drukowanej książki.' : 'Lewis Carroll was the pen name of Charles Lutwidge Dodgson, a mathematics lecturer at Christ Church, Oxford. The Alice story grew from a tale told to children into a manuscript and then a printed book.'}</p><a href="https://www.loc.gov/collections/lewis-carroll-scrapbook/about-this-collection">{pl ? 'Źródło: Library of Congress' : 'Source: Library of Congress'} ↗</a></div>
  <div class="origin-timeline"><section id="story-1862"><p class="origin-year">1862</p><div><h2>{pl ? 'Opowieść podczas wyprawy' : 'A story on a boat trip'}</h2><p>{pl ? 'Dziennik Dodgsona opisuje wycieczkę łodzią i opowieść przedstawioną Alice, Edith i Lorinie Liddell. British Library wskazuje tę opowieść jako początek historii, która później została zapisana.' : 'Dodgson’s diary records a boat trip and a story told to Alice, Edith and Lorina Liddell. The British Library identifies that tale as the beginning of the story he later wrote down.'}</p><a href="https://searcharchives.bl.uk/catalog/040-001611723">{pl ? 'Zobacz opis dziennika w British Library' : 'Read the British Library diary record'} ↗</a></div></section>
  <section id="story-1864"><p class="origin-year">1864</p><div><h2>{pl ? 'Rękopis dla Alice' : 'A manuscript for Alice'}</h2><p>{pl ? 'Dodgson napisał i zilustrował rękopis zatytułowany Alice’s Adventures Under Ground. Christ Church podaje, że podarował go Alice Liddell w 1864 roku. British Library przechowuje opis tego rękopisu w swoim katalogu.' : 'Dodgson wrote and illustrated a manuscript called Alice’s Adventures Under Ground. Christ Church records that he gave it to Alice Liddell in 1864. The British Library describes the manuscript in its catalogue.'}</p><a href="https://searcharchives.bl.uk/catalog/032-002102746">{pl ? 'Poznaj rękopis w British Library' : 'Explore the manuscript record'} ↗</a></div></section>
  <section id="story-1865"><p class="origin-year">1865</p><div><h2>{pl ? 'Historia staje się książką' : 'The story becomes a book'}</h2><p>{pl ? 'Opowieść została następnie przeredagowana i wydana jako Alice’s Adventures in Wonderland. British Library opisuje drogę od rękopisu do wydania z 1865 roku, a Christ Church posiada egzemplarz wczesnego wydania należący do autora.' : 'The tale was then rewritten and published as Alice’s Adventures in Wonderland. The British Library records the journey from manuscript to the 1865 book, and Christ Church holds Carroll’s own copy of an early edition.'}</p><a href="https://www.chch.ox.ac.uk/news/oxford-receives-lewis-carrolls-own-copy-alices-adventures-wonderland">{pl ? 'Przeczytaj o egzemplarzu w Christ Church' : 'Read about Carroll’s copy at Christ Church'} ↗</a></div></section></div>
  {available && <aside class="origin-next"><p class="eyebrow">✦ {pl ? 'WEJDŹ DO HISTORII' : 'STEP INSIDE THE STORY'}</p><h2>{pl ? 'Poznaj bohaterów Alicji.' : 'Meet the characters of Alice.'}</h2><p>{pl ? 'Odkrywaj postacie i relacje we własnym tempie.' : 'Explore the characters and their connections at your own reading pace.'}</p><a class="primary-button" href={`/books/alices-adventures-in-wonderland?lang=${lang}`}>{pl ? 'Otwórz książkę' : 'Explore the book'} ↗</a></aside>}</div></article><RelatedReading lang={lang} current="lewis-carroll-and-alice" /></main>
  <SiteFooter lang={lang} />
</Layout>

<style>
.origin-hero-inner{grid-template-columns:minmax(0,1fr) minmax(300px,430px)}
.origin-journey{border-top:1px solid #9eb0a1;align-self:center}.origin-journey>p{font:700 11px/1.4 sans-serif!important;letter-spacing:.12em;color:#e6b99f!important;margin:17px 0 22px}.origin-journey a{display:grid;grid-template-columns:92px 1fr auto;align-items:center;gap:12px;border-top:1px solid #789182;padding:19px 4px;color:#f6f4ed;text-decoration:none;transition:padding .2s,background .2s}.origin-journey a:last-child{border-bottom:1px solid #789182}.origin-journey a:hover,.origin-journey a:focus-visible{background:#476150;padding-inline:12px;outline:2px solid #e6b99f;outline-offset:3px}.origin-journey strong{font:500 29px/1 'Playfair Display',serif;color:#e6b99f}.origin-journey span{font-size:14px}.origin-journey b{font-size:18px;font-weight:400}.origin-timeline section{scroll-margin-top:24px}@media(max-width:760px){.origin-hero-inner{grid-template-columns:1fr}.origin-journey a{grid-template-columns:80px 1fr auto}.origin-journey strong{font-size:26px}}@media(prefers-reduced-motion:reduce){.origin-journey a{transition:none}}
</style>
