---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
let books = [];
let openingPositions = {};
try {
  const api = import.meta.env.PUBLIC_API_URL;
  const response = api ? await fetch(`${api}/api/books`) : await env.API.fetch(new Request(`${Astro.url.origin}/api/books`));
  if (response.ok) books = (await response.json()).books.filter((book) => ['alices-adventures-in-wonderland', 'a-christmas-carol'].includes(book.slug)).sort((a, b) => Number(b.slug === 'alices-adventures-in-wonderland') - Number(a.slug === 'alices-adventures-in-wonderland'));
  const details = await Promise.all(books.map(async (book) => { try { const path = `/api/books/${encodeURIComponent(book.slug)}`; const result = api ? await fetch(`${api}${path}`) : await env.API.fetch(new Request(`${Astro.url.origin}${path}`)); return result.ok ? await result.json() : null; } catch { return null; } }));
  openingPositions = Object.fromEntries(details.filter((item) => item?.book.positions?.length).map((item) => [item.book.slug, item.book.positions[0]]));
} catch { /* The comparison remains available without the catalog. */ }
const comparisons = pl ? [
  { number: '01', title: 'Co zakłóca codzienność?', left: 'Alicja siedzi znudzona nad brzegiem, gdy pojawia się Biały Królik. Zegarek wyjęty z kamizelki staje się szczegółem, który skłania ją do działania.', right: 'Scrooge wraca do swojego domu. W znajomej kołatce dostrzega twarz zmarłego Marleya - niezwykłość pojawia się w miejscu, które powinno być zwyczajne.' },
  { number: '02', title: 'Jak reaguje bohater?', left: 'Alicja podąża za królikiem z ciekawości. W trakcie upadku rozgląda się i próbuje zrozumieć otoczenie przez znajome przedmioty.', right: 'Scrooge próbuje zachować sceptycyzm wobec tego, co widzi. Spotkanie z duchem dawnego wspólnika zmusza go jednak do wysłuchania ostrzeżenia.' },
  { number: '03', title: 'Co wnosi pierwsza relacja?', left: 'Relacja Alicji z królikiem zaczyna się od pościgu. Nie musi jeszcze wiedzieć, kim on jest - jego pośpiech wystarcza, by historia ruszyła.', right: 'Marley jest częścią przeszłości Scrooge’a jako jego wspólnik. Ich wcześniejsza więź nadaje niespodziewanej wizycie osobisty ciężar.' },
] : [
  { number: '01', title: 'What interrupts the ordinary?', left: 'Alice is bored by the river when the White Rabbit appears. The watch he takes from his waistcoat pocket is the detail that prompts her to act.', right: 'Scrooge returns home. He sees the face of the dead Marley in his familiar door knocker - the uncanny appears in a place that should be ordinary.' },
  { number: '02', title: 'How does the character respond?', left: 'Alice follows the Rabbit out of curiosity. During her fall she looks around and tries to understand the surroundings through familiar objects.', right: 'Scrooge tries to remain skeptical of what he sees. The encounter with his former partner’s ghost nevertheless makes him listen to a warning.' },
  { number: '03', title: 'What does the first connection add?', left: 'Alice’s connection to the Rabbit begins with pursuit. She does not yet need to know who he is - his hurry is enough to set the story moving.', right: 'Marley is part of Scrooge’s past as his business partner. That existing connection gives the unexpected visit a personal weight.' },
];
---
<Layout lang={lang} title={pl ? 'Alicja i Opowieść wigilijna: dwa niezwykłe początki - Castellation' : 'Alice and A Christmas Carol: two unexpected beginnings - Castellation'} description={pl ? 'Porównaj pierwsze spotkania, reakcje i niezwykłe szczegóły na początku Alicji w Krainie Czarów i Opowieści wigilijnej.' : 'Compare first encounters, reactions and uncanny details in the openings of Alice’s Adventures in Wonderland and A Christmas Carol.'}>
  <SiteHeader lang={lang} />
  <main><header class="compare-hero"><div class="wrap compare-hero-inner"><div><a class="compare-back" href={`/guides?lang=${lang}`}>← {pl ? 'Wszystkie przewodniki' : 'All guides'}</a><p class="compare-kicker">✦ {pl ? 'DWA POCZĄTKI / JEDNO PYTANIE' : 'TWO BEGINNINGS / ONE QUESTION'}</p><h1>{pl ? 'Jak zaczyna się' : 'How does a story'}<br /><em>{pl ? 'niezwykła historia?' : 'become extraordinary?'}</em></h1><p>{pl ? 'Alicja i Scrooge spotykają coś nieoczekiwanego. Zobacz, jak dwa początki prowadzą czytelnika w różne strony.' : 'Alice and Scrooge encounter something unexpected. See how two openings lead readers in different directions.'}</p></div>{books.length > 0 && <nav class="compare-doorways" aria-label={pl ? 'Odkryj początki historii' : 'Explore the beginnings'}>{books.map((book) => <a href={`/books/${encodeURIComponent(book.slug)}/opening?lang=${lang}`}><span class="compare-doorways-mark" aria-hidden="true">{book.slug === 'alices-adventures-in-wonderland' ? '✳' : '✦'}</span><span class="compare-doorways-label">{book.slug === 'alices-adventures-in-wonderland' ? (pl ? 'ALICJA' : 'ALICE') : 'SCROOGE'}</span><strong>{book.title}</strong><span class="compare-doorways-action">{pl ? 'Poznaj początek' : 'Explore the opening'} ↗</span></a>)}</nav>}</div></header>
  <div class="wrap compare-content"><aside class="compare-scope">✦ {pl ? 'Zakres: pierwszy rozdział Alicji i pierwsza część Opowieści wigilijnej. Poniżej znajdują się informacje z tych fragmentów.' : 'Scope: Alice’s first chapter and the first stave of A Christmas Carol. The comparison discusses details from those passages.'}</aside><div class="compare-columns" aria-hidden="true"><span>ALICE / LEWIS CARROLL</span><span>A CHRISTMAS CAROL / CHARLES DICKENS</span></div>{comparisons.map((item) => <section class="compare-row"><div class="compare-row-heading"><span>{item.number}</span><h2>{item.title}</h2></div><div class="compare-pair"><article><p class="compare-label">ALICE / LEWIS CARROLL</p><p>{item.left}</p></article><article><p class="compare-label">A CHRISTMAS CAROL / CHARLES DICKENS</p><p>{item.right}</p></article></div></section>)}
  <aside class="compare-question"><p class="eyebrow">✦ {pl ? 'PYTANIE DO LEKTURY' : 'A QUESTION FOR READING'}</p><h2>{pl ? 'Za kim chcesz podążyć?' : 'Whose path would you follow?'}</h2><p>{pl ? 'Jedna postać biegnie za nieznanym, druga spotyka kogoś ze swojej przeszłości. Zastanów się, jak ta różnica wpływa na Twoje oczekiwania - bez wybiegania poza przeczytany fragment.' : 'One character runs toward the unknown; the other meets someone from his past. Consider how that difference shapes your expectations without looking beyond what you have read.'}</p></aside>
  {Object.keys(openingPositions).length > 0 && <section class="compare-next" aria-labelledby="compare-next-heading"><div><p class="eyebrow">✦ {pl ? 'ODKRYWAJ DALEJ' : 'KEEP EXPLORING'}</p><h2 id="compare-next-heading">{pl ? 'Wybierz swoją historię.' : 'Choose your story.'}</h2><p>{pl ? 'Wybierz mapę, która zaczyna się w tym samym miejscu co porównanie.' : 'Choose a map that begins at the same point as this comparison.'}</p></div><div class="compare-next-options">{books.filter((book) => openingPositions[book.slug]).map((book) => <a href={`/books/${encodeURIComponent(book.slug)}/map?lang=${lang}&volume=${openingPositions[book.slug].volume}&chapter=${openingPositions[book.slug].chapter}`}><span class="compare-next-kicker">{book.slug === 'alices-adventures-in-wonderland' ? (pl ? 'CIEKAWOŚĆ / ALICJA' : 'CURIOSITY / ALICE') : (pl ? 'PRZESZŁOŚĆ / SCROOGE' : 'THE PAST / SCROOGE')}</span><strong>{book.title}</strong><span class="compare-next-scope">{pl ? 'Tom' : 'Volume'} {openingPositions[book.slug].volume} · {pl ? 'Rozdział' : 'Chapter'} {openingPositions[book.slug].chapter}</span><span class="compare-next-action">{pl ? 'Otwórz mapę' : 'Open the map'} ↗</span></a>)}</div></section>}
  <section class="compare-sources"><h2>{pl ? 'Teksty źródłowe' : 'Source texts'}</h2><p>{pl ? 'Linki prowadzą do pełnych książek i mogą ujawnić późniejsze wydarzenia.' : 'These links open the full books and may reveal later events.'}</p><ul><li><a href="https://www.gutenberg.org/cache/epub/28885/pg28885-images.html">Lewis Carroll - Alice’s Adventures in Wonderland, Project Gutenberg ↗</a></li><li><a href="https://www.gutenberg.org/files/46/46-h/46-h.htm">Charles Dickens - A Christmas Carol, Project Gutenberg ↗</a></li></ul></section></div></main><SiteFooter lang={lang} />
</Layout>
<style>
.compare-hero{background:#334b3d;color:#f6f4ed}.compare-hero-inner{display:grid;grid-template-columns:1.3fr 1fr;gap:60px;align-items:center;padding-block:65px 80px}.compare-back{font-size:13px;text-decoration:underline;text-underline-offset:4px}.compare-kicker{font-size:10px;letter-spacing:.16em;font-weight:700;color:#e3b799;margin-top:60px}.compare-hero h1{font:500 clamp(47px,5.7vw,78px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:24px 0}.compare-hero h1 em{font-weight:400;color:#e3b799}.compare-hero-inner>div>p:last-child{line-height:1.8;color:#dce5d8;max-width:500px}.compare-emblems{display:grid;grid-template-columns:1fr 1fr;gap:12px}.compare-emblems div{height:300px;border:1px solid #8ba391;border-radius:48% 48% 0 0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;color:#e3b799}.compare-emblems div:last-child{background:#925f48;border-color:#925f48;color:#f6f4ed}.compare-emblems span{font-size:70px}.compare-emblems small{font-size:10px;letter-spacing:.15em}.compare-content{padding-block:65px 100px}.compare-scope{background:#e9e5d9;border-left:4px solid #a35e3e;padding:20px 25px;line-height:1.7;font-size:14px;color:#405448}.compare-columns{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:65px;font-size:10px;font-weight:700;letter-spacing:.14em;color:#985438}.compare-row{padding:35px 0;border-top:1px solid #aab8a8}.compare-row-heading{display:flex;gap:25px;align-items:baseline}.compare-row-heading>span{font:400 32px 'Playfair Display',serif;color:#a35e3e}.compare-row h2,.compare-question h2,.compare-next h2{font:500 clamp(28px,3vw,40px) 'Playfair Display',serif;margin:0 0 20px}.compare-pair{display:grid;grid-template-columns:1fr 1fr;gap:20px}.compare-pair article{padding:25px 30px;background:#e6ebe0}.compare-pair article:last-child{background:#eae2d6}.compare-pair article>p:not(.compare-label){font-size:16px;line-height:1.8;color:#405448}.compare-label{font-size:10px;font-weight:700;letter-spacing:.12em;color:#985438}.compare-question{background:#334b3d;color:#fff;padding:40px;margin-top:30px}.compare-question .eyebrow{color:#e3b799}.compare-question p:not(.eyebrow){line-height:1.8;color:#dce5d8;max-width:820px}.compare-next{display:grid;grid-template-columns:1fr 1fr;gap:45px;padding:50px 0}.compare-next p:not(.eyebrow){line-height:1.7;color:#405448}.compare-next a{display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-bottom:1px solid #b5c4b4;font:500 22px 'Playfair Display',serif}.compare-next a:hover{text-decoration:underline;text-underline-offset:5px}.compare-sources{border-top:1px solid #aab8a8;padding-top:25px}.compare-sources h2{font:500 25px 'Playfair Display',serif}.compare-sources p,.compare-sources li{font-size:13px;line-height:1.7;color:#405448}.compare-sources a{text-decoration:underline;text-underline-offset:4px}@media(max-width:760px){.compare-hero-inner{grid-template-columns:1fr;gap:25px;padding-block:45px 55px}.compare-kicker{margin-top:45px}.compare-emblems div{height:160px}.compare-emblems span{font-size:48px}.compare-content{padding-block:40px 70px}.compare-columns{display:none}.compare-row{padding:28px 0}.compare-pair,.compare-next{grid-template-columns:1fr}.compare-pair{gap:10px}.compare-pair article,.compare-question{padding:24px}.compare-next{gap:10px}}
</style>

<style>
.compare-doorways{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.compare-doorways a{min-height:300px;display:flex;flex-direction:column;align-items:start;justify-content:end;gap:12px;padding:26px;border:1px solid #8ba391;background:#263e33;color:#fff}.compare-doorways a:nth-child(even){background:#80533e;border-color:#80533e}.compare-doorways-mark{font-size:44px;color:#f0c3a5;margin-bottom:auto}.compare-doorways-label{font-size:10px;font-weight:700;letter-spacing:.14em;color:#f0c3a5}.compare-doorways strong{font:500 25px/1.15 'Playfair Display',serif;overflow-wrap:anywhere}.compare-doorways-action{border-top:1px solid #b8c6b5;padding-top:14px;width:100%;font-size:12px;font-weight:700}.compare-doorways a:hover .compare-doorways-action{text-decoration:underline;text-underline-offset:4px}.compare-doorways a:focus-visible{outline:3px solid #f0c3a5;outline-offset:4px}@media(max-width:760px){.compare-doorways a{min-height:225px;padding:20px}.compare-doorways strong{font-size:20px}.compare-doorways-mark{font-size:34px}}@media(max-width:360px){.compare-doorways{grid-template-columns:1fr}.compare-doorways a{min-height:190px}}
</style>

<style>.compare-next{grid-template-columns:1fr;gap:24px}.compare-next-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.compare-next-options a{display:flex;flex-direction:column;align-items:start;gap:14px;min-height:230px;padding:25px;background:#334b3d;color:#f6f4ed;border:0;text-decoration:none}.compare-next-options a:nth-child(even){background:#80533e}.compare-next-options .compare-next-kicker{font:700 10px/1.3 sans-serif;letter-spacing:.12em;color:#f0c3a5}.compare-next-options strong{font:500 clamp(25px,3vw,38px)/1.12 'Playfair Display',serif;overflow-wrap:anywhere}.compare-next-options .compare-next-scope{font:400 13px/1.5 sans-serif;color:#f6f4ed}.compare-next-options .compare-next-action{width:100%;border-top:1px solid #b5c4b4;padding-top:14px;margin-top:auto;font:700 13px/1.4 sans-serif}.compare-next-options a:hover .compare-next-action{text-decoration:underline;text-underline-offset:4px}.compare-next-options a:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}@media(max-width:600px){.compare-next-options{grid-template-columns:1fr}.compare-next-options a{min-height:190px}}</style>
