---
import Bookcase from '../components/Bookcase.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tailwind.css';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const t = lang === 'pl' ? {
  nav: 'Biblioteka', explore: 'Odkryj książki', eyebrow: 'KAŻDA HISTORIA MA SWOJĄ KONSTELACJĘ',
  title1: 'Zobacz historie', title2: 'w nowym świetle.', intro: 'Poznaj bohaterów, odkryj ich powiązania i podążaj za opowieścią we własnym tempie.',
  button: 'Odkryj bibliotekę', note: 'Twój towarzysz w świecie książek', section: 'WYBIERZ SWOJĄ HISTORIĘ', heading: 'Wkrocz do innego świata', desc: 'Odkryj historie i postacie, które w nich żyją.', loading: 'Ładowanie biblioteki...', empty: 'Biblioteka jest przygotowywana. Wróć wkrótce.', footer: 'Historie są lepsze, gdy widzisz ich powiązania.', switch: 'English', ticker1:'KAŻDY BOHATER', ticker2:'KAŻDA RELACJA', ticker3:'JEDNA HISTORIA NARAZ', manifestoEyebrow:'ODROBINA MAGII', manifestoTitle:'Każda strona to', manifestoEm:'nowe połączenie.', manifestoText:'Odkrywaj powiązania między bohaterami, rozdział po rozdziale.'
} : {
  nav: 'Library', explore: 'Explore books', eyebrow: 'EVERY STORY HAS A CONSTELLATION',
  title1: 'See stories in', title2: 'a different light.', intro: 'Meet the characters, discover their connections, and follow the story at your own pace.',
  button: 'Explore the library', note: 'Your companion between the pages', section: 'CHOOSE YOUR STORY', heading: 'Step into another world', desc: 'Discover stories and the characters who live in them.', loading: 'Loading the library...', empty: 'The library is being prepared. Please come back soon.', footer: 'Stories are better when you see the connections.', switch: 'Polski', ticker1:'EVERY CHARACTER', ticker2:'EVERY CONNECTION', ticker3:'ONE STORY AT A TIME', manifestoEyebrow:'A LITTLE MORE WONDER', manifestoTitle:'Every page is a', manifestoEm:'new connection.', manifestoText:'Follow the threads between characters as their stories unfold, chapter by chapter.'
};
const api = import.meta.env.PUBLIC_API_URL;
type Book = { slug: string; title: string; author: string };
let books: Book[] = [];
try {
  const response = api ? await fetch(`${api}/api/books`) : await env.API.fetch(new Request(`${Astro.url.origin}/api/books`));
  if (response.ok) books = (await response.json()).books;
} catch { /* Keep the page usable when the catalog is unavailable. */ }
const featured = books.slice(0, 2);
type CastMember = { slug: string; name: string; descriptions: { text: string }[] };
type CastStory = { book: Book; progress: { volume: number; chapter: number }; characters: CastMember[] };
const castStories = (await Promise.all(featured.map(async (book): Promise<CastStory | null> => {
  try {
    const url = `${api || Astro.url.origin}/api/books/${encodeURIComponent(book.slug)}`;
    const response = api ? await fetch(url) : await env.API.fetch(new Request(url));
    if (!response.ok) return null;
    const data = await response.json();
    return data.story.characters.length ? { book, progress: data.progress, characters: data.story.characters.slice(0, 2) } : null;
  } catch { return null; }
}))).filter((story): story is CastStory => story !== null);

---
<Layout lang={lang} title={lang === 'pl' ? 'Castellation - odkrywaj bohaterów książek i ich relacje' : 'Castellation - discover book characters and their connections'} description={lang === 'pl' ? 'Odkrywaj bohaterów książek i ich relacje we własnym tempie, bez spoilerów.' : 'Explore book characters and their connections at your own pace, without spoilers.'}>
  <SiteHeader lang={lang} />
  <main>
    <section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span>✦</span> {t.eyebrow}</p><h1>{t.title1}<br /><em>{t.title2}</em></h1><p class="hero-intro">{t.intro}</p><a class="primary-button" href={`/library?lang=${lang}`}>{t.button}<span>↗</span></a><div class="hero-how" aria-label={lang === 'pl' ? 'Jak zacząć' : 'How to begin'}><div><span>01</span><strong>{lang === 'pl' ? 'Wybierz rozdział' : 'Choose a chapter'}</strong></div><span aria-hidden="true">→</span><div><span>02</span><strong>{lang === 'pl' ? 'Odkryj powiązania' : 'Explore connections'}</strong></div><a href={`/our-method?lang=${lang}#reading-boundary`}>{lang === 'pl' ? 'Jak ograniczamy spoilery' : 'How we limit spoilers'} ↗</a></div></div>{featured.length > 0 && <Bookcase books={featured} lang={lang} label={lang === 'pl' ? t.section : undefined} actionLabel={lang === 'pl' ? t.heading : undefined} note={lang === 'pl' ? t.note : undefined} /> }</section>
    <section id="resume-shelf" class="resume-shelf wrap" data-api={api || Astro.url.origin} data-lang={lang} hidden aria-labelledby="resume-title"><div class="resume-heading"><div><p class="eyebrow" id="resume-source-label">✦ {lang === 'pl' ? 'TWOJE HISTORIE NA TYM URZĄDZENIU' : 'YOUR STORIES ON THIS DEVICE'}</p><h2 id="resume-title">{lang === 'pl' ? 'Wróć do historii.' : 'Return to your stories.'}</h2></div><p id="resume-source-description">{lang === 'pl' ? 'Lokalny zapis z tej przeglądarki - osobny od postępu konta.' : 'A local copy from this browser, separate from account progress.'}</p></div><div class="resume-list">{books.map((book) => <a class="resume-item" data-slug={book.slug} hidden><span aria-hidden="true">✳</span><span><strong>{book.title}</strong><small class="resume-position"></small></span><span class="resume-action">{lang === 'pl' ? 'Wróć do mapy' : 'Return to the map'} ↗</span></a>)}</div></section>
    <div class="ticker" aria-hidden="true"><span>{t.ticker1}</span><i>✳</i><span>{t.ticker2}</span><i>✳</i><span>{t.ticker3}</span><i>✳</i><span>{t.ticker1}</span><i>✳</i><span>{t.ticker2}</span></div>
    {castStories.length > 0 && <section class="home-cast wrap" aria-labelledby="home-cast-title"><div class="home-cast-intro"><p class="eyebrow">✦ {lang === 'pl' ? 'ZACZNIJ OD BOHATERA' : 'START WITH A CHARACTER'}</p><h2 id="home-cast-title">{lang === 'pl' ? 'Kogo spotkasz' : 'Who will you'}<br /><em>{lang === 'pl' ? 'na początku?' : 'meet first?'}</em></h2><p>{lang === 'pl' ? 'Poznaj postacie z początków historii i wybierz, za kim chcesz podążyć.' : 'Meet characters from the beginnings of our stories and choose who to follow.'}</p><a class="home-cast-all" href={`/characters?lang=${lang}`}>{lang === 'pl' ? 'Zobacz wszystkich bohaterów' : 'Meet more characters'} ↗</a></div><div class="home-cast-stories">{castStories.map((story) => <div class="home-cast-story"><p class="home-cast-book">{story.book.title} <span> / {story.book.author}</span></p><ul>{story.characters.map((character) => <li><a href={`/books/${encodeURIComponent(story.book.slug)}/characters/${encodeURIComponent(character.slug)}?lang=${lang}&volume=${story.progress.volume}&chapter=${story.progress.chapter}`}><span class="home-cast-initial" aria-hidden="true">{character.name.slice(0, 1)}</span><span class="home-cast-person"><strong>{character.name}</strong>{character.descriptions.at(-1)?.text && <span>{character.descriptions.at(-1)?.text}</span>}</span><span class="home-cast-arrow" aria-hidden="true">↗</span></a></li>)}</ul></div>)}</div></section>}
    <section class="first-scene wrap tw:my-16 tw:grid tw:overflow-hidden tw:bg-[#263e33] tw:text-[#f6f4ed] tw:md:my-24 tw:md:grid-cols-2" aria-labelledby="first-scene-title"><div class="tw:flex tw:flex-col tw:items-start tw:justify-center tw:p-7 tw:md:p-14"><p class="tw:text-xs tw:font-bold tw:tracking-[0.15em] tw:text-[#f0c3a5]">✦ {lang === 'pl' ? 'PIERWSZE SPOTKANIE / ROZDZIAŁ I' : 'FIRST ENCOUNTER / CHAPTER I'}</p><h2 id="first-scene-title" class="tw:my-6 tw:font-['Playfair_Display',serif] tw:text-4xl tw:leading-tight tw:tracking-tight tw:md:text-6xl">{lang === 'pl' ? 'Jedno spojrzenie.' : 'One glance.'}<br /><em class="tw:font-normal tw:text-[#f0c3a5]">{lang === 'pl' ? 'Cały świat.' : 'A whole world.'}</em></h2><p class="tw:max-w-md tw:leading-7 tw:text-[#e1e9df]">{lang === 'pl' ? 'Zanim Alicja i Biały Królik zamienią słowo, ciekawość prowadzi ją ich wspólnym tropem. Zobacz, jak zaczyna się historia.' : 'Before Alice and the White Rabbit exchange a word, curiosity draws her after him. See how their story begins.'}</p><a class="tw:mt-7 tw:inline-flex tw:min-h-12 tw:items-center tw:gap-8 tw:bg-[#f6f4ed] tw:px-5 tw:font-bold tw:text-[#263e33] tw:no-underline tw:hover:bg-[#e1e9df] tw:focus-visible:outline-2 tw:focus-visible:outline-offset-4 tw:focus-visible:outline-[#f0c3a5]" href={`/guides/alice-down-the-rabbit-hole?lang=${lang}`}>{lang === 'pl' ? 'Odkryj pierwszy rozdział' : 'Explore the first chapter'} ↗</a></div><div class="first-scene-art"><img src="/images/alice-rabbit-hole.webp" alt="" width="768" height="1152" loading="lazy" /><div class="first-scene-thread"><span>{lang === 'pl' ? 'ALICJA' : 'ALICE'}</span><span>{lang === 'pl' ? 'PODĄŻA ZA' : 'FOLLOWS'} →</span><span>{lang === 'pl' ? 'BIAŁY KRÓLIK' : 'WHITE RABBIT'}</span></div></div></section>
    <section class="reading-index wrap tw:py-16 tw:md:py-24" aria-labelledby="reading-index-title"><div class="tw:grid tw:gap-6 tw:border-t tw:border-[#9cad9e] tw:pt-8 tw:md:grid-cols-[1fr_1.1fr] tw:md:gap-16"><div><p class="tw:text-xs tw:font-bold tw:tracking-[0.15em] tw:text-[#87452c]">✦ {lang === 'pl' ? 'PRZEWODNIK CZYTELNIKA' : 'THE CASTELLATION READER'}</p><h2 id="reading-index-title" class="tw:my-6 tw:font-['Playfair_Display',serif] tw:text-4xl tw:leading-tight tw:tracking-tight tw:md:text-6xl">{lang === 'pl' ? 'Historia to więcej' : 'A story is more'} <em class="tw:font-normal tw:text-[#a35e3e]">{lang === 'pl' ? 'niż jej zakończenie.' : 'than its ending.'}</em></h2><p class="tw:max-w-md tw:leading-7 tw:text-[#405448]">{lang === 'pl' ? 'Wybierz perspektywę i odkryj nowy sposób czytania.' : 'Choose a perspective and discover a new way to read.'}</p><a class="tw:mt-5 tw:inline-flex tw:min-h-12 tw:items-center tw:font-bold tw:underline tw:underline-offset-4" href={`/guides?lang=${lang}`}>{lang === 'pl' ? 'Wszystkie przewodniki' : 'All reading guides'} ↗</a></div><div class="reading-index-list"><a href={lang === 'pl' ? '/guides/track-characters?lang=pl' : '/guides/reading-character-connections?lang=en'}><span class="reading-index-number">01</span><span><small>{lang === 'pl' ? 'PRAKTYKA CZYTANIA' : 'THE READING PRACTICE'}</small><strong>{lang === 'pl' ? 'Zapamiętaj bohaterów.' : 'Read between characters.'}</strong><span>{lang === 'pl' ? 'Proste sposoby na śledzenie postaci bez spoilerów.' : 'Notice how relationships change, one encounter at a time.'}</span></span><span aria-hidden="true">↗</span></a><a href={`/guides/alice-down-the-rabbit-hole?lang=${lang}`}><span class="reading-index-number">02</span><span><small>{lang === 'pl' ? 'BLIŻSZE SPOJRZENIE' : 'A CLOSER READING'}</small><strong>{lang === 'pl' ? 'Podążaj za Alicją.' : 'Follow Alice.'}</strong><span>{lang === 'pl' ? 'Przyjrzyj się ciekawości, która rozpoczyna niezwykłą podróż.' : 'Look closer at the curiosity that begins an extraordinary journey.'}</span></span><span aria-hidden="true">↗</span></a><a href={`/guides/two-unexpected-beginnings?lang=${lang}`}><span class="reading-index-number">03</span><span><small>{lang === 'pl' ? 'DWA POCZĄTKI' : 'TWO BEGINNINGS'}</small><strong>{lang === 'pl' ? 'Porównaj dwa światy.' : 'Compare two worlds.'}</strong><span>{lang === 'pl' ? 'Zestaw początki opowieści Alicji i Scrooge’a.' : 'Compare the opening worlds of Alice and Scrooge.'}</span></span><span aria-hidden="true">↗</span></a></div></div></section>
    <section class="next-step" aria-labelledby="next-step-title"><div class="wrap next-step-inner"><div class="next-step-heading"><p class="eyebrow">✳ {lang === 'pl' ? 'TWOJA KOLEJ NA ODKRYWANIE' : 'YOUR TURN TO EXPLORE'}</p><h2 id="next-step-title">{lang === 'pl' ? 'Każda historia ma' : 'Every story has'} <em>{lang === 'pl' ? 'swój początek.' : 'a beginning.'}</em></h2><p>{lang === 'pl' ? 'Wybierz własną drogę do bohaterów i ich powiązań.' : 'Choose your way into the characters and their connections.'}</p></div><div class="next-step-options"><a href={`/books/alices-adventures-in-wonderland/map?lang=${lang}&volume=1&chapter=1`}><span class="next-step-number">01 / {lang === 'pl' ? 'ZACZNIJ OD PRZYKŁADU' : 'START WITH AN EXAMPLE'}</span><strong>{lang === 'pl' ? 'Odkryj mapę Alicji.' : 'Explore Alice’s map.'}</strong><span>{lang === 'pl' ? 'Zobacz bohaterów pierwszego rozdziału.' : 'Meet the characters from the first chapter.'}</span><b>{lang === 'pl' ? 'Otwórz mapę' : 'Open the map'} ↗</b></a><a href={`/library?lang=${lang}`}><span class="next-step-number">02 / {lang === 'pl' ? 'WYBIERZ HISTORIĘ' : 'CHOOSE A STORY'}</span><strong>{lang === 'pl' ? 'Znajdź swoją książkę.' : 'Find your book.'}</strong><span>{lang === 'pl' ? 'Poznaj dostępne historie w bibliotece.' : 'Explore the stories in the library.'}</span><b>{lang === 'pl' ? 'Odkryj bibliotekę' : 'Explore the library'} ↗</b></a></div></div></section>
  </main><SiteFooter lang={lang} />
<script>
  const shelf = document.querySelector<HTMLElement>('#resume-shelf');
  if (shelf) {
    const api = shelf.dataset.api;
    const lang = shelf.dataset.lang;
    const items = [...shelf.querySelectorAll<HTMLAnchorElement>('.resume-item')];
    const valid = (saved: any) => Number.isSafeInteger(saved?.volume) && saved.volume > 0 && Number.isSafeInteger(saved?.chapter) && saved.chapter > 0;
    const local = items.flatMap((item) => {
      try { const saved = JSON.parse(localStorage.getItem(`castellation:guest-progress:${item.dataset.slug}`) || 'null'); return valid(saved) ? [{ item, saved }] : []; } catch { return []; }
    });
    if (api && items.length) {
      const check = async () => {
        let first: Response | undefined;
        try { first = await fetch(`${api}/api/progress/${encodeURIComponent(items[0].dataset.slug || '')}`, { credentials: 'include' }); } catch { /* A separate local copy may remain available. */ }
        let candidates = local;
        if (first?.ok) {
          const accountResults = await Promise.all(items.map(async (item, index) => {
            try {
              const response = index === 0 ? first : await fetch(`${api}/api/progress/${encodeURIComponent(item.dataset.slug || '')}`, { credentials: 'include' });
              if (!response?.ok) return null;
              const { progress } = await response.json();
              return valid(progress) ? { item, saved: progress } : null;
            } catch { return null; }
          }));
          candidates = accountResults.filter((entry): entry is NonNullable<typeof entry> => entry !== null);
          shelf.querySelector('#resume-source-label')!.textContent = lang === 'pl' ? '✦ TWOJE HISTORIE NA KONCIE' : '✦ YOUR ACCOUNT STORIES';
          shelf.querySelector('#resume-source-description')!.textContent = lang === 'pl' ? 'Postęp zapisany na Twoim koncie.' : 'Progress saved to your account.';
        } else if (first && first.status !== 401 && first.status < 500) return;
        const results = await Promise.all(candidates.map(async ({ item, saved }) => {
          try { const response = await fetch(`${api}/api/books/${encodeURIComponent(item.dataset.slug || '')}?volume=${saved.volume}&chapter=${saved.chapter}`); return response.ok ? { item, saved } : null; } catch { return null; }
        }));
        results.forEach((entry) => {
          if (!entry) return;
          const { item, saved } = entry;
          item.href = `/books/${encodeURIComponent(item.dataset.slug || '')}/map?lang=${lang}&volume=${saved.volume}&chapter=${saved.chapter}`;
          item.querySelector('.resume-position')!.textContent = lang === 'pl' ? `Tom ${saved.volume} · Rozdział ${saved.chapter}` : `Volume ${saved.volume} · Chapter ${saved.chapter}`;
          item.hidden = false;
        });
        if (results.some(Boolean)) shelf.hidden = false;
      };
      void check();
    }
  }
</script>
</Layout>

<style>
.encounter{display:grid;grid-template-columns:1fr 1.15fr;gap:8%;align-items:center;padding-block:100px}.encounter-copy h2{font:500 clamp(42px,5vw,70px)/1.05 'Playfair Display',serif;letter-spacing:-.04em;margin:24px 0}.encounter-copy h2 em{color:#a35e3e;font-weight:400}.encounter-copy>p:not(.eyebrow){max-width:390px;line-height:1.8;color:#405448}.encounter-copy>a{display:inline-block;margin-top:20px;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.encounter-map{background:#dce5d8;min-height:390px;padding:40px;display:flex;align-items:center;position:relative;gap:14px}.encounter-node{width:42%;aspect-ratio:1;border:1px solid #7b9782;border-radius:50%;display:flex;flex-direction:column;justify-content:center;text-align:center;gap:12px;padding:12px}.encounter-node small,.encounter-line,.encounter-caption{font-size:9px;font-weight:700;letter-spacing:.12em}.encounter-node strong{font:500 clamp(20px,2.5vw,32px)/1.1 'Playfair Display',serif}.encounter-node>span{font-size:12px;line-height:1.4}.encounter-line{flex:1;border-top:1px solid #a35e3e;text-align:center;color:#87452c;white-space:nowrap}.encounter-line span{position:relative;top:-18px}.encounter-caption{position:absolute;bottom:22px;left:40px}.encounter-map:hover strong{text-decoration:underline;text-underline-offset:4px}.encounter-map:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}@media(max-width:760px){.encounter{grid-template-columns:1fr;gap:35px;padding-block:65px}.encounter-map{min-height:290px;padding:25px;gap:8px}.encounter-caption{left:25px}.encounter-node{width:40%}.encounter-node strong{font-size:20px}.encounter-node>span{font-size:11px}}
</style>

<style>
.home-cast{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:7%;padding-block:90px 100px}.home-cast-intro{align-self:start;position:sticky;top:30px}.home-cast-intro h2{font:500 clamp(42px,5vw,68px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:22px 0}.home-cast-intro h2 em{font-weight:400;color:#a35e3e}.home-cast-intro>p:not(.eyebrow){max-width:365px;color:#405448;line-height:1.75}.home-cast-all{display:inline-block;margin-top:20px;background:#293f34;color:#fff;padding:17px 20px;font-size:13px;font-weight:700}.home-cast-all:hover{background:#3d5a49}.home-cast-story{background:#e1e9dd;padding:24px 28px;margin-bottom:16px}.home-cast-story:nth-child(even){background:#eee4d9}.home-cast-book{font-size:12px;font-weight:700;margin:0 0 10px}.home-cast-book span{font-weight:400;color:#53675a}.home-cast-story ul{list-style:none;padding:0;margin:0}.home-cast-story li+li{border-top:1px solid #b1c1b1}.home-cast-story a{display:grid;grid-template-columns:56px minmax(0,1fr) auto;align-items:center;gap:16px;padding:18px 0}.home-cast-initial{width:56px;height:56px;display:grid;place-items:center;border-radius:50%;background:#334b3d;color:#fff;font:500 30px 'Playfair Display',serif}.home-cast-person{display:flex;flex-direction:column;gap:6px;min-width:0}.home-cast-person strong{font:500 clamp(22px,2.4vw,30px)/1.15 'Playfair Display',serif;overflow-wrap:anywhere}.home-cast-person>span{font-size:13px;line-height:1.5;color:#405448}.home-cast-arrow{font-size:22px;color:#985438}.home-cast-story a:hover strong{text-decoration:underline;text-underline-offset:4px}.home-cast a:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}@media(max-width:760px){.home-cast{grid-template-columns:1fr;gap:30px;padding-block:60px}.home-cast-intro{position:static}.home-cast-intro h2{font-size:42px}.home-cast-story{padding:20px}.home-cast-story a{grid-template-columns:48px minmax(0,1fr) auto;gap:12px}.home-cast-initial{width:48px;height:48px;font-size:25px}}
</style>

<style>
.first-scene-art{position:relative;min-height:440px;overflow:hidden;background:#1d3026}.first-scene-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%}.first-scene-art:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(20,35,27,.96),transparent 60%)}.first-scene-thread{position:absolute;z-index:1;inset:auto 30px 30px;display:flex;flex-wrap:wrap;align-items:center;gap:12px;color:white;font-size:11px;font-weight:700;letter-spacing:.1em}.first-scene-thread span:nth-child(2){color:#f0c3a5}@media(max-width:760px){.first-scene-art{min-height:300px}.first-scene-thread{inset:auto 24px 24px}}
</style>

<style>
.reading-index-list{border-top:1px solid #9cad9e}.reading-index-list>a{display:grid;grid-template-columns:48px 1fr auto;gap:18px;padding:25px 0;border-bottom:1px solid #9cad9e}.reading-index-number{font:400 32px 'Playfair Display',serif;color:#a35e3e}.reading-index-list small,.reading-index-list strong,.reading-index-list a>span:nth-child(2)>span{display:block}.reading-index-list small{font-size:10px;font-weight:700;letter-spacing:.12em;color:#87452c}.reading-index-list strong{font:500 clamp(25px,3vw,37px)/1.15 'Playfair Display',serif;margin:12px 0}.reading-index-list a>span:nth-child(2)>span{font-size:14px;line-height:1.6;color:#405448}.reading-index-list a>span:last-child{font-size:23px;color:#87452c}.reading-index-list a:hover strong{text-decoration:underline;text-underline-offset:5px}.reading-index-list a:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}@media(max-width:760px){.reading-index-list>a{grid-template-columns:36px 1fr auto;gap:10px}.reading-index-number{font-size:25px}}
</style>
<style>
@media(max-width:760px){.hero{grid-template-columns:minmax(0,1fr)}.hero-copy{min-width:0}}
</style>

<style>
.hero-how{display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:center;border-top:1px solid #aab8a8;margin-top:34px;padding-top:20px;max-width:480px}.hero-how div{display:flex;flex-direction:column;gap:7px}.hero-how div span{font-size:10px;font-weight:700;letter-spacing:.12em;color:#87452c}.hero-how strong{font:500 20px/1.15 'Playfair Display',serif}.hero-how>span{color:#a35e3e;font-size:22px}.hero-how>a{grid-column:1/-1;font-size:12px;font-weight:700;text-decoration:underline;text-underline-offset:4px;color:#405448;margin-top:5px}.hero-how a:focus-visible{outline:3px solid #a35e3e;outline-offset:4px}@media(max-width:760px){.hero-how{gap:10px;margin-top:26px}.hero-how strong{font-size:18px}}
