---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
let example;
const api = import.meta.env.PUBLIC_API_URL;
try {
  const request = (path) => api ? fetch(`${api}${path}`) : env.API.fetch(new Request(`${Astro.url.origin}${path}`));
  const catalog = await request('/api/books');
  if (catalog.ok) {
    const { books } = await catalog.json();
    const results = await Promise.all(books.slice(0, 2).map(async (book) => {
      try {
        const response = await request(`/api/books/${encodeURIComponent(book.slug)}`);
        return response.ok ? await response.json() : null;
      } catch { return null; }
    }));
    example = results.find((data) => data?.book.positions.length > 1 && data.story.characters.length > 0)
      || results.find((data) => data?.story.characters.length > 0);
  }
} catch { /* The guide remains available if the catalog is temporarily unavailable. */ }
const steps = pl ? [
  { number: '01', title: 'Wybierz historię', text: 'Otwórz książkę z biblioteki i przejdź do jej mapy bohaterów.', visual: 'A WORLD OF STORIES', mark: '✳' },
  { number: '02', title: 'Ustaw swój postęp', text: 'Wybierz w mapie tom i rozdział, do którego już dotarłeś. Mapa pokazuje informacje dostępne do tego miejsca.', visual: 'YOUR READING PROGRESS', mark: '01 → 02' },
  { number: '03', title: 'Odkrywaj powiązania', text: 'Przeglądaj postacie, ich relacje i wydarzenia. Otwórz profil bohatera, aby zobaczyć jego połączenia.', visual: 'CHARACTERS & CONNECTIONS', mark: '✦ — ✦' },
] : [
  { number: '01', title: 'Choose a story', text: 'Open a book from the library and step into its character map.', visual: 'A WORLD OF STORIES', mark: '✳' },
  { number: '02', title: 'Set your reading progress', text: 'Choose the volume and chapter you have reached on the map. It shows information available up to that point.', visual: 'YOUR READING PROGRESS', mark: '01 → 02' },
  { number: '03', title: 'Follow the connections', text: 'Explore characters, relationships and events. Open a character profile to see their connections.', visual: 'CHARACTERS & CONNECTIONS', mark: '✦ — ✦' },
];
---
<Layout lang={lang} title={pl ? 'Jak działa mapa bohaterów książki - Castellation' : 'How a book character map works - Castellation'} description={pl ? 'Dowiedz się, jak odkrywać bohaterów książek i ich relacje, wybierając własny postęp czytania.' : 'Learn how to explore book characters and their connections at your own reading pace.'}>
  <SiteHeader lang={lang} />
  <main><section class="guide-hero"><div class="wrap guide-hero-inner guide-hero-experience"><div class="guide-hero-copy"><p class="eyebrow">✦ {pl ? 'TWÓJ PRZEWODNIK' : 'YOUR READER’S GUIDE'}</p><h1>{pl ? 'Czytaj we' : 'Follow stories'}<br /><em>{pl ? 'własnym tempie.' : 'at your pace.'}</em></h1><p>{pl ? 'Wybierz przeczytany rozdział i odkrywaj postacie oraz ich relacje w swoim tempie.' : 'Choose the chapter you have read and discover characters and their connections at your pace.'}</p><a class="primary-button" href={`/library?lang=${lang}`}>{pl ? 'Wybierz książkę' : 'Choose a book'} <span aria-hidden="true">↗</span></a><p class="guide-hero-limit"><a href={`/our-method?lang=${lang}#reading-boundary`}>{pl ? 'Jak ograniczamy spoilery' : 'How we limit spoilers'} ↗</a></p></div>{example && <section class="reading-demo" aria-labelledby="reading-demo-title" data-api={api || Astro.url.origin} data-slug={example.book.slug} data-lang={lang}><div class="reading-demo-intro"><p class="eyebrow">✦ {pl ? 'SPRAWDŹ NA PRZYKŁADZIE' : 'TRY IT WITH A STORY'}</p><h2 id="reading-demo-title">{pl ? 'Twoja lektura' : 'Your reading'}<br /><em>{pl ? 'wyznacza granicę.' : 'sets the boundary.'}</em></h2><p>{pl ? 'Zobacz, jak wybór rozdziału zmienia dostępne postacie. Wybierz tylko to, co już przeczytano.' : 'See how your chapter changes the characters you can discover. Choose only what you have read.'}</p></div><div class="reading-demo-panel"><div class="reading-demo-top"><span>{example.book.title}</span><span id="demo-position">{pl ? 'Tom' : 'Volume'} {example.progress.volume} · {pl ? 'Rozdział' : 'Chapter'} {example.progress.chapter}</span></div><form id="demo-form" hidden><label for="demo-select">{pl ? 'Przeczytano do' : 'Read up to'}</label><div><select id="demo-select">{example.book.positions.slice(0, 2).map((position) => <option value={`${position.volume}:${position.chapter}`} selected={position.volume === example.progress.volume && position.chapter === example.progress.chapter}>{pl ? 'Tom' : 'Volume'} {position.volume} · {pl ? 'Rozdział' : 'Chapter'} {position.chapter}</option>)}</select><button type="submit">{pl ? 'Pokaż' : 'Show'}</button></div></form><div class="demo-characters" aria-live="polite" aria-atomic="true"><p id="demo-count">{lang === 'pl' ? 'Dostępne postacie' : 'Available characters'}: {example.story.characters.length}</p><ul id="demo-list">{example.story.characters.map((character) => <li><a href={`/books/${encodeURIComponent(example.book.slug)}/characters/${encodeURIComponent(character.slug)}?lang=${lang}&volume=${example.progress.volume}&chapter=${example.progress.chapter}`}><span aria-hidden="true">{character.name.slice(0, 1)}</span><strong>{character.name}</strong><small>{pl ? 'Otwórz profil' : 'Open profile'} ↗</small></a></li>)}</ul></div><p id="demo-status" role="status"></p><a id="demo-map" href={`/books/${encodeURIComponent(example.book.slug)}/map?lang=${lang}&volume=${example.progress.volume}&chapter=${example.progress.chapter}`}>{pl ? 'Otwórz mapę na tym etapie' : 'Open the map at this chapter'} ↗</a></div></section>}</div></section>
    <section class="wrap guide-steps" aria-labelledby="guide-steps-title"><div class="collection-bar"><h2 id="guide-steps-title">{pl ? 'Trzy kroki do historii' : 'Three steps into the story'}</h2><span>01 - 03</span></div>{steps.map((step) => <article class="guide-step"><div class="guide-step-copy"><span class="guide-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></div><div class="guide-visual" aria-hidden="true"><span>{step.visual}</span><strong>{step.mark}</strong></div></article>)}</section>
    <section class="wrap method-promo"><div><p class="eyebrow">✦ {pl ? 'ZA MAPĄ' : 'BEHIND THE MAP'}</p><h2>{pl ? 'Skąd biorą się informacje?' : 'Where do the details come from?'}</h2><p>{pl ? 'Poznaj nasze podejście do źródeł, AI i ograniczania spoilerów.' : 'Explore our approach to sources, AI and limiting spoilers.'}</p></div><a href={`/our-method?lang=${lang}`}>{pl ? 'Poznaj nasze podejście' : 'Explore our approach'} ↗</a></section>
    <section class="wrap help-promo"><div><p class="eyebrow">✦ {pl ? 'POMOC CZYTELNIKA' : 'READER HELP'}</p><h2>{pl ? 'Masz jeszcze pytania?' : 'Still have questions?'}</h2><p>{pl ? 'Sprawdź odpowiedzi o koncie, zapisie i rozdziałach.' : 'Find answers about accounts, saving and chapters.'}</p></div><a href={`/help?lang=${lang}`}>{pl ? 'Otwórz pomoc' : 'Visit reader help'} ↗</a></section>
    <section class="guide-cta"><div class="wrap"><p class="eyebrow">✦ {pl ? 'GOTOWY NA POCZĄTEK?' : 'READY TO BEGIN?'}</p><h2>{pl ? 'Twoja następna historia czeka.' : 'Your next story awaits.'}</h2><a class="primary-button" href={`/library?lang=${lang}`}>{pl ? 'Odkryj bibliotekę' : 'Explore the library'} <span aria-hidden="true">↗</span></a></div></section>
  </main><SiteFooter lang={lang} />
<script>
  const demo = document.querySelector<HTMLElement>('.reading-demo');
  const form = document.querySelector<HTMLFormElement>('#demo-form');
  const select = document.querySelector<HTMLSelectElement>('#demo-select');
  if (demo && form && select && select.options.length > 1) {
    form.hidden = false;
    let requestId = 0;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const [volume, chapter] = select.value.split(':');
      const pl = demo.dataset.lang === 'pl';
      const status = document.querySelector<HTMLElement>('#demo-status')!;
      const current = ++requestId;
      status.textContent = pl ? 'Ładowanie wybranego rozdziału...' : 'Loading the selected chapter...';
      try {
        const response = await fetch(`${demo.dataset.api}/api/books/${encodeURIComponent(demo.dataset.slug || '')}?volume=${encodeURIComponent(volume)}&chapter=${encodeURIComponent(chapter)}`);
        if (!response.ok) throw new Error('Unavailable');
        const data = await response.json();
        if (current !== requestId) return;
        const list = document.querySelector<HTMLElement>('#demo-list')!;
        list.replaceChildren(...data.story.characters.map((character: { name: string; slug: string }) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `/books/${encodeURIComponent(demo.dataset.slug || '')}/characters/${encodeURIComponent(character.slug)}?lang=${demo.dataset.lang}&volume=${data.progress.volume}&chapter=${data.progress.chapter}`;
          const initial = document.createElement('span'); initial.setAttribute('aria-hidden', 'true'); initial.textContent = character.name.slice(0, 1);
          const name = document.createElement('strong'); name.textContent = character.name;
          const action = document.createElement('small'); action.textContent = pl ? 'Otwórz profil ↗' : 'Open profile ↗';
          link.append(initial, name, action); item.append(link); return item;
        }));
        document.querySelector<HTMLElement>('#demo-count')!.textContent = `${pl ? 'Dostępne postacie' : 'Available characters'}: ${data.story.characters.length}`;
        document.querySelector<HTMLElement>('#demo-position')!.textContent = `${pl ? 'Tom' : 'Volume'} ${data.progress.volume} · ${pl ? 'Rozdział' : 'Chapter'} ${data.progress.chapter}`;
        document.querySelector<HTMLAnchorElement>('#demo-map')!.href = `/books/${encodeURIComponent(demo.dataset.slug || '')}/map?lang=${demo.dataset.lang}&volume=${data.progress.volume}&chapter=${data.progress.chapter}`;
        status.textContent = pl ? 'Przykład został zaktualizowany.' : 'Example updated.';
      } catch { if (current === requestId) status.textContent = pl ? 'Nie udało się załadować rozdziału. Spróbuj ponownie.' : 'Could not load this chapter. Please try again.'; }
    });
  }
</script>
</Layout>



<style>.method-promo{display:flex;align-items:end;justify-content:space-between;gap:35px;border-top:1px solid #b8c3b7;padding-block:50px 75px}.method-promo h2{font:500 clamp(30px,3vw,42px) 'Playfair Display',serif;margin:15px 0}.method-promo p:not(.eyebrow){color:#53675a;line-height:1.7}.method-promo a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px;white-space:nowrap}@media(max-width:760px){.method-promo{display:block;padding-block:40px 60px}.method-promo a{display:inline-block;margin-top:12px}}</style>

<style>.help-promo{display:flex;align-items:end;justify-content:space-between;gap:30px;padding:35px 40px;margin-bottom:75px;background:#e9e5d9}.help-promo h2{font:500 clamp(30px,3vw,40px) 'Playfair Display',serif;margin:15px 0}.help-promo p:not(.eyebrow){color:#405448;line-height:1.7}.help-promo a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px;white-space:nowrap}@media(max-width:760px){.help-promo{display:block;padding:25px;margin-bottom:55px}.help-promo a{display:inline-block;margin-top:12px}}</style>

<style>
.reading-demo{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:8%;padding-block:80px}.reading-demo-intro h2{font:500 clamp(40px,5vw,64px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:20px 0}.reading-demo-intro h2 em{font-weight:400;color:#a35e3e}.reading-demo-intro>p:not(.eyebrow){max-width:390px;color:#405448;line-height:1.75}.reading-demo-panel{background:#293f34;color:#f6f4ed;padding:30px 34px;min-width:0}.reading-demo-top{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;border-bottom:1px solid #829d88;padding-bottom:18px;font-size:12px;font-weight:700}.reading-demo-top span:last-child{color:#edc5ac}.reading-demo form{margin-top:22px}.reading-demo form[hidden]{display:none}.reading-demo label{display:block;font-size:12px;font-weight:700;margin-bottom:8px}.reading-demo form>div{display:flex}.reading-demo select{min-width:0;flex:1;padding:12px;background:#f6f4ed;color:#27352f;border:0;font-size:16px}.reading-demo button{background:#dfb194;color:#263d32;border:0;padding:12px 20px;font-weight:700;cursor:pointer}.reading-demo button:hover{background:#f0c9b0}.demo-characters{margin:28px 0 18px}.demo-characters p{color:#e8c0a5;font-size:12px;font-weight:700}.demo-characters ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;list-style:none;margin:0;padding:0}.demo-characters li{min-width:0}.demo-characters li a{min-height:120px;border:1px solid #91aa96;padding:14px;display:grid;grid-template-columns:34px minmax(0,1fr);gap:10px;align-content:start;text-decoration:none;transition:background .2s}.demo-characters li a:hover,.demo-characters li a:focus-visible{background:#496453}.demo-characters li a>span{grid-row:span 2;font:500 30px/1 'Playfair Display',serif;color:#f1c9b0}.demo-characters li strong{font:500 19px/1.2 'Playfair Display',serif;overflow-wrap:anywhere}.demo-characters li small{font-size:11px;font-weight:700;color:#f1c9b0}.reading-demo #demo-status{font-size:13px;line-height:1.5;min-height:1.5em;color:#f6f4ed}.reading-demo #demo-map{display:block;border-top:1px solid #829d88;padding-top:18px;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.reading-demo a:focus-visible,.reading-demo button:focus-visible,.reading-demo select:focus-visible{outline:3px solid #f0c9b0;outline-offset:3px}@media(max-width:760px){.reading-demo{grid-template-columns:1fr;gap:20px;padding-block:55px}.reading-demo-intro h2{font-size:40px}.reading-demo-panel{padding:24px}.reading-demo form>div{gap:0}.demo-characters li{font-size:17px}}
</style>

<style>
.guide-hero-experience{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:7%;align-items:center;padding-block:65px 75px}.guide-hero-copy h1{font-size:clamp(48px,5.5vw,78px)}.guide-hero-copy>p:not(.eyebrow){max-width:460px;color:#405448;line-height:1.8}.guide-hero-copy .guide-hero-limit{margin-top:20px;font-size:13px}.guide-hero-limit a{text-decoration:underline;text-underline-offset:4px;font-weight:700}.guide-hero-experience .reading-demo{display:block;padding:0;min-width:0}.guide-hero-experience .reading-demo-intro{margin-bottom:18px}.guide-hero-experience .reading-demo-intro h2{font-size:clamp(27px,3vw,38px);margin:12px 0}.guide-hero-experience .reading-demo-intro>p:not(.eyebrow){font-size:14px;line-height:1.6;margin-bottom:0}@media(max-width:760px){.guide-hero-experience{grid-template-columns:minmax(0,1fr);gap:38px;padding-block:45px 55px}.guide-hero-copy h1{font-size:48px}.guide-hero-experience .reading-demo-panel{padding:22px}}
</style>

<style>@media(max-width:380px){.demo-characters ul{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.demo-characters li a{transition:none}}</style>
