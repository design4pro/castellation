---
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
const lang = Astro.url.searchParams.get('lang') === 'pl' ? 'pl' : 'en';
const pl = lang === 'pl';
let stories = [], unavailable = false;
try {
  const api = import.meta.env.PUBLIC_API_URL;
  const request = (path) => api ? fetch(`${api}${path}`) : env.API.fetch(new Request(`${Astro.url.origin}${path}`));
  const catalog = await request('/api/books');
  if (!catalog.ok) throw new Error('Catalog unavailable');
  const { books } = await catalog.json();
  stories = (await Promise.all(books.map(async (book) => {
    const response = await request(`/api/books/${encodeURIComponent(book.slug)}`);
    if (!response.ok) throw new Error('Story unavailable');
    const data = await response.json();
    return { book: data.book, progress: data.progress, characters: data.story.characters };
  }))).filter((story) => story.characters.length > 0);
} catch { unavailable = true; Astro.response.status = 503; }
---
<Layout lang={lang} title={pl ? 'Bohaterowie książek - odkrywaj postacie i ich historie - Castellation' : 'Book characters - discover the people behind stories - Castellation'} description={pl ? 'Poznaj bohaterów z początków książek w bibliotece Castellation i odkrywaj ich historie.' : 'Meet characters from the beginnings of books in the Castellation library and explore their stories.'} noindex={unavailable || !stories.length}>
  <SiteHeader lang={lang} />
  <main class="wrap character-directory"><header class="directory-heading"><div><p class="eyebrow">✦ {pl ? 'BOHATEROWIE BIBLIOTEKI' : 'CHARACTERS IN THE LIBRARY'}</p><h1>{pl ? 'Każda historia' : 'Every story'}<br /><em>{pl ? 'zaczyna się od kogoś.' : 'starts with someone.'}</em></h1></div><div><p>{pl ? 'Poznaj postacie z początków dostępnych książek. Wybierz bohatera, aby odkryć jego miejsce w opowieści.' : 'Meet the characters at the beginning of our books. Choose someone to explore their place in the story.'}</p><a href={`/library?lang=${lang}`}>{pl ? 'Przeglądaj książki' : 'Browse books'} ↗</a></div></header>
  {unavailable ? <p class="empty-state">{pl ? 'Bohaterowie są chwilowo niedostępni. Spróbuj ponownie później.' : 'Characters are temporarily unavailable. Please try again later.'}</p> : stories.length ? stories.map((story) => <section class="directory-story" aria-labelledby={`story-${story.book.slug}`}><div class="directory-story-heading"><div><p class="eyebrow">✦ {pl ? 'NA POCZĄTKU HISTORII' : 'AT THE BEGINNING'}</p><h2 id={`story-${story.book.slug}`}><a href={`/books/${encodeURIComponent(story.book.slug)}?lang=${lang}`}>{story.book.title} ↗</a></h2><p>{story.book.author} · {pl ? 'Tom' : 'Volume'} {story.progress.volume} / {pl ? 'Rozdział' : 'Chapter'} {story.progress.chapter}</p></div><a href={`/books/${encodeURIComponent(story.book.slug)}/characters?lang=${lang}`}>{pl ? 'Bohaterowie tej książki' : 'Characters in this book'} ↗</a></div><ul class="directory-people">{story.characters.map((character) => <li><a href={`/books/${encodeURIComponent(story.book.slug)}/characters/${encodeURIComponent(character.slug)}?lang=${lang}`}><span class="directory-initial" aria-hidden="true">{character.name.slice(0,1)}</span><span class="directory-person"><strong>{character.name}</strong><span>{character.descriptions.at(-1)?.text}</span></span><span class="directory-arrow" aria-hidden="true">↗</span></a></li>)}</ul></section>) : <p class="empty-state">{pl ? 'Biblioteka jest przygotowywana. Wróć wkrótce.' : 'The library is being prepared. Please come back soon.'}</p>}
  <aside class="directory-next"><div><p class="eyebrow">✦ {pl ? 'ODKRYWAJ DALEJ' : 'KEEP EXPLORING'}</p><h2>{pl ? 'Zobacz powiązania.' : 'Follow the connections.'}</h2><p>{pl ? 'Mapa pokazuje relacje wraz z Twoim postępem czytania.' : 'The map reveals connections as you progress through a story.'}</p></div><a class="primary-button" href={`/how-it-works?lang=${lang}`}>{pl ? 'Jak to działa' : 'How it works'} ↗</a></aside></main>
  <footer class="wrap footer"><a class="brand" href={`/?lang=${lang}`}>✳ castellation<span class="brand-dot">.</span></a><p>{pl ? 'Historie są lepsze, gdy widzisz ich powiązania.' : 'Stories are better when you see the connections.'}</p><span>© {new Date().getFullYear()} CASTELLATION</span></footer>
</Layout>
<style>
.character-directory{padding-block:75px 100px}.directory-heading{display:grid;grid-template-columns:1.5fr 1fr;gap:60px;align-items:end;padding-bottom:65px}.directory-heading h1{font:500 clamp(45px,5.5vw,75px)/1.08 'Playfair Display',serif;letter-spacing:-.04em;margin:22px 0 0}.directory-heading h1 em{font-weight:400;color:#a35e3e}.directory-heading>div:last-child p{color:#53675a;line-height:1.8}.directory-heading>div:last-child a,.directory-story-heading> a{font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:5px}.directory-story{padding:45px 0;border-top:1px solid #aab8a8}.directory-story-heading{display:flex;justify-content:space-between;align-items:end;gap:25px}.directory-story-heading h2{font:500 clamp(30px,3.2vw,44px) 'Playfair Display',serif;margin:14px 0}.directory-story-heading div>p:last-child{font-size:13px;color:#53675a}.directory-people{list-style:none;padding:0;margin:30px 0 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.directory-people a{display:grid;grid-template-columns:65px 1fr auto;gap:16px;align-items:start;background:#e6ebe0;padding:20px;min-height:150px;height:100%}.directory-people li:nth-child(even) a{background:#eae2d6}.directory-initial{height:75px;background:#496653;color:#fff;border-radius:50% 50% 2px 2px;display:grid;place-items:center;font:500 38px 'Playfair Display',serif}.directory-person{display:flex;flex-direction:column;gap:10px;min-width:0}.directory-person strong{font:500 23px/1.2 'Playfair Display',serif;overflow-wrap:anywhere}.directory-person>span{font-size:13px;line-height:1.55;color:#405448}.directory-arrow{color:#985438}.directory-people a:hover strong{text-decoration:underline;text-underline-offset:4px}.directory-next{display:flex;justify-content:space-between;align-items:end;gap:25px;background:#e1e8dc;padding:38px;margin-top:50px}.directory-next h2{font:500 clamp(30px,3vw,42px) 'Playfair Display',serif;margin:15px 0}.directory-next p:not(.eyebrow){color:#405448;line-height:1.7}@media(max-width:950px){.directory-people{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.character-directory{padding-block:50px 70px}.directory-heading{grid-template-columns:1fr;gap:15px;padding-bottom:40px}.directory-story-heading{display:block}.directory-story-heading>a{display:inline-block;margin-top:12px}.directory-people{grid-template-columns:1fr;gap:12px}.directory-people a{min-height:0}.directory-next{display:block;padding:25px}.directory-next .primary-button{margin-top:12px}}
</style>
