{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "castellation-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "castellation",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "castellation-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "binding": "BOOK_WORKFLOW",
      "name": "castellation-book-workflow",
      "class_name": "BookWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
